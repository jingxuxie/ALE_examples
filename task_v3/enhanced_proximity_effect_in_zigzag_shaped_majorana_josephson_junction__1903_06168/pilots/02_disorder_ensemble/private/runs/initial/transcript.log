        syst.fill(template["sc_top"], *shapes["sc_top"])

    if L_sc_down > 0:
        syst.fill(template["sc_bot"], *shapes["sc_bot"])

    if infinite and wraparound:
        syst = kwant.wraparound.wraparound(syst)
