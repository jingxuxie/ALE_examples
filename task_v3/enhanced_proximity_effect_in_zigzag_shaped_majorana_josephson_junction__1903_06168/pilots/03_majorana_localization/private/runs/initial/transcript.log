import sys
import json
import time
from pathlib import Path
import numpy as np
import scipy.linalg as la
sys.path.insert(0, str(Path('../attempt').resolve()))
import solve

rng = np.random.default_rng(230817)
def close(actual, expected, description, tolerance=1e-7):
    error = abs(actual / expected - 1)
    assert error < tolerance, (description, actual, expected, error)
    print(f'PASS {description}: {actual:.12g} (relative error {error:.3g})', flush=True)

def group_cells(onsite, hopping, count):
    dimension = len(onsite)
    grouped_onsite = np.kron(np.eye(count), onsite).astype(complex)
    grouped_hopping = np.zeros_like(grouped_onsite)
    for index in range(count - 1):
        current = slice(index * dimension, (index + 1) * dimension)
        following = slice((index + 1) * dimension, (index + 2) * dimension)
        grouped_onsite[current, following] = hopping
        grouped_onsite[following, current] = hopping.conj().T
    grouped_hopping[-dimension:, :dimension] = hopping
    return grouped_onsite, grouped_hopping

onsite = np.diag([2 * np.cosh(0.02), 2 * np.cosh(0.2), 0.7]).astype(complex)
hopping = np.diag([-1, -1, 0]).astype(complex)
close(solve.bulk_amplitude_length(onsite, hopping, 10), 500, 'analytic multichannel singular hopping')
for count in (2, 4, 7):
    grouped_onsite, grouped_hopping = group_cells(onsite, hopping, count)
    dimension = len(grouped_onsite)
    rotation, _ = la.qr(rng.normal(size=(dimension, dimension)) + 1j * rng.normal(size=(dimension, dimension)))
    rotated_onsite = rotation.conj().T @ grouped_onsite @ rotation
    rotated_hopping = rotation.conj().T @ grouped_hopping @ rotation
    close(solve.bulk_amplitude_length(rotated_onsite, rotated_hopping, 10 * count), 500, f'analytic grouping {count} with dense orbital rotation')

singular_onsite = np.diag([3., 0., 0.]).astype(complex)
compact_hopping = np.array([[-1, 0, 0], [0, 0, 1], [0, 0, 0]], dtype=complex)
close(solve.bulk_amplitude_length(singular_onsite, compact_hopping, 10), 10 / np.arccosh(1.5), 'singular onsite fallback with compact-support dimers')
for trial in range(5):
