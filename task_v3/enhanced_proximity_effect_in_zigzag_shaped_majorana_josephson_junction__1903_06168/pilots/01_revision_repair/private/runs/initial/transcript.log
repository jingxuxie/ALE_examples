        for longitudinal in (False, True):
            geometry = dict(base['geometry'], W=60, L_x=120, L_sc_up=20, L_sc_down=30, z_x=60, z_y=amplitude, infinite=periodic, k_x_in_sc=longitudinal)
            spacing = geometry['a']
            nx = int(geometry['L_x'] / spacing)
            period = geometry['z_x']
            offset = geometry['W'] / np.cos(np.arctan(4 * amplitude / period)) if amplitude else geometry['W']
            def middle(tag):
                xpos, ypos = np.array(tag) * spacing
                shifted = xpos + period / 4
                curve = (4 * amplitude / period * (shifted % (period / 2)) - amplitude) if shifted % period < period / 2 else (-4 * amplitude / period * (shifted % (period / 2)) + amplitude)
                return 0 <= xpos < geometry['L_x'] and curve - offset // 2 <= ypos < curve + offset // 2
            def superconductor(tag):
                xpos, ypos = np.array(tag) * spacing
                return 0 <= xpos < geometry['L_x'] and not middle(tag) and -geometry['L_sc_down'] - offset // 2 - amplitude <= ypos < geometry['L_sc_up'] + offset // 2 + amplitude
            probes = [(xpos, ypos) for xpos in range(-1, nx + 1) for ypos in range(-15, 16)]
            edges = {tag for tag in probes if middle(tag) and any(superconductor((tag[0] + delta_x, tag[1] + delta_y)) for delta_x in (-1, 0, 1) for delta_y in (-1, 0, 1) if delta_x or delta_y)}
            filled = {tag for tag in edges if tag[0] == 0}
            frontier = deque(filled)
            while frontier:
                tag = frontier.popleft()
                for delta_x, delta_y in ((-1, 0), (1, 0), (0, -1), (0, 1)):
                    neighbor = (tag[0] + delta_x, tag[1] + delta_y)
                    if periodic:
