+def initial_parameters(request):
+    mismatch = request['operating_region']['mu_sc_rule'] != 'matched'
+    widths = [100, 140, 180, 220] if mismatch else [100, 120, 160, 200]
+    yield None
+    for amplitude in [60, 100, 140, 180]:
