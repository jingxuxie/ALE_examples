actual=json.loads((attempt/'multiplicity_result.json').read_text())['histograms']
total=vectors[:,None,:]+vectors[None,:,:]
mass=np.sqrt(np.maximum(0,total[:,:,3]**2-np.sum(total[:,:,:3]**2,axis=2)))
np.fill_diagonal(mass,0)
delta_phi=(phi[:,None]-phi[None,:]+math.pi)%(2*math.pi)-math.pi
pp_angle=np.hypot(rapidity[:,None]-rapidity[None,:],delta_phi)
directions=vectors[:,:3]/np.linalg.norm(vectors[:,:3],axis=1)[:,None]
ee_angle=np.arctan2(np.linalg.norm(np.cross(directions[:,None,:],directions[None,:,:]),axis=2),directions@directions.T)
np.fill_diagonal(ee_angle,0)
assert np.min(pp_angle[np.triu_indices(count,1)])>1e-6
assert np.min(ee_angle[np.triu_indices(count,1)])>1e-6
errors=[]
for query,histogram in zip(queries,actual):
    upper=10000 if query['observable']=='mass' else math.pi
    edges=np.array([10**(query['log_min']+(math.log10(upper)-query['log_min'])*index/(query['bins']-2)) for index in range(query['bins']-1)])
    edges[-1]=upper
    coordinate=mass if query['observable']=='mass' else (pp_angle if query['geometry']=='pp' else ee_angle)
    fractions=pt/pt.sum() if query['geometry']=='pp' else vectors[:,3]/vectors[:,3].sum()
    weights=(fractions[:,None]*fractions[None,:])**query['kappa']
    cells=np.searchsorted(edges,coordinate,side='right')
    expected=np.bincount(cells.ravel(),weights=weights.ravel(),minlength=query['bins'])
    error=np.sum(np.abs(expected-histogram))
    errors.append(error)
    assert abs(sum(histogram)-np.sum(fractions**query['kappa'])**2)<1e-9
