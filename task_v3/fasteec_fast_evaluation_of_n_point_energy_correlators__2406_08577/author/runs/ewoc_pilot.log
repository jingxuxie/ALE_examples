import json, math, subprocess, sys, time
from pathlib import Path
import numpy as np
attempt = Path('../attempt').resolve()
participant = Path('.').resolve()
sample_job = json.loads((participant/'input/sample.json').read_text())
rows = np.loadtxt(participant/'input/sample.txt')
events = [rows[rows[:,0] == index, 1:] for index in range(sample_job['nevents'])]

def four_vectors(event):
    pt, rapidity, phi = event.T
    return np.column_stack([pt*np.cos(phi), pt*np.sin(phi), pt*np.sinh(rapidity), pt*np.cosh(rapidity)])

def cluster(event, geometry, algorithm, radius):
    vectors = four_vectors(event)
    output = []
    power = {'ca':0, 'kt':1, 'antikt':-1}[algorithm]
    while len(vectors):
        energy = vectors[:,3]
        if geometry == 'pp':
            rapidity = 0.5*np.log((energy+vectors[:,2])/(energy-vectors[:,2]))
            phi = np.arctan2(vectors[:,1], vectors[:,0])
            delta_phi = (phi[:,None]-phi[None,:]+math.pi)%(2*math.pi)-math.pi
            distances = ((rapidity[:,None]-rapidity[None,:])**2 + delta_phi**2)/radius**2
            beam = (vectors[:,0]**2+vectors[:,1]**2)**power
        else:
            directions = vectors[:,:3]/np.linalg.norm(vectors[:,:3], axis=1)[:,None]
            distances = (1-np.clip(directions@directions.T, -1, 1))/(1-math.cos(radius))
            beam = energy**(2*power)
        distances *= np.minimum(beam[:,None], beam[None,:])
        distances[np.tril_indices(len(vectors))] = np.inf
        flat = int(np.argmin(distances))
        first, second = divmod(flat, len(vectors))
        beam_index = int(np.argmin(beam))
        if distances[first,second] < beam[beam_index]:
            vectors[first] += vectors[second]
            vectors = np.delete(vectors, second, axis=0)
        else:
            output.append(vectors[beam_index].copy())
            vectors = np.delete(vectors, beam_index, axis=0)
    return np.array(output)

def reference(event, query, vectors):
    histogram = np.zeros(query['bins'])
    upper = 10000.0 if query['observable'] == 'mass' else math.pi
    finite = query['bins']-2
    edges = np.array([10**(query['log_min']+(math.log10(upper)-query['log_min'])*index/finite) for index in range(finite+1)])
    edges[-1] = upper
    denominator = event[:,0].sum() if query['geometry'] == 'pp' else np.sum(event[:,0]*np.cosh(event[:,1]))
    numerators = np.linalg.norm(vectors[:,:2], axis=1) if query['geometry'] == 'pp' else vectors[:,3]
    fractions = numerators/denominator
    for first_index, first in enumerate(vectors):
        for second_index, second in enumerate(vectors):
            if query['observable'] == 'mass':
                total = first if first_index == second_index else first+second
                coordinate = math.sqrt(max(0.0, total[3]**2-np.dot(total[:3], total[:3])))
            elif first_index == second_index:
                coordinate = 0.0
            elif query['geometry'] == 'pp':
                first_rapidity = 0.5*math.log((first[3]+first[2])/(first[3]-first[2]))
                second_rapidity = 0.5*math.log((second[3]+second[2])/(second[3]-second[2]))
                delta_phi = (math.atan2(first[1],first[0])-math.atan2(second[1],second[0])+math.pi)%(2*math.pi)-math.pi
                coordinate = math.hypot(first_rapidity-second_rapidity,delta_phi)
            else:
                cosine = np.dot(first[:3],second[:3])/(np.linalg.norm(first[:3])*np.linalg.norm(second[:3]))
                coordinate = math.acos(max(-1.0,min(1.0,cosine)))
            cell = int(np.searchsorted(edges,coordinate,side='right'))
            histogram[cell] += (fractions[first_index]*fractions[second_index])**query['kappa']
    return histogram

queries = list(sample_job['queries'])
for geometry in ['pp','ee']:
    for algorithm in ['ca','kt','antikt']:
        for radius in [0.03,0.15,0.5,1.8,math.pi]:
            for observable in ['mass','angular']:
                for kappa in [0.5,1.0,1.5,2.0]:
                    queries.append(dict(geometry=geometry,algorithm=algorithm,radius=radius,observable=observable,kappa=kappa,log_min=-4.0,bins=48))
job = dict(sample_job,queries=queries,events_file='../participant/input/sample.txt')
job_path = attempt/'validation_grid.json'
result_path = attempt/'validation_grid_result.json'
job_path.write_text(json.dumps(job))
start = time.perf_counter()
subprocess.run([sys.executable,str(attempt/'solve.py'),'--input',str(job_path),'--output',str(result_path)],check=True,cwd=attempt)
print('Engine seconds:',time.perf_counter()-start,flush=True)
actual = json.loads(result_path.read_text())['histograms']
cache = {}
errors = []
for query_index, query in enumerate(queries):
    expected = np.zeros(query['bins'])
    for event_index, event in enumerate(events):
        key = (event_index,query['geometry'],query['algorithm'],query['radius'])
        if key not in cache:
            cache[key] = cluster(event,query['geometry'],query['algorithm'],query['radius'])
        expected += reference(event,query,cache[key])/len(events)
    error = np.sum(np.abs(np.array(actual[query_index])-expected))
    errors.append(error)
    if error > 1e-10:
        print('MISMATCH',query_index,query,'L1=',error,flush=True)
print('Validated',len(queries),'queries against independent sequential clustering.')
print('Maximum L1:',max(errors),'mean L1:',np.mean(errors))
for query_index in range(4):
    histogram = actual[query_index]
    print('Public query',query_index,'histogram sum:',math.fsum(histogram))
assert max(errors) < 1e-10
