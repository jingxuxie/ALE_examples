from pathlib import Path
import numpy as np
attempt=Path('../attempt').resolve()
rng=np.random.default_rng(20260827)
count=139
pt=np.exp(rng.uniform(math.log(0.01),math.log(100),count))
rapidity=rng.uniform(-1,1,count)
phi=rng.uniform(-math.pi,math.pi,count)
vectors=np.column_stack([pt*np.cos(phi),pt*np.sin(phi),pt*np.sinh(rapidity),pt*np.cosh(rapidity)])
(attempt/'multiplicity_events.txt').write_text(''.join(f'0 {transverse:.17g} {axis_y:.17g} {axis_phi:.17g}\\n' for transverse,axis_y,axis_phi in zip(pt,rapidity,phi)))
queries=[]
for geometry in ('pp','ee'):
    for algorithm in ('ca','kt','antikt'):
        for observable in ('mass','angular'):
            for kappa in (0.3,0.5,1.0,1.5,2.0,3.7):
                queries.append(dict(geometry=geometry,algorithm=algorithm,radius=1e-6,observable=observable,kappa=kappa,log_min=-4,bins=60))
job=dict(kind='ewoc',nevents=1,events_file='multiplicity_events.txt',queries=queries)
(attempt/'multiplicity_job.json').write_text(json.dumps(job))
