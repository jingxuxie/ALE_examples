def make_case(state_count, observations, targets=None, pad=1e-8):
    if targets is None:
        targets = [{'id': 'mass', 'coefficients': list(range(state_count))}]
    return {'tracks': [], 'occupation': {
        'states': [[index, 0, 0] for index in range(state_count)],
        'observations': observations, 'targets': targets, 'feasibility_pad': pad}}


def get_bands(case, result):
    responses, centers, radii = [], [], []
    for observation in case['occupation']['observations']:
        responses.append(observation['response'])
        if 'center' in observation:
            centers.append(observation['center'])
            radii.append(observation['radius'])
        else:
            centers.append(sum(weight * result['fits'][track_id]['amplitude']
                               for track_id, weight in observation['amplitude_weights'].items()))
            variance = sum((weight * result['fits'][track_id]['amplitude_se']) ** 2
                           for track_id, weight in observation['amplitude_weights'].items())
            radii.append(observation['systematic_radius'] +
                         observation['sigma_multiplier'] * math.sqrt(variance))
    return np.asarray(responses), np.asarray(centers), np.asarray(radii)


def check_witnesses(case, result):
    json.dumps(result, allow_nan=False)
    state_count = len(case['occupation']['states'])
    responses, centers, radii = get_bands(case, result)
    assert result['inflation'] >= 0
    assert set(result['fits']) == {track['id'] for track in case['tracks']}
    for target in case['occupation']['targets']:
        target_id = target['id']
        assert result['bounds'][target_id][0] <= result['bounds'][target_id][1] + 1e-10
        for endpoint, label in enumerate(('lower', 'upper')):
            witness = np.asarray(result['witnesses'][target_id][label])
            assert witness.shape == (state_count,)
            assert np.min(witness) >= 0
            assert_allclose(np.sum(witness), 1, atol=1e-12, rtol=0)
            assert_allclose(np.dot(target['coefficients'], witness),
                            result['bounds'][target_id][endpoint], atol=1e-12, rtol=1e-12)
