+            left_dim, local_dim, right_dim = tensor.shape
+            temporary = (environment @ tensor.reshape(left_dim, -1)).reshape(tensor.shape)
+            physical_probability = np.einsum("apr,apr->p", tensor.conj(), temporary).real
