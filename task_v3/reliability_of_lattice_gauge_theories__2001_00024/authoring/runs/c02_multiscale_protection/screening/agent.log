+    def simulate(self, parameters, times):
+        hamiltonian = self.parts[0].copy()
+        for parameter, part in zip(parameters, self.parts[1:]):
+            hamiltonian = hamiltonian + parameter * part
+        times = np.asarray(times, dtype=float)
+        if self.dense:
