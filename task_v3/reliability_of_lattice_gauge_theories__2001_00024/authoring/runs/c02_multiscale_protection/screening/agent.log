+    def step(self, interval, order=4):
+        if order == 2:
+            self.second_order_step(interval)
+        else:
+            first = 1.0 / (2.0 - 2.0 ** (1.0 / 3.0))
+            self.second_order_step(first * interval)
+            self.second_order_step((1.0 - 2.0 * first) * interval)
+            self.second_order_step(first * interval)
