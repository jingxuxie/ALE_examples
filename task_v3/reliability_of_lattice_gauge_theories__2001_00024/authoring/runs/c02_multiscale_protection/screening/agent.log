+        descending = np.sort(all_singular)[::-1]
+        tails = np.cumsum(descending[::-1] ** 2)[::-1]
+        keep = int(np.searchsorted(-tails, -self.cutoff))
+        keep = max(1, min(keep, self.max_bond, len(descending)))
+        threshold = descending[keep - 1]
