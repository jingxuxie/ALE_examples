+    timestep = float(os.environ.get("SOLVER_DT", 0.12 / (1 + 0.16 * potential)))
+    budget = float(os.environ.get("SOLVER_TIME_BUDGET", 3250.0))
+    evolution = MatrixProductEvolution(settings, parameters, max_bond, cutoff)
+    results = [[], [], []]
+    current = 0.0
+    step_rates = []
+    for target in times:
+        interval = float(target) - current
+        steps = max(1, int(math.ceil(interval / timestep - 1e-12)))
+        step_size = interval / steps
+        for step_index in range(steps if interval > 1e-14 else 0):
+            before = time.monotonic()
+            evolution.step(step_size, order)
+            current += step_size
+            duration = time.monotonic() - before
