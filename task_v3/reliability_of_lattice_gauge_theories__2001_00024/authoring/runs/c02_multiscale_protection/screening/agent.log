+        grouped = {}
+        for index, (left, right) in enumerate(pairs):
+            left, right = min(left, right), max(left, right)
+            if left == right:
+                correlation[index] = density[left] * (1 - density[left])
+            else:
+                grouped.setdefault(left, {}).setdefault(right, []).append(index)
