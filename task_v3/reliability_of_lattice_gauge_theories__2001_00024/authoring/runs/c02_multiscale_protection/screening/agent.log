+        "flux": np.kron(np.eye(2), np.diag(flux_values)),
+        "lower": np.kron(lower, np.eye(link_dim)),
+        "assisted": np.kron(lower, raising),
+        "flip": np.kron(np.eye(2), raising + raising.T)
