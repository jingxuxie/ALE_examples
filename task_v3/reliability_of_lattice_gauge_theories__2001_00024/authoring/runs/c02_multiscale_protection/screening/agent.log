+    potential = abs(settings["V"])
+    if settings["protection"] == "linear":
+        potential *= max(1.0, np.max(np.abs(settings["coefficients"]))) / 2
+    timestep = float(os.environ.get("SOLVER_DT", 0.12 / (1 + 0.16 * potential)))
+    budget = float(os.environ.get("SOLVER_TIME_BUDGET", 3250.0))
+    evolution = MatrixProductEvolution(settings, parameters, max_bond, cutoff)
+    results = [[], [], []]
+    current = 0.0
+    step_rates = []
+    for target in times:
+        interval = float(target) - current
+        steps = max(1, int(math.ceil(interval / timestep - 1e-12)))
+        step_size = interval / steps
+        for step_index in range(steps if interval > 1e-14 else 0):
+            before = time.monotonic()
+            evolution.step(step_size, order)
+            current += step_size
+            duration = time.monotonic() - before
+            step_rates.append(duration / step_size)
+            if len(step_rates) > 5:
+                step_rates.pop(0)
+            remaining = float(times[-1]) - current
+            available = budget - (time.monotonic() - start_time)
+            projected = max(step_rates) * remaining
+            if len(step_rates) == 5 and projected > 0.92 * available and evolution.max_bond > 16:
+                factor = max(0.70, min(0.95, (max(available, 1.0) * 0.8 / max(projected, 1.0)) ** (1.0 / 3.0)))
+                evolution.max_bond = max(16, int(evolution.max_bond * factor))
+                step_rates.clear()
+        current = float(target)
+        values = evolution.measure(pairs)
+        for destination, value in zip(results, values):
+            destination.append(value)
+    return tuple(np.asarray(block) for block in results)
+
+
+def solve(case):
+    start = time.monotonic()
+    context = threadpool_limits(limits=1) if threadpool_limits is not None else nullcontext()
+    with context:
+        parameters = fit_parameters(case["calibration"])
+        density, violation, correlation = simulate_chain(
+            case["experiment"], parameters, case["times"], case["pairs"], start
+        )
+    return {
+        "parameters": parameters.tolist(),
+        "density": density.tolist(),
+        "violation": violation.tolist(),
+        "correlation": correlation.tolist(),
+    }
+
+
