+            self.parts = [part.toarray() for part in self.parts]
+        initial_index = sum((link_dim - 1 if site % 2 == 0 else 0) * powers[site] for site in range(length))
+        self.initial = np.zeros(count)
+        self.initial[inverse[initial_index]] = 1.0
