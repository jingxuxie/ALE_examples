+class MatrixProductEvolution:
+    def __init__(self, settings, parameters, max_bond=128, cutoff=1e-11):
+        self.settings = settings
+        self.length = settings["length"]
+        self.max_bond = max_bond
+        self.cutoff = cutoff
+        self.discarded = 0.0
