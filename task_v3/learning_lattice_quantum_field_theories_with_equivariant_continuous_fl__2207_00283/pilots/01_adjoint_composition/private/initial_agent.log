import solve
import validate
import json
import math
import numpy as np
from scipy.integrate import solve_ivp

validate.main()
cases = json.load(open('extreme_cases.json'))['cases']
for case in cases[2:]:
    parameters = np.array(case['parameters'])
    dimension = len(case['x'])
    inverse = case['direction'] == 'inverse'
    start, end = case['times'][::-1] if inverse else case['times']
    duration = end-start
    linear, nonlinear, forcing, coupling = parameters[:4]
    initial = case['x'][0] * (1 if inverse else np.exp(parameters[4]))
    initial_sens = np.zeros((2,7))
    initial_sens[0,0] = 1
    def dynamics(fraction, augmented):
        state = augmented[0]
        sensitivity = augmented[2:].reshape(2,7)
        time = start+duration*fraction
        hyperbolic = np.tanh(state)
        derivative = 1/np.cosh(state)**2
        velocity = (linear+coupling)*state+nonlinear*hyperbolic+forcing*np.sin(time)
        density_rate = -dimension*(linear+nonlinear*derivative)
        vector = np.array([velocity,density_rate])
        jacobian = np.array([[linear+coupling+nonlinear*derivative,0],[2*dimension*nonlinear*hyperbolic*derivative,0]])
        rate = duration*(jacobian@sensitivity)
        rate[:,1:5] += duration*np.array([[state,hyperbolic,np.sin(time),state],[-dimension,-dimension*derivative,0,0]])
        explicit = np.array([forcing*np.cos(time),0])
        first = -vector+duration*(1-fraction)*explicit
        second = vector+duration*fraction*explicit
        rate[:,-2] += second if inverse else first
        rate[:,-1] += first if inverse else second
        return np.concatenate((duration*vector,rate.ravel()))
    solution = solve_ivp(dynamics,(0,1),np.concatenate(([initial,0],initial_sens.ravel())),method='DOP853',rtol=2.5e-14,atol=3e-15,max_step=1/256)
    assert solution.success
    scalar_state,density_change = solution.y[:2,-1]
    scalar_sensitivity = solution.y[2:,-1].reshape(2,7)
    factor = np.exp(-parameters[4]) if inverse else 1
    expected_state = np.full(dimension,factor*scalar_state)
    expected_density = case['log_density']+density_change+(1 if inverse else -1)*(solve.frequency_multiplicities(dimension)@parameters[4:])
    for density_only in [False,True]:
        request = dict(case,cotangent=[0.0]*dimension,density_weight=1.0) if density_only else case
        actual = solve.evaluate_case(request)
        terminal_cotangent = factor*np.sum(request['cotangent'])
        scalar_gradient = np.array([terminal_cotangent,request['density_weight']])@scalar_sensitivity
        np.testing.assert_allclose(actual['state'],expected_state,rtol=2e-9,atol=2e-9)
        np.testing.assert_allclose(actual['log_density'],expected_density,rtol=2e-9,atol=2e-9)
        np.testing.assert_allclose(actual['parameter_gradient'][:4],scalar_gradient[1:5],rtol=3e-8,atol=3e-8)
        np.testing.assert_allclose(actual['time_gradient'],scalar_gradient[-2:],rtol=3e-8,atol=3e-8)
        spectrum = np.fft.rfft(request['cotangent'])
        if inverse:
            spectrum *= np.exp(-parameters[4:])
        spectrum *= np.exp(-density_change/dimension+parameters[3]*np.conj(solve.shift_modes(dimension))*duration)
        spectrum[0] += request['density_weight']*scalar_sensitivity[1,0]
        if not inverse:
            spectrum *= np.exp(parameters[4:])
        expected_input = np.fft.irfft(spectrum,n=dimension)
        np.testing.assert_allclose(actual['input_gradient'],expected_input,rtol=3e-8,atol=3e-8)
    print('Independent scalar-plus-Fourier extreme sensitivities passed:',case['id'],flush=True)
print('Final independent validation passed')
