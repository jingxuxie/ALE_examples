import json
import math
import time
import numpy as np
import solve
from scipy.integrate import solve_ivp
from scipy.linalg import expm


def spectral_matrices(log_scales, dimension, inverse=False):
    sign = -1 if inverse else 1
    mode_indices = np.minimum(np.arange(dimension), dimension - np.arange(dimension))
    full_scales = np.exp(sign * log_scales[mode_indices])
    basis = np.fft.fft(np.eye(dimension), axis=0)
    matrix = np.fft.ifft(full_scales[:, None] * basis, axis=0).real
    derivatives = [np.fft.ifft((sign * full_scales * (mode_indices == index))[:, None] * basis, axis=0).real for index in range(log_scales.size)]
    return matrix, derivatives


def tangent_reference(case):
    inputs = np.array(case['x'])
    parameters = np.array(case['parameters'])
    times = np.array(case['times'])
    dimension = len(inputs)
    variable_count = dimension + len(parameters) + 2
    linear, nonlinear, forcing, coupling = parameters[:4]
    inverse = case['direction'] == 'inverse'
    start, end = times[::-1] if inverse else times
    duration = end - start
    shift = np.roll(np.eye(dimension), 1, axis=0)
    sensitivity = np.zeros((dimension + 1, variable_count))
    if inverse:
        initial = np.append(inputs, case['log_density'])
        sensitivity[:dimension, :dimension] = np.eye(dimension)
    else:
