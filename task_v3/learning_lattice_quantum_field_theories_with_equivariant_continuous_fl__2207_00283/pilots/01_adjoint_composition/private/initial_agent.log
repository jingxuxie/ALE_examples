            derivatives.append((primary(plus)[2]-primary(minus)[2])/(2*step))
        expected=(4*derivatives[1]-derivatives[0])/3
        result=actual[gradient_key][index]
        error=abs(result-expected)/(1+abs(expected))
        print('Stiff finite difference',gradient_key,index,'scaled error',error,flush=True)
        np.testing.assert_allclose(result,expected,rtol=8e-5,atol=1e-7)
print('Stiff finite-difference checks passed in',time.perf_counter()-started,'seconds')
