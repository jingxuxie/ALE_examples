def primary(request):
    parameters = np.array(request['parameters'])
    inputs = np.array(request['x'])
    dimension = inputs.size
    inverse = request['direction']=='inverse'
    start,end = request['times'][::-1] if inverse else request['times']
    spectrum = solve.real_spectrum(inputs)
    if not inverse:
        spectrum *= np.exp(parameters[4:])
    initial = np.fft.irfft(spectrum,n=dimension)
    state,change,trajectory = solve.integrate_transport(initial,parameters[:4],start,end,request['steps'],dense=True,initial_spectrum=spectrum)
    if inverse:
        final_spectrum = spectrum if trajectory is None else trajectory(1)[:-1]
        state = np.fft.irfft(np.exp(-parameters[4:])*final_spectrum,n=dimension)
    density = request['log_density']+change+(1 if inverse else -1)*(solve.frequency_multiplicities(dimension)@parameters[4:])
    return state,density,np.dot(request['cotangent'],state)+request['density_weight']*density

state,density,objective = primary(case)
