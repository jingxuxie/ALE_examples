        sensitivity = augmented[dimension + 1:].reshape(dimension + 1, variable_count)
        physical_time = start + fraction * duration
        hyperbolic = np.tanh(state)
        sech_squared = 1 / np.cosh(state)**2
        velocity = linear * state + nonlinear * hyperbolic + forcing * np.sin(physical_time) + coupling * (shift @ state)
        density_rate = -dimension * linear - nonlinear * np.sum(sech_squared)
        vector = np.append(velocity, density_rate)
        jacobian = np.zeros((dimension + 1, dimension + 1))
        jacobian[:dimension, :dimension] = np.diag(linear + nonlinear * sech_squared) + coupling * shift
        jacobian[dimension, :dimension] = 2 * nonlinear * hyperbolic * sech_squared
        coefficient_derivative = np.zeros((dimension + 1, 4))
        coefficient_derivative[:dimension] = np.column_stack((state, hyperbolic, np.full(dimension, np.sin(physical_time)), shift @ state))
        coefficient_derivative[dimension, :2] = [-dimension, -np.sum(sech_squared)]
        sensitivity_rate = duration * (jacobian @ sensitivity)
        sensitivity_rate[:, dimension:dimension + 4] += duration * coefficient_derivative
        time_derivative = np.append(np.full(dimension, forcing * np.cos(physical_time)), 0)
        start_derivative = -vector + duration * (1 - fraction) * time_derivative
        end_derivative = vector + duration * fraction * time_derivative
        sensitivity_rate[:, -2] += end_derivative if inverse else start_derivative
        sensitivity_rate[:, -1] += start_derivative if inverse else end_derivative
        return np.concatenate((duration * vector, sensitivity_rate.ravel()))

    integrated = solve_ivp(dynamics, (0, 1), np.concatenate((initial, sensitivity.ravel())), method='DOP853', rtol=2.5e-14, atol=3e-15, max_step=1/96)
    assert integrated.success
    state = integrated.y[:dimension, -1]
    density = integrated.y[dimension, -1]
    sensitivity = integrated.y[dimension + 1:, -1].reshape(dimension + 1, variable_count)
    if inverse:
        scaling, scale_derivatives = spectral_matrices(parameters[4:], dimension, inverse=True)
        sensitivity[:dimension] = scaling @ sensitivity[:dimension]
        for index, derivative in enumerate(scale_derivatives):
            sensitivity[:dimension, dimension + 4 + index] += derivative @ state
            sensitivity[dimension, dimension + 4 + index] -= np.trace(np.linalg.solve(scaling, derivative))
        state = scaling @ state
        density -= np.linalg.slogdet(scaling)[1]
    gradient = np.append(case['cotangent'], case['density_weight']) @ sensitivity
    return dict(state=state, log_density=density, objective=np.dot(case['cotangent'], state) + case['density_weight'] * density,
                input_gradient=gradient[:dimension], parameter_gradient=gradient[dimension:-2], time_gradient=gradient[-2:])


