        initial = np.append(scaling @ inputs, case['log_density'] - np.linalg.slogdet(scaling)[1])
        sensitivity[:dimension, :dimension] = scaling
        for index, derivative in enumerate(scale_derivatives):
            sensitivity[:dimension, dimension + 4 + index] = derivative @ inputs
            sensitivity[dimension, dimension + 4 + index] = -np.trace(np.linalg.solve(scaling, derivative))

