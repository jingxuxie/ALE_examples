def rk4_proposal(latent, parameters, times):
    dimension = len(latent)
    mode_indices = np.minimum(np.arange(dimension), dimension - np.arange(dimension))
    scales = np.exp(parameters[4:][mode_indices])
    matrix = np.fft.ifft(scales[:, None] * np.fft.fft(np.eye(dimension), axis=0), axis=0).real
    state = matrix @ latent
    density = -0.5 * (latent @ latent) - dimension / 2 * math.log(2 * math.pi) - np.linalg.slogdet(matrix)[1]
    augmented = np.append(state, density)
    count = 2048
    increment = (times[1] - times[0]) / count
    linear, nonlinear, forcing, coupling = parameters[:4]
    def dynamics(time, augmented):
        state = augmented[:-1]
        hyperbolic = np.tanh(state)
        velocity = linear * state + nonlinear * hyperbolic + forcing * np.sin(time) + coupling * np.roll(state, 1)
        return np.append(velocity, -dimension * linear - nonlinear * np.sum(1 - hyperbolic**2))
    for step in range(count):
        time = times[0] + increment * step
        first = dynamics(time, augmented)
        second = dynamics(time + increment / 2, augmented + increment / 2 * first)
        third = dynamics(time + increment / 2, augmented + increment / 2 * second)
        fourth = dynamics(time + increment, augmented + increment * third)
        augmented += increment / 6 * (first + 2 * second + 2 * third + fourth)
    return augmented[:-1], augmented[-1]

