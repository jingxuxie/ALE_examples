@@ -0,0 +1,162 @@
+import argparse
+import json
+
+
+def reverse_operations(operations):
+    stack = [(operations, len(operations) - 1, 1)]
+    while stack:
+        body, position, repetitions = stack.pop()
+        while True:
+            if position < 0:
+                repetitions -= 1
+                if repetitions == 0:
+                    break
+                position = len(body) - 1
+            operation = body[position]
+            position -= 1
+            if operation["op"] == "REPEAT":
+                count = operation["count"]
+                nested = operation["body"]
+                if count > 0 and nested:
+                    stack.append((body, position, repetitions))
+                    body = nested
+                    position = len(body) - 1
+                    repetitions = count
+            else:
+                yield operation
+
+
+def compile_case(case):
+    num_qubits = case["num_qubits"]
+    num_detectors = case["num_detectors"]
+    num_observables = case["num_observables"]
+    measurement_count = case["num_measurements"]
+    detector_count = num_detectors
+    x_effects = [set() for _ in range(num_qubits)]
+    z_effects = [set() for _ in range(num_qubits)]
+    pending_records = {}
+    terms = {}
+
+    for operation in reverse_operations(case["operations"]):
+        name = operation["op"]
+        if name == "ERROR":
+            probability = operation["probability"]
+            if not probability:
+                continue
+            signature = set()
+            for qubit, pauli in zip(operation["qubits"], operation["paulis"]):
+                if pauli == "X":
+                    signature ^= x_effects[qubit]
+                elif pauli == "Z":
+                    signature ^= z_effects[qubit]
+                elif pauli == "Y":
+                    signature ^= x_effects[qubit]
+                    signature ^= z_effects[qubit]
+                elif pauli != "I":
+                    raise ValueError("Unsupported Pauli: " + pauli)
+            if signature:
+                key = tuple(sorted(signature))
+                previous = terms.get(key)
+                if previous is None:
+                    terms[key] = probability
+                else:
+                    terms[key] = previous * (1.0 - probability) + probability * (1.0 - previous)
+        elif name == "CX":
+            qubits = operation["qubits"]
+            for position in range(len(qubits) - 2, -1, -2):
+                control = qubits[position]
+                target = qubits[position + 1]
+                x_effects[control] ^= x_effects[target]
+                z_effects[target] ^= z_effects[control]
+        elif name == "H":
+            for qubit in operation["qubits"]:
+                x_effects[qubit], z_effects[qubit] = z_effects[qubit], x_effects[qubit]
+        elif name == "R" or name == "RX":
+            for qubit in operation["qubits"]:
+                x_effects[qubit].clear()
+                z_effects[qubit].clear()
+        elif name == "M" or name == "MX":
+            qubits = operation["qubits"]
+            measurement_count -= len(qubits)
+            effects = x_effects if name == "M" else z_effects
+            for offset, qubit in enumerate(qubits):
+                signature = pending_records.pop(measurement_count + offset, None)
+                if signature:
+                    effects[qubit] ^= signature
+        elif name == "DETECTOR" or name == "OBSERVABLE":
+            if name == "DETECTOR":
+                detector_count -= 1
+                label = detector_count
+            else:
+                observable = operation["index"]
+                if observable < 0 or observable >= num_observables:
+                    raise ValueError("Invalid observable index")
+                label = num_detectors + observable
+            for offset in operation["records"]:
+                record = measurement_count + offset
+                if record < 0 or record >= measurement_count:
+                    raise ValueError("Invalid measurement reference")
+                signature = pending_records.get(record)
+                if signature is None:
+                    pending_records[record] = {label}
+                elif label in signature:
+                    signature.remove(label)
+                else:
+                    signature.add(label)
+        elif name == "S" or name == "S_DAG":
+            for qubit in operation["qubits"]:
+                x_effects[qubit] ^= z_effects[qubit]
+        elif name == "CZ":
+            qubits = operation["qubits"]
+            for position in range(len(qubits) - 2, -1, -2):
+                control = qubits[position]
+                target = qubits[position + 1]
+                x_effects[control] ^= z_effects[target]
+                x_effects[target] ^= z_effects[control]
+        elif name == "SWAP":
+            qubits = operation["qubits"]
+            for position in range(len(qubits) - 2, -1, -2):
+                first = qubits[position]
+                second = qubits[position + 1]
+                x_effects[first], x_effects[second] = x_effects[second], x_effects[first]
+                z_effects[first], z_effects[second] = z_effects[second], z_effects[first]
+        elif name != "TICK":
+            raise ValueError("Unsupported operation: " + name)
+
+    if measurement_count != 0:
+        raise ValueError("Measurement count mismatch")
+    if detector_count != 0:
+        raise ValueError("Detector count mismatch")
+
+    errors = []
+    for signature, probability in terms.items():
+        if probability == 0:
+            continue
+        detectors = []
+        observables = []
+        for label in signature:
+            if label < num_detectors:
+                detectors.append(label)
+            else:
+                observables.append(label - num_detectors)
+        errors.append({"detectors": detectors, "observables": observables,
+                       "probability": probability})
+    return {"schema_version": 1, "num_detectors": num_detectors,
+            "num_observables": num_observables, "errors": errors}
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--input", required=True)
+    parser.add_argument("--output", required=True)
+    arguments = parser.parse_args()
+    with open(arguments.input, encoding="utf-8") as source:
+        case = json.load(source)
+    answer = compile_case(case)
+    with open(arguments.output, "w", encoding="utf-8") as destination:
+        destination.write(json.dumps(answer, separators=(",", ":")))
+        destination.write("\n")
+
+
+if __name__ == "__main__":
+    main()

