+struct FlowNetwork {
+    struct Edge { int destination, reverse; double capacity; };
+    std::vector<std::vector<Edge>> graph;
+    std::vector<int> level, cursor;
+    explicit FlowNetwork(int vertices) : graph(vertices), level(vertices), cursor(vertices) {}
+    void add_edge(int first, int second, double capacity) {
+        int first_reverse = static_cast<int>(graph[second].size());
+        int second_reverse = static_cast<int>(graph[first].size());
+        graph[first].push_back({second, first_reverse, capacity});
+        graph[second].push_back({first, second_reverse, capacity});
+    }
+    double send(int vertex, int target, double amount) {
+        if (vertex == target) return amount;
+        for (int &index = cursor[vertex]; index < static_cast<int>(graph[vertex].size()); ++index) {
+            Edge &edge = graph[vertex][index];
+            if (edge.capacity > 1e-10 && level[edge.destination] == level[vertex] + 1) {
+                double flow = send(edge.destination, target, std::min(amount, edge.capacity));
+                if (flow > 1e-10) {
+                    edge.capacity -= flow;
+                    graph[edge.destination][edge.reverse].capacity += flow;
+                    return flow;
+                }
+            }
+        }
+        return 0;
+    }
+    double maximum_flow(int source, int target, Bits &reachable) {
+        double total = 0;
