+            }
+            if (level[target] < 0) {
+                for (size_t vertex = 0; vertex < level.size(); ++vertex) reachable[vertex] = level[vertex] >= 0;
+                return total;
+            }
+            std::fill(cursor.begin(), cursor.end(), 0);
+            double flow;
+            while ((flow = send(source, target, 1e100)) > 1e-10) total += flow;
+        }
+    }
