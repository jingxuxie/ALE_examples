+    std::vector<double> values(vertices, 0.0);
+    Bits reachable(vertices);
+    for (int source = 1; source < vertices; ++source) {
+        int target = parent[source];
+        FlowNetwork network(vertices);
+        for (int edge = 0; edge < edges; ++edge)
+            if (capacities[edge] > 1e-9) network.add_edge(first[edge], second[edge], capacities[edge]);
+        double flow = network.maximum_flow(source, target, reachable);
+        for (int vertex = source + 1; vertex < vertices; ++vertex)
