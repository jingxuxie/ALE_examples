+    case['single_ion'] = [-0.25] * case['length']
+    case['field'] = [0.07 * (-1) ** site + 0.02 * np.sin(0.3 * site) for site in range(case['length'])]
+    for bond in case['bonds']:
+        bond['jxy'] = 0.5
