+        transfer = np.zeros((matrix.shape[0], len(new_charges)))
+        offset = 0
+        for charge, rows, columns, left, right in transforms:
+            selected = np.arange(offset, offset + right.shape[0])
+            new_tensor[np.ix_(selected, columns)] = right
