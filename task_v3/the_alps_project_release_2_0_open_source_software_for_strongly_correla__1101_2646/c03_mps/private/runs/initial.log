import json
import math
from pathlib import Path

names = ['hard_spin1_80.parallel.json', 'hard_bose_hubbard_80.out.json',
         'hard_boson_80.davidson.json', 'hard_ladder_80.final.json', 'hard_ladder_80.refined.json']
summary = {'regression_tests_passed': 15, 'large_cases': []}
for name in names:
    result = json.loads(Path(name).read_text())
    assert all(math.isfinite(value) for value in [result['energy'], result['gap']] + result['correlations'])
    assert result['runtime'] < 590
    record = {'file': name, 'runtime_seconds': result['runtime'],
              'energy': result['energy'], 'gap': result['gap'],
              'final_bond_dimensions': [history[-1][1] for history in result['sweeps']],
              'worker_peak_mib': result.get('worker_peak_mib')}
    summary['large_cases'].append(record)
    print(record)

refined = json.loads(Path('hard_ladder_80.refined.json').read_text())
count = len(refined['correlations']) // 2
summary['ladder_spin_rotation_error'] = max(abs(first-second) for first, second in zip(
    refined['correlations'][:count], refined['correlations'][count:]))
summary['spin_inversion_errors'] = json.loads(Path('symmetry_check.json').read_text())['errors']
summary['boson_eigensolver_comparison'] = {}
first = json.loads(Path('hard_bose_hubbard_80.out.json').read_text())
second = json.loads(Path('hard_boson_80.davidson.json').read_text())
for key in ['energy', 'gap']:
    summary['boson_eigensolver_comparison'][key] = abs(first[key] - second[key])
summary['boson_eigensolver_comparison']['correlations'] = max(abs(left-right) for left, right in zip(
    first['correlations'], second['correlations']))
print('Ladder spin-rotation error:', summary['ladder_spin_rotation_error'])
print('Boson eigensolver comparison:', summary['boson_eigensolver_comparison'])
Path('validation_summary.json').write_text(json.dumps(summary, indent=2) + '\\n')
PY
