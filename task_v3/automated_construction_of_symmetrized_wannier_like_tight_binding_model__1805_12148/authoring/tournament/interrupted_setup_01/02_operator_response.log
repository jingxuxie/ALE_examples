import sys,time
import numpy as np
sys.path.insert(0,'../attempt')
from operators import project_operators
from response import responses
with np.load('input/smoke/model.npz',allow_pickle=False) as archive:
 original={key:archive[key] for key in archive.files}
with np.load('../attempt/smoke_result.npz',allow_pickle=False) as archive:
 reference={key:archive[key] for key in archive.files}
generator=np.random.default_rng(31984)
permutation=generator.permutation(original['ham'].shape[1])
frame,_=np.linalg.qr(generator.normal(size=(3,3)))
frame[:,0]*=-np.linalg.det(frame)
transformed=dict(original)
transformed['lattice']=original['lattice']@frame.T
transformed['ham']=original['ham'][:,permutation][:,:,permutation]
transformed['connection']=np.einsum('ab,rnmb->rnma',frame,original['connection'][:,permutation][:,:,permutation])
transformed['centers']=original['centers'][permutation]@frame.T
transformed['unitary']=original['unitary'][:,permutation][:,:,permutation]
transformed['orbital_shifts']=original['orbital_shifts'][:,permutation]
transformed['cartesian_rotations']=frame@original['cartesian_rotations']@frame.T
start=time.monotonic()
repaired=project_operators(transformed)
print('Projection runtime',time.monotonic()-start)
np.testing.assert_array_equal(repaired['rvec'],reference['rvec'])
for key,expected in [('ham',reference['ham'][:,permutation][:,:,permutation]),('centers',reference['centers'][permutation]@frame.T),('connection',np.einsum('ab,rnmb->rnma',frame,reference['connection'][:,permutation][:,:,permutation]))]:
 residual=np.max(np.abs(repaired[key]-expected)); print('frame/order covariance',key,residual)
 np.testing.assert_allclose(repaired[key],expected,atol=1e-13,rtol=1e-13)
for name,payload in [('raw',transformed),('repaired',dict(transformed,**repaired))]:
 energies,berry,optical=responses(payload,18)
 expected_berry=np.linalg.det(frame)*reference['berry_'+name]@frame.T
 expected_optical=frame@reference['optical_'+name]@frame.T
 print(name,'frame/order Berry error',np.max(np.abs(berry-expected_berry)))
 print(name,'frame/order optical error',np.max(np.abs(optical-expected_optical)))
 np.testing.assert_allclose(berry,expected_berry,atol=2e-11,rtol=2e-11)
 np.testing.assert_allclose(optical,expected_optical,atol=2e-11,rtol=2e-11)
