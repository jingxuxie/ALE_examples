+        self.assertGreaterEqual(np.linalg.eigvalsh(-1j * optical).min(), -1e-14)
+
+    def test_analytic_two_band_sign(self):
+        pauli = np.array([[[0, 1], [1, 0]], [[0, -1j], [1j, 0]], [[1, 0], [0, -1]]])
