+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <exception>
+#include <limits>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+struct Material {
+    double noise_scale, anisotropy, drive, omega, gamma, memory_scale;
+};
+
+struct Solver {
