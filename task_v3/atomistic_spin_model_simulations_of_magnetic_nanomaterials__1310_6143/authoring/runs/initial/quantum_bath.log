+                weights[edge] = exchange[kind*kinds+species[neighbors[edge]]]/parameters[kind*6];
+            }
+            if (equilibrated) {
+                double displacement = parameters[kind*6+2]/std::pow(parameters[kind*6+3], 2);
+                for (int component=0; component<3; ++component)
