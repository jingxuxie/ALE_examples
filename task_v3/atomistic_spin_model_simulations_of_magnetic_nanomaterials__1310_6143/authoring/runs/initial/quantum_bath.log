+                first_valid = true;
+            }
+            for (size_t index=0; index<state_size; ++index)
+                stage[index] = state[index]+step*(1.0/5*first[index]);
+            rhs(stage.data(), second.data(), (time+step/5-left_time)/coarse_dt, noise_left, noise_right);
+            for (size_t index=0; index<state_size; ++index)
+                stage[index] = state[index]+step*(3.0/40*first[index]+9.0/40*second[index]);
+            rhs(stage.data(), third.data(), (time+step*3/10-left_time)/coarse_dt, noise_left, noise_right);
+            for (size_t index=0; index<state_size; ++index)
+                stage[index] = state[index]+step*(44.0/45*first[index]-56.0/15*second[index]+32.0/9*third[index]);
+            rhs(stage.data(), fourth.data(), (time+step*4/5-left_time)/coarse_dt, noise_left, noise_right);
+            for (size_t index=0; index<state_size; ++index)
+                stage[index] = state[index]+step*(19372.0/6561*first[index]-25360.0/2187*second[index]
+                    +64448.0/6561*third[index]-212.0/729*fourth[index]);
+            rhs(stage.data(), fifth.data(), (time+step*8/9-left_time)/coarse_dt, noise_left, noise_right);
+            for (size_t index=0; index<state_size; ++index)
