import numpy as np
from development import synthetic
rng=np.random.default_rng(1960)
qubits=14
counts,depths,truth=synthetic(qubits,912,shots=10000,jitter=.04,floor=.008)
blocks=np.zeros((7,qubits),dtype=np.uint8)
for block in range(7):blocks[block,2*block:2*block+2]=1
queries=np.zeros((64,3,qubits),dtype=np.uint8)
for query in queries:
 labels=rng.integers(0,4,size=qubits)
 labels[rng.choice(qubits,2,replace=False)]=[0,1]
 for part in range(3):query[part]=labels==part
parents=np.zeros((qubits,qubits),dtype=np.uint8)
ordering=rng.permutation(qubits)
for index,child in enumerate(ordering):
 if index:parents[child,rng.choice(ordering[:index],size=min(index,2),replace=False)]=1
np.savez('stress_input.npz',counts=counts,depths=depths,n=qubits,blocks=blocks,conditional_queries=queries,parents=parents)
np.savez('stress_truth.npz',probabilities=np.maximum(truth,0))
