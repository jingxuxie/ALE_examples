+    values = values.reshape((channels,) + (2,) * len(scope))
+    maximum = float(np.max(np.abs(values)))
+    log_scale = left_scale + right_scale
+    if maximum > 0.0:
+        values /= maximum
+        log_scale += math.log(maximum)
