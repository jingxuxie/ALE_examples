+def test_sheet_jump_and_principal_value():
+    center = TRIANGLE.mean(axis=0)
+    observers = center + np.array([[0., 0., 1e-9], [0., 0., -1e-9], [0., 0., 0.]])
+    current = np.array([[[1.3, -0.7]]])
