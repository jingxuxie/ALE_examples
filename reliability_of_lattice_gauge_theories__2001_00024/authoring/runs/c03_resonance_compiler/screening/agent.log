+                    following = (site + 1) % length
+                    if following in bits:
+                        valid &= (bits[site] + bits[following] < 2)
+            if not np.any(valid):
+                continue
+            bits = {site: values[valid] for site, values in bits.items()}
+            matter = {}
+            for site in matter_sites:
