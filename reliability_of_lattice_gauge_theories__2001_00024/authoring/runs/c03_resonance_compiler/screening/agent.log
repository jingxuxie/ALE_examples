+MATTER = {
+    "I": ((1, 0), (0, 1)),
+    "raise": ((0, 0), (1, 0)),
+    "lower": ((0, 1), (0, 0)),
+    "n": ((0, 0), (0, 1)),
+    "x": ((0, 1), (1, 0)),
+    "y": ((0, 1j), (-1j, 0)),
+    "z": ((-1, 0), (0, 1)),
+}
+ELECTRIC = {
+    "I": MATTER["I"],
+    "x": ((-1, 0), (0, 1)),
+    "z": ((0, 1), (1, 0)),
+    "y": ((0, -1j), (1j, 0)),
+    "raise": ((-0.5, 0.5), (-0.5, 0.5)),
+    "lower": ((-0.5, -0.5), (0.5, 0.5)),
+}
