+
+
+MATTER = {
+    "I": ((1, 0), (0, 1)),
+    "raise": ((0, 0), (1, 0)),
+    "lower": ((0, 1), (0, 0)),
+    "n": ((0, 0), (0, 1)),
+    "x": ((0, 1), (1, 0)),
+    "y": ((0, 1j), (-1j, 0)),
+    "z": ((-1, 0), (0, 1)),
+}
