+        count = 1 << len(link_sites)
+        for start in range(0, count, 65536):
+            states = np.arange(start, min(start + 65536, count), dtype=np.uint64)
+            bits = {site: ((states >> index) & 1).astype(np.int8) for site, index in positions.items()}
