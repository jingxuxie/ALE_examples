+                scores = 0.75 * values.min(axis=1) + 0.25 * values.mean(axis=1)
+                ticks = candidates[np.argmax(scores)]
+        score = _quality(margins(rows, ticks, hardware, phase))
+        if score > best[phase_index][0]:
+            best[phase_index] = (score, ticks.copy(), phase)
+        iteration += 1
