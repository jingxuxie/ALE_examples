+def spectrum(bath, frequency):
+    frequency = np.asarray(frequency, dtype=float)
+    if bath["beta"] == 0:
+        return np.full_like(frequency, bath["amplitude"])
+    return (
+        bath["amplitude"]
+        * (frequency**2 + bath["cutoff"] ** 2) ** (-0.5 * bath["beta"])
+        + bath["floor"]
+    )
+
