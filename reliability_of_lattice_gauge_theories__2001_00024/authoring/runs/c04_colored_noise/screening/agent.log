import json
import numpy as np
with open('example_result.json') as source:
    result = json.load(source)
print('bath:', result['bath'])
print('selected:', result['selected_action'])
for action, values in result['predictions'].items():
    print(action, 'gauge/fidelity final:', values['gauge'][-1], values['fidelity'][-1])
for audit in result['audit']:
