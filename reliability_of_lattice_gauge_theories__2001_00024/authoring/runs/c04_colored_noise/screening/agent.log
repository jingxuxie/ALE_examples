+
+def state_vector(specification):
+    state = np.zeros(DIMENSION, dtype=complex)
+    state[np.asarray(specification["indices"], dtype=int)] = (
+        np.asarray(specification["real"]) + 1j * np.asarray(specification["imag"])
+    )
+    return state
