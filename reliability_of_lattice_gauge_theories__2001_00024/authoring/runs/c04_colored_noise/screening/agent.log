+            objective = float(fit.fun @ fit.fun + 4 * np.log(count))
+            if objective < best_objective - 1e-8:
+                best_objective = objective
+                best_bath = dict(zip(("amplitude", "cutoff", "floor", "eta"), map(float, fit.x)))
+                best_bath["beta"] = beta
+    return best_bath
