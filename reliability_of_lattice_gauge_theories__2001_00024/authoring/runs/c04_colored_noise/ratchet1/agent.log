+                "electric": expected[:, 1].tolist(), "density": expected[:, 2:].tolist(),
+            }
+            risk = float(np.trapz(0.45 * expected[:, 0] + 0.55 * (1.0 - fidelities), times) / times[-1])
+            cached_predictions[key] = prediction, risk
