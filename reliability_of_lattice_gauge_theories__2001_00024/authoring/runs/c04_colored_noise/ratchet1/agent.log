/bin/bash -lc "OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 python - <<'PY'
import copy, json, time
import numpy as np
from scipy import linalg, optimize
from scipy.sparse.linalg import expm_multiply
import solver

case=json.load(open('../participant/input/example_case.json'))
rng=np.random.default_rng(4587)
frequency_grid=np.r_[0.,np.geomspace(.02,30.,33)]
started=time.perf_counter()
for beta,amplitude,cutoff,floor,eta in [
    (0,.000015,1.,0.,0.), (0,.04,1.,0.,1.),
    (1,.000012,.12,0.,.98), (1,.119,1.2,.019,.03),
    (2,.00001,1.2,0.,1.), (2,.06,.12,.002,0.),
    (2,.002,.45,.0001,.61),
]:
    truth=dict(beta=beta,amplitude=amplitude,cutoff=cutoff,floor=floor,eta=eta)
    rows=copy.deepcopy(case['calibration'])
    for row in rows:
        rate=(1+row['mode']*eta)*np.dot(row['weight'],solver.spectrum(row['omega'],truth))
        row['sigma']=max(1e-12,.002*rate)
        row['value']=rate
    fitted=solver.fit_bath(rows)
    error=np.max(abs(solver.spectrum(frequency_grid,fitted)/solver.spectrum(frequency_grid,truth)-1))
    eta_error=abs(fitted['eta']-eta)
    print('fit exact',beta,eta,'model',fitted['beta'],'spectrum error',error,'eta error',eta_error)
    assert fitted['beta']==beta and error<1e-6 and eta_error<1e-6
print('fit checks seconds',time.perf_counter()-started)

ideal,error,constraints,occupation,observables,masks=solver.build_system(case)
action=case['audit']['action']
coefficients=np.array(action['coefficients'])
hamiltonian=ideal+case['model']['lambda']*error
hamiltonian[np.diag_indices(64)]+=action['strength']*(coefficients@constraints)+case['model']['kappa']*action['strength']**2*((np.array(case['model']['crosstalk'])*coefficients**2)@occupation)
system=solver.SecularSystem(hamiltonian,masks)
initial=solver.state_vector(case['audit']['states'][1])
bath=case['audit']['bath']
dissipator,_=system.dissipator(case['model'],bath)
initial_eigen=system.vectors.conj().T@initial
initial_density=np.outer(initial_eigen,initial_eigen.conj())
frequencies=(system.energies[:,None]-system.energies[None,:]).ravel()
from scipy import sparse
full_generator=dissipator-sparse.diags(1j*frequencies)
short_times=np.linspace(0,3.,7)
actual=system.evolve(dissipator,initial,short_times)
expected=expm_multiply(full_generator,initial_density.ravel(),start=0.,stop=3.,num=7).reshape(7,64,64)
print('full-generator short-time error',np.max(np.abs(actual-expected)))
assert np.max(np.abs(actual-expected))<1e-11

long_times=np.asarray(case['times'])
slow=expm_multiply(dissipator,initial_density.ravel(),start=0.,stop=long_times[-1],num=len(long_times))
expected=(slow*np.exp(-1j*long_times[:,None]*frequencies[None,:])).reshape(7,64,64)
actual=system.evolve(dissipator,initial,long_times)
print('independent long-time propagation error',np.max(np.abs(actual-expected)))
