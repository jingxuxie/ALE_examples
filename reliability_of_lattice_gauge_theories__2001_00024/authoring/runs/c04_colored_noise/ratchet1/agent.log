+def state_vector(specification):
+    vector = np.zeros(DIMENSION, dtype=complex)
+    vector[np.asarray(specification["indices"], dtype=int)] = (
+        np.asarray(specification["real"]) + 1j * np.asarray(specification["imag"])
+    )
+    return vector
