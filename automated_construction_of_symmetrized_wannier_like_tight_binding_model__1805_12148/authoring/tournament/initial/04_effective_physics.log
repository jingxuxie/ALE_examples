import numpy as np
from scipy.linalg import eigh
from solve import export, KINETIC, VELOCITY
random=np.random.default_rng(8437)
def hermitian(dimension):
 matrix=random.normal(size=(dimension,dimension))+1j*random.normal(size=(dimension,dimension))
 return (matrix+matrix.conj().T)/2
bands=5; dimension=2; levels=7
energy=np.array([-3.,.1,4.,.8,6.])
selected=np.array([3,1])
linear=np.array([hermitian(bands) for _ in range(3)])
case=dict(energy=energy,momentum=linear/VELOCITY,target=selected,spin=np.zeros((3,dimension,dimension),complex),dft_repr=np.eye(dimension)[None].astype(complex),standard_repr=np.eye(dimension)[None].astype(complex),antiunitary=np.array([False]),cart_rotation=np.eye(3)[None],order=np.array(3))
result=export(case)
lowering=np.diag(np.sqrt(np.arange(1,levels)),1)
wavevectors=[lowering+lowering.T,1j*(lowering-lowering.T),np.zeros((levels,levels))]
unperturbed=np.kron(np.diag(energy),np.eye(levels))
perturbation=sum(np.kron(linear[axis],wavevectors[axis]) for axis in range(3))
kinetic=KINETIC*np.kron(np.eye(bands),sum(matrix@matrix for matrix in wavevectors))
retained=np.array([band*levels+level for band in selected for level in range(levels)])
low_levels=np.array([band*levels+level for band in range(dimension) for level in range(levels-1)])
