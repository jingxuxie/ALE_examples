/bin/bash -lc "python - <<'PY'
import numpy as np, sys, os
with np.load('input/smoke/model.npz',allow_pickle=False) as data:
 zero=np.flatnonzero(np.all(data['rvec']==0,axis=1))[0]
 print('python',sys.version)
 print('numpy',np.__version__)
 print('centers',data['centers'])
 print('query points',data['query_points'])
 print('onsite connection diagonal',data['connection'][zero,np.arange(24),np.arange(24)])
 for index,unitary in enumerate(data['unitary']):
  mapped = data['centers'] @ data['cartesian_rotations'][index].T + (data['translations'][index]-data['orbital_shifts'][index])@data['lattice']
  weights=np.abs(unitary)**2
  mismatch=weights@mapped-data['centers']
  print('op',index,'center maxres',np.max(np.abs(mismatch)),'unitary_res',np.max(abs(unitary@unitary.conj().T-np.eye(24))))
