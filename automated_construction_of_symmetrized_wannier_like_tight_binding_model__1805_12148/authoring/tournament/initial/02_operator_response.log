+        [np.sin(0.6) * np.exp(-0.3j), -np.cos(0.6)],
+    ])
+    screw = np.kron(np.array([[0, 1], [1, 0]]), orbital_rotation)
+    rotation = np.diag([-1, -1, 1])
+    return {
+        \"lattice\": np.diag([2.0, 3.0, 4.0]),
+        \"rvec\": vectors,
+        \"ham\": hopping,
+        \"connection\": connection,
+        \"centers\": generator.normal(size=(orbital_count, 3)),
