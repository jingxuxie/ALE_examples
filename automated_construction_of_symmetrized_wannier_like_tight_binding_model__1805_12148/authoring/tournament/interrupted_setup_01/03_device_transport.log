import numpy as np
from scipy.linalg import eig, svdvals
case=np.load('input/example.npz'); blocks={tuple(tag):block for tag,block in zip(case['h_R'],case['h_matrices'])}; dim=case['h_matrices'].shape[1]
for lead in range(int(case['lead_count'])):
 tags=case[f'lead_cells_{lead}']; period=case[f'lead_period_{lead}']; size=len(tags)*dim
 onsite=np.zeros((size,size),complex); coupling=onsite.copy()
 for aa,tag_a in enumerate(tags):
  for bb,tag_b in enumerate(tags):
   onsite[aa*dim:(aa+1)*dim,bb*dim:(bb+1)*dim]=blocks.get(tuple(tag_b-tag_a),0)
   coupling[aa*dim:(aa+1)*dim,bb*dim:(bb+1)*dim]=blocks.get(tuple(tag_b-tag_a-period),0)
 print('lead',lead,'size',size,'rank B',np.linalg.matrix_rank(coupling),'svals',svdvals(coupling))
 energy=case['energies'][0]; eye=np.eye(size)
 lhs=np.block([[energy*eye-onsite,-coupling],[eye,np.zeros_like(eye)]])
 rhs=np.block([[coupling.conj().T,np.zeros_like(eye)],[np.zeros_like(eye),eye]])
 values,vectors=eig(lhs,rhs)
 propagating=np.abs(abs(values)-1)<1e-7
 modes=vectors[size:,propagating]; modes/=np.linalg.norm(modes,axis=0)
 velocities=-2*np.imag(np.einsum('ij,ij->j',modes.conj(),coupling.conj().T@modes)*values[propagating])
 print('propagating',np.count_nonzero(propagating),'velocities',velocities)
 selected=(abs(values)<1-1e-7); selected[propagating]=velocities>0
 print('selected',sum(selected))
 upper=vectors[:size,selected]; lower=vectors[size:,selected]
 sigma=np.linalg.solve(lower.T,(coupling.conj().T@upper).T).T
 green=np.linalg.inv(energy*eye-onsite-sigma)
 print('sigma norm',np.linalg.norm(sigma),'residual',np.linalg.norm(sigma-coupling.conj().T@green@coupling),'Gamma eigs',np.linalg.eigvalsh(1j*(sigma-sigma.conj().T))[-12:], 'cond',np.linalg.cond(lower))
