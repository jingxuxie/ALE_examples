+        correction = forward @ green_backward
+        surface += correction
+        bulk += correction + backward @ green_forward
+        forward = forward @ green_forward
+        backward = backward @ green_backward
+        if max(linalg.norm(forward), linalg.norm(backward)) < 1e-13:
