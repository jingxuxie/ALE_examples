+                    color = '#cf1338' if charge > 0 else '#00eeee'
+                    drawing.ellipse((pixel_x - 3, pixel_y - 3, pixel_x + 3, pixel_y + 3), outline=color, width=2)
+            row = tables[case, frame]
+            text(image, (horizontal + 275, vertical + 40), f't={row["time"]}', scale=1.5)
