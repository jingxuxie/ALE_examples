+def length_scale(model):
+    diagonal, offdiagonal = model.hessian(model.start)
+    onsite = diagonal.copy()
+    onsite[:-1] += offdiagonal
+    onsite[1:] += offdiagonal
+    stiffness = np.maximum(onsite, 0.02)
