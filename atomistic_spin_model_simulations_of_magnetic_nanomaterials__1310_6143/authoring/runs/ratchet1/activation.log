+
+
+def search_planar(model, deadline):
+    sites, halfspan, widths = locations(model)
+    candidates = []
+
+    def add_candidate(candidate, low=0, high=None):
+        if candidate is None:
+            return False
+        if high is None:
+            high = model.count
+        full = model.start.copy()
+        full[low:high] = candidate
