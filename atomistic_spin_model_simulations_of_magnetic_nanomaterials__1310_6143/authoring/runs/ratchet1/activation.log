+    band[1, 1:-2:2] = offdiagonal[:, 1, 0]
+    band[2, 0:-2:2] = offdiagonal[:, 0, 0]
+    band[2, 1:-2:2] = offdiagonal[:, 1, 1]
+    band[3, 0:-2:2] = offdiagonal[:, 0, 1]
