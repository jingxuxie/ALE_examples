+        amplitude = 0.10 / np.max(np.linalg.norm(unstable, axis=1))
+        endpoints = [basin_full(model, sphere_step(candidate, sign * amplitude * unstable), halfspan, deadline)
+                     for sign in (-1, 1)]
+        if sorted(endpoints) == [0, 1]:
