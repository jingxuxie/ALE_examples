+
+def sphere_step(spins, tangent):
+    lengths = np.linalg.norm(tangent, axis=-1, keepdims=True)
+    result = np.cos(lengths) * spins + np.sinc(lengths / np.pi) * tangent
+    return result / np.linalg.norm(result, axis=-1, keepdims=True)
