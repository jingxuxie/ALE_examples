+        result = minimize(objective, initial.ravel(), jac=True, method="L-BFGS-B",
+                          options={"gtol": 2e-9, "ftol": 2e-15, "maxiter": maxiter, "maxls": 30, "maxcor": 12})
+        spins = result.x.reshape(-1, 3)
+        spins /= np.linalg.norm(spins, axis=1, keepdims=True)
+        for iteration in range(4):
+            _, gradient, band, basis = self.derivatives(spins)
+            if np.max(np.abs(gradient)) < 2e-10:
+                break
+            try:
