+    def angles(self, spins):
+        projected = spins @ self.plane
+        return np.unwrap(np.arctan2(projected[:, 1], projected[:, 0]))
+
+    def spins(self, angles):
+        return np.stack((np.cos(angles), np.sin(angles)), axis=-1) @ self.plane.T
