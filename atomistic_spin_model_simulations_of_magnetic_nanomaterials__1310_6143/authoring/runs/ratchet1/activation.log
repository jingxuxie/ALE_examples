+def planar_inertia(model, angles):
+    diagonal, offdiagonal = model.hessian(angles)
+    values, vectors = low_modes(diagonal, offdiagonal)
+    if values[0] >= -1e-8 or (len(values) > 1 and values[1] <= 1e-8):
