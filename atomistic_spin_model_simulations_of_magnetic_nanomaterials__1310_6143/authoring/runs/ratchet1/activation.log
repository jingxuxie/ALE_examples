+def tri_solve(diagonal, offdiagonal, rhs, shift=0):
+    band = np.zeros((3, len(diagonal)))
+    band[1] = diagonal + shift
+    band[0, 1:] = offdiagonal
+    band[2, :-1] = offdiagonal
+    return solve_banded((1, 1), band, rhs, check_finite=False)
