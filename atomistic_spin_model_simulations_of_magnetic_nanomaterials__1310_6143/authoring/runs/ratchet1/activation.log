+    return vectors[:, 0] if value > 1e-8 else None
+
+
+def basin_planar(model, initial, halfspan, deadline):
+    angles = initial.copy()
+    if model.count <= 2 * halfspan:
+        angles = model.relax(angles, maxiter=2500)
