+def band_solve(band, gradient, shift=0):
+    width = len(band) - 1
+    symmetric = np.zeros((2 * width + 1, band.shape[1]))
+    symmetric[width:] = band
+    symmetric[width] += shift
+    for offset in range(1, width + 1):
