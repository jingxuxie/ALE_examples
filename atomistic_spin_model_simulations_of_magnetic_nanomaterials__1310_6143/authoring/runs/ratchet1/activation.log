+        basis = self.basis(spins)
+        tangent = np.einsum("nik,ni->nk", basis, gradient)
+        multipliers = np.sum(spins * gradient, axis=1)
+        diagonal = -2 * np.einsum("nik,nij,njl->nkl", basis, self.anisotropy, basis)
