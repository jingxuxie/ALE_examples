+    def basis(self, spins):
+        axes = np.eye(3)[np.argmin(np.abs(spins), axis=1)]
+        first = np.cross(spins, axes)
+        first /= np.linalg.norm(first, axis=1)[:, None]
+        return np.stack((first, np.cross(spins, first)), axis=-1)
