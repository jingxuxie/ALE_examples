+    def plane(self):
+        vectors = np.concatenate((self.start, self.finish, self.field[:1]))
+        _, singular, directions = np.linalg.svd(vectors, full_matrices=False)
+        if singular[-1] > 2e-9 * singular[0]:
+            return None
+        normal = directions[-1]
