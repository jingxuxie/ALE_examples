+            coordinates = coordinates.reshape(-1, 3)
+            lengths = np.linalg.norm(coordinates, axis=1, keepdims=True)
+            spins = coordinates / lengths
+            _, gradient = self.energy_gradient(spins)
+            energy = self.difference(spins, initial)
