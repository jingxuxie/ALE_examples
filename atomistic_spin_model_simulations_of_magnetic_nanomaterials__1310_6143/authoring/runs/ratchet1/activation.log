+class PlanarModel:
+    def __init__(self, model, plane):
+        self.model = model
+        self.plane = plane
+        self.exchange = model.exchange
+        self.anisotropy = np.einsum("ik,nij,jl->nkl", plane, model.anisotropy, plane)
