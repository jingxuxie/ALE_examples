+            tangent={-axis.y*inverse,axis.x*inverse,0};
+        } else {
+            double inverse=1/std::sqrt(axis.y*axis.y+axis.z*axis.z);
+            tangent={0,-axis.z*inverse,axis.y*inverse};
+        }
+        return axis*longitudinal+tangent*(transverse*std::cos(azimuth))+cross(axis,tangent)*(transverse*std::sin(azimuth));
+    }
