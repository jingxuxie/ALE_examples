+    indices = np.clip(np.searchsorted(distance, target, side="right") - 1, 0, len(path) - 2)
+    weight = (target - distance[indices]) / np.maximum(segment[indices], 1e-15)
+    return path[indices] + weight[:, None] * (path[indices + 1] - path[indices])
