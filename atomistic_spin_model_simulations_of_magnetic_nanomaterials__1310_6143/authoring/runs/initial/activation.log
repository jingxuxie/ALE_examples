+    fraction = (2 / np.pi) * np.arctan(np.exp(np.clip((center[:, None] - position[None, :]) / width, -40, 40)))
+    path = model.start + fraction * (model.finish - model.start)
+    path[0] = model.start
+    path[-1] = model.finish
+    return redistribute(path)
