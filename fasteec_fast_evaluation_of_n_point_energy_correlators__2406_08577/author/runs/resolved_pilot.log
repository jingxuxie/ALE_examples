+double wrap(double angle) {
+    if (angle > PI || angle <= -PI) {
+        if (angle > 3.0 * PI || angle <= -3.0 * PI) {
+            angle = std::fmod(angle, TWO_PI);
+        }
+        if (angle > PI) angle -= TWO_PI;
+        if (angle <= -PI) angle += TWO_PI;
+    }
+    return angle;
+}
