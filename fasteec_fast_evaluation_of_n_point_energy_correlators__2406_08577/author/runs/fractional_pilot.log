from pathlib import Path
import solve
root = Path.cwd()
binaries = sorted((path for path in root.glob('correlator_*') if re.fullmatch(r'correlator_[0-9a-f]{16}', path.name)), key=lambda path: path.stat().st_mtime)
job = json.loads(Path('benchmark.json').read_text())
