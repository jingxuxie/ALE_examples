+    (DIRECTORY / "stress_report.json").write_text(json.dumps(report, indent=2))
+    print(json.dumps(report, indent=2), flush=True)
+    events_path.unlink()
+    job_path.unlink()
+
+
+if __name__ == "__main__":
+    main()

