import numpy as np,json,time
from pathlib import Path
p=Path('../../participant/input/targets.json')
data=json.loads(p.read_text())
for t in data['targets']:
 n=t['n_qubits'];d=2**n;U=np.array(t['unitary_real'])+1j*np.array(t['unitary_imag'])
 print('\\n',t['id'])
 for k in range(1,n):
  M=U.reshape(2**(n-k),2**k,2**(n-k),2**k).transpose(0,2,1,3).reshape(4**(n-k),4**k)
  s=np.linalg.svd(M,compute_uv=False)
  print('cut',k,'rank',sum(s>1e-8),'sv',np.round(s[:20],4))
 # local input Pauli support in output basis
 X=np.array([[0,1],[1,0]]);Z=np.diag([1,-1]);Y=np.array([[0,-1j],[1j,0]])
 def op(P,q):
  out=np.ones((1,1))
  for i in reversed(range(n)):out=np.kron(out,P if i==q else np.eye(2))
  return out
 paulis=[[op(P,q) for P in [X,Y,Z]] for q in range(n)]
 for way in [0,1]:
  V=U if way==0 else U.conj().T
  print('direction',way,'commutator norms with output local qubits')
  for i in range(n):
   out=[V@P@V.conj().T for P in paulis[i]]
   strength=[sum(np.linalg.norm(A@B-B@A)**2 for A in out for B in paulis[j])**.5/d**.5 for j in range(n)]
   print(i,np.round(strength,6))
