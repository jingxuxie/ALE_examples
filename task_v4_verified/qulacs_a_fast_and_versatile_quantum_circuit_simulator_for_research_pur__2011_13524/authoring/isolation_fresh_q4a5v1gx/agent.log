  p-=3;C a[4],der[12];u3(pars+p,a,der);C vals[3]={0.,0.,0.};int s=1<<qubits[k];
  // Form the 2x2 local environment first, then contract the derivatives.
  C e[4]={0.,0.,0.,0.};
  for(int i=0;i<d;i++)if(!(i&s))for(int j=0;j<d;j++){
