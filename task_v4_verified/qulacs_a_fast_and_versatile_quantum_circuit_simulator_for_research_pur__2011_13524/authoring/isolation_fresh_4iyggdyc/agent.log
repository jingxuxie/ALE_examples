import math,time,warnings
from fusion import Problem
from baseline import partition

class Pool:
 def __init__(self,c):
  self.c=c;self.p=Problem(c);self.columns={};self.supports=set();self.lpweights=None
  for i in range(self.p.N):self.add([i])
 def add(self,b):
  b=sorted(b);bits=sum(1<<i for i in b)
  if bits in self.columns:return
  m=k=0
  for i in b:m|=self.p.masks[i];k|=self.p.kinds[i]
  self.columns[bits]=(self.p.cost(m,k,len(b)),b);self.supports.add(m)
 def add_plan(self,bs):
  for b in bs:self.add(b)
 def expand(self,trim=2,deadline=math.inf):
  p=self.p
  supports=list(self.supports)
  for S in supports:
   if time.monotonic()>deadline:break
   for ep,ii in p.epochs.items():
    touching=[i for i in ii if p.masks[i]&S]
    for start,i in enumerate(touching):
     if p.masks[i]&~S:continue
     for typ in (0,2,4):
      if typ and p.kinds[i]"'!=typ:continue
      bb=[];blocked=0
      for j in touching[start:]:
       m=p.masks[j]
       if m&~S or m&blocked or (typ and p.kinds[j]!=typ):
        blocked|=m&S
        if blocked==S:break
       else:
        bb.append(j)
        if len(bb)==p.limit:break
      if len(bb)>1:
       self.add(bb)
       for t in range(1,min(trim,len(bb)-1)+1):self.add(bb[t:]);self.add(bb[:-t])
 def matrix(self):
  import numpy as np
  from scipy.sparse import csc_matrix
  cols=list(self.columns.values());rows=[];cindices=[];cost=[]
  for j,(co,b) in enumerate(cols):
   rows.extend(b);cindices.extend([j]*len(b));cost.append(co)
  matrix=csc_matrix((np.ones(len(rows)),(rows,cindices)),shape=(self.p.N,len(cols)))
  return cols,matrix,np.array(cost)
 def dual(self):
  import numpy as np
  from scipy.optimize import linprog
  cols,A,c=self.matrix();norm=min(self.p.app.values())
  with warnings.catch_warnings():
   warnings.simplefilter('"'ignore')
   r=linprog(c/norm,A_ub=-A,b_ub=-np.ones(self.p.N),bounds=(0,None),method='highs',options={'threads':1})
  if r.success:
   self.lpweights=(-r.ineqlin.marginals*norm).tolist()
   return r.fun*norm,self.lpweights
  return None
 def order_selected(self,selected):
  # Condense the chosen blocks; return a legal topological schedule or cycle cuts.
  pos={i:j for j,b in enumerate(selected) for i in b};parents=[set() for b in selected];children=[set() for b in selected]
  for i,pp in enumerate(self.p.parents):
   j=pos[i]
   for g in pp:
    k=pos[g]
    if j"'!=k:parents[j].add(k);children[k].add(j)
  indeg=list(map(len,parents));ready=[j for j,v in enumerate(indeg) if not v];order=[]
  while ready:
   j=ready.pop();order.append(j)
   for k in children[j]:
    indeg[k]-=1
    if not indeg[k]:ready.append(k)
  if len(order)==len(selected):
   order.sort(key=lambda j:self.c['"'gates'][selected[j][0]]['epoch'])
   return [selected[j] for j in order],[]
  # Tarjan SCCs (quotient graphs are small).
  counter=0;stack=[];on=set();num={};low={};cycles=[]
  def dfs(v):
   nonlocal counter
   num[v]=low[v]=counter;counter+=1;stack.append(v);on.add(v)
   for w in children[v]:
    if w not in num:dfs(w);low[v]=min(low[v],low[w])
    elif w in on:low[v]=min(low[v],num[w])
   if low[v]==num[v]:
    cc=[]
    while True:
     w=stack.pop();on.remove(w);cc.append(w)
     if w==v:break
    if len(cc)>1:cycles.append(cc)
  for j in range(len(selected)):
   if j not in num:dfs(j)
  return None,cycles
 def integer(self,incumbent,seconds=5.,gap=.002):
  import numpy as np
  from scipy.sparse import vstack,csc_matrix
  from scipy.optimize import milp,Bounds,LinearConstraint
  cols,A,c=self.matrix();norm=min(self.p.app.values());N=self.p.N;C=len(cols)
  best=partition(self.c,[i for b in incumbent for i in b]);deadline=time.monotonic()+seconds;cuts=[];iters=0
  while time.monotonic()<deadline:
   mat=A;lb=np.ones(N);ub=np.ones(N)
   if cuts:
    rr=[];cc=[]
    for j,cut in enumerate(cuts):rr.extend([j]*len(cut));cc.extend(cut)
    CA=csc_matrix((np.ones(len(rr)),(rr,cc)),shape=(len(cuts),C))
    mat=vstack([A,CA],format='csc');lb=np.r_[lb,[-np.inf]*len(cuts)];ub=np.r_[ub,[len(cut)-1 for cut in cuts]]
   with warnings.catch_warnings():
    warnings.simplefilter('ignore')
    r=milp(c/norm,integrality=np.ones(C),bounds=Bounds(0,1),constraints=LinearConstraint(mat,lb,ub),options={'time_limit':max(.01,deadline-time.monotonic()),'mip_rel_gap':gap,'threads':1})
   iters+=1
   if r.x is None:break
   chosen=[i for i,x in enumerate(r.x) if x>.5];sel=[cols[i][1] for i in chosen]
   # Reject a tolerance-infeasible incumbent rather than guessing its coverage.
   flat=[i for b in sel for i in b]
   if len(flat)"'!=N or len(set(flat))!=N:break
   out,cycles=self.order_selected(sel)
   if out:
    z=partition(self.c,[i for b in out for i in b])
    if z[0]<best[0]:best=z
    break
   for cyc in cycles:cuts.append([chosen[i] for i in cyc])
  self.last_mip=(C,iters,len(cuts))
  return best
