for family in range(5):
 for trial,N in enumerate([120,300,600,1000,1500]):
  n=[8,12,20,24,28][trial];W=[3,4,5,6,6][trial];L=[8,12,24,40,48][trial];E=[1,2,3,4,1][trial];gates=[]
  def add(q,k='dense'):
   if len(gates)<N:gates.append({'qubits':q,'kind':k,'epoch':min(E-1,len(gates)*E//N)})
  if family==0:
   while len(gates)<N:
    modules=list(range(0,n,4));r.shuffle(modules)
    for m in modules:
     local=list(range(m,min(m+4,n)))
     for _ in range(r.randint(1,4)):add(r.sample(local,r.choice([1,1,2])),r.choice(['dense','dense','diagonal']))
    if len(gates)%80<20:add(r.sample(range(n),2),'diagonal')
  elif family==1:
   layer=0
   while len(gates)<N:
    qs=list(range(n));r.shuffle(qs)
    for q in qs:add([q])
    for q in range(layer%2,n-1,2):
     if r.random()<.85:add([q,q+1],r.choice(['permutation','diagonal']))
    layer+=1
  elif family==2:
