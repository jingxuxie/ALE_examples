                record["failures"].append("continuation")
                path_certified = False
    worst = min(record["occupation_violation"] for record in records)
    maximum_dad = max(record["rdm_dad"] for record in records)
    certified = endpoint_feasible and path_certified
    return {"passed": bool(certified and worst >= CONSTRAINTS["population_violation_min"]),
            "core_score": float(worst if certified else 0), "endpoint_feasible": endpoint_feasible,
            "path_certified": path_certified, "worst_population_violation": worst,
            "max_dad": maximum_dad, "max_energy_error": max(record["energy_error"] for record in records),
            "point_count": len(records), "points": records}
