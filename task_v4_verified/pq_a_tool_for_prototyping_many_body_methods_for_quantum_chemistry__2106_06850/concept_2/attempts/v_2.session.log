+        self.get(vector)
+        if self.jac is None:
+            self.jac = np.asarray(derivative(jnp.array(vector)))
+        return self.jac
+
+
+def pack(interaction, result):
+    multipliers = oracle.lambda_state(result)[0]
+    return np.concatenate((interaction[upper], result.amplitudes, multipliers))
