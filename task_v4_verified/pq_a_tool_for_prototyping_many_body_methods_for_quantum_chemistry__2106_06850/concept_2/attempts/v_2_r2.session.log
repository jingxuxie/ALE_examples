/bin/bash -c "OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 python - <<'PY' > final_validation.log 2>&1
from search import *
from independent_verify import verify
oracle = DeterminantCC()
valid = []
for filename in ['centered.json', 'polished.json']:
    data = json.loads(Path(filename).read_text())
    interaction = np.asarray(data['pair_matrix'])
    amplitudes = np.asarray(data['amplitudes'])
    hamiltonian = oracle.hamiltonian(CONSTRAINTS['orbital_energies'], interaction)[0]
    residual, jacobian, hbar, positive, negative = oracle.equations(hamiltonian, amplitudes)
    result = CCResult(amplitudes, float(hbar[0,0]), float(np.max(abs(residual))), jacobian, hbar, positive[:,0], negative, True)
    diagnostics = oracle.diagnostics(hamiltonian, result)
    path = check_continuation(interaction, amplitudes, oracle)
    print('CANDIDATE', filename, 'failures', endpoint_failures(diagnostics), 'delta', diagnostics['occupation_violation'], 'path', path['passed'], flush=True)
    if not endpoint_failures(diagnostics) and path['passed'] and diagnostics['occupation_violation'] >= .02:
        valid.append((diagnostics['reference_weight'], filename, data, diagnostics, path))
assert valid
_, filename, data, diagnostics, path = max(valid)
assert set(data) == {'schema_version','orbital_energies','pair_matrix','amplitudes'}
assert data['schema_version'] == 1
assert data['orbital_energies'] == CONSTRAINTS['orbital_energies']
Path('submission.json').write_text(json.dumps(data, indent=2, allow_nan=False)+'\\n')
assert Path('submission.json').stat().st_size <= 65536
Path('submission.public_validation.json').write_text(json.dumps({'source':filename,'endpoint':diagnostics,'continuation':path},indent=2,allow_nan=False))
verify('submission.json')
independent = json.loads(Path('submission.independent.json').read_text())
upper = {'pair_entry_max':1.5,'pair_frobenius':7.,'pair_symmetry_error':1e-12,
 'canonical_fock_error':2e-10,'hamiltonian_hermiticity_error':2e-10,'reference_gradient_error':2e-10,
 'cc_residual':2e-9,'lambda_residual':2e-9,'amplitude_norm':1.25,'lambda_norm':1.5,
 'energy_error':1e-4,'jacobian_condition':100.,'rdm_dad':.001,'path_endpoint_error':5e-7}
lower = {'ground_overlap':.999,'reference_weight':.45,'fci_gap':.1,'hf_real_min':.05,
 'hf_imaginary_min':.05,'eom_real_min':.05,'occupation_violation':.02}
for key, bound in upper.items():
    assert independent[key] <= bound, (key, independent[key], bound)
for key, bound in lower.items():
    assert independent[key] >= bound, (key, independent[key], bound)
assert abs(independent['biorthogonal_norm']-1) <= 2e-8
assert abs(independent['rdm_trace']-3) <= 2e-8
for key in ['exact_occupations','right_occupations']:
    assert min(independent[key]) >= -2e-9 and max(independent[key]) <= 1+2e-9
for row in independent['path']:
    assert row['residual'] <= 2e-9
    assert row['gap'] >= .08
    assert row['overlap'] >= .995
    assert row['amplitude_step'] <= .25
    assert row['jacobian_singular_min'] >= .02
print('ALL FINAL VALIDATION CHECKS PASSED; selected',filename,flush=True)
print('FINAL SUMMARY',json.dumps({key:independent[key] for key in ['occupation_violation','rdm_dad','energy_error','ground_overlap','reference_weight','hf_real_min','jacobian_condition']}),flush=True)
