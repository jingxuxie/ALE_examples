+def compositions(total, count, minimum=1):
+    if count == 1:
+        if total >= minimum:
+            yield (total,)
+        return
+    for first in range(minimum, total - minimum * (count - 1) + 1):
+        for tail in compositions(total - first, count - 1, minimum):
+            yield (first,) + tail
+
+
+def schedules(count):
