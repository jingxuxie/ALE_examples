+MAPPING = np.array([(horizontal % 2) * 2 + vertical % 2 for horizontal in range(4) for vertical in range(4)])
+REDUCED_KINETIC = np.array([[0, -2, -2, 0], [-2, 0, 0, -2], [-2, 0, 0, -2], [0, -2, -2, 0]], dtype=float)
+DELTA = MODEL['beta'] / 16
+COUPLING = np.arccosh(np.exp(2 * DELTA))
