instances = []
for family in range(8):
    instances.extend(public[family*6:(family+1)*6])
    instances.extend(synthetic[family*120:(family+1)*120])
artifact=json.loads((ROOT/'prob_prunebest_100.json').read_text())
word=np.array([NAMES.index(stage['component']) for stage in artifact['stages'][:17]])
values=np.array([stage['coefficient'] for stage in artifact['stages'][:17]])
values[-1]/=2
objective=Objective(instances)
values=objective.optimize(word,values,seconds=120,penalty=-3,label='prob_more_work')
summary,ratios=evaluate(*full(word,values),instances=generate(240,seed=981294),verbose=True)
np.savez(ROOT/'prob_more_validation.npz',ratios=ratios)
(ROOT/'prob_more_work.json').replace(ROOT/'prob_more.json')
