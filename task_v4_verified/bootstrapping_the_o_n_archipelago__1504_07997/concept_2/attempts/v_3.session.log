+                    candidates = np.where((spins == spins[position]) & (np.arange(solver.count) != 0))[0]
+                    candidates = candidates[~np.isin(candidates, chosen)]
+                    if not len(candidates):
+                        continue
+                    distances = np.abs(dimensions[candidates]-dimensions[position])
