import numpy as np
from gauss import GaussModel
from scipy.linalg import eigh
m=GaussModel()
for seed in [301,302,303,304,311,312,313,314]:
 p=np.load(f'gauss_{seed}_continuous.npy')
 r,j=m.compute(p)
 h,_=m.matrix(p,0)
 ev=eigh(h,eigvals_only=True,check_finite=False)
 g=j.T@r
 free=((p>1e-6)&(p<1-1e-6))
 sing=np.linalg.svd(j,compute_uv=False)
 print(seed,'loss',sum(r*r),'min gap',np.min(np.diff(ev)),'ev',ev[248:264], 'grad',np.linalg.norm(g[free]),'sing',sing[[0,-1]],flush=True)
 dp=np.random.default_rng(4).normal(0,1,144); dp/=np.linalg.norm(dp)
 delta=1e-6
 finite=(m.fun(p+dp*delta)-m.fun(p-dp*delta))/(2*delta)
 print('jerr',np.linalg.norm(finite-j@dp),'norm',np.linalg.norm(j@dp),flush=True)
