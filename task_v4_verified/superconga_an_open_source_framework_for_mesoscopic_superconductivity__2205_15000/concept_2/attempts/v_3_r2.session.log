+def batch(masks):
+    model=Screen()
+    closest=1e9
+    tested=0
+    for mask in masks:
+        if (OUTPUT/'enumeration_found.json').exists():
+            break
+        pattern=np.array([(mask>>index)&1 for index in range(144)],dtype=int)
+        grid=np.ones((16,16),dtype=int)
