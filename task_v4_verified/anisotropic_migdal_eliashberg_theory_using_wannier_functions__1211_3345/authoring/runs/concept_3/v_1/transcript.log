+    second = (.07 + .11 * latent[:, 7]) if family == 2 else (.01 + .09 * latent[:, 7])
+    replicas = np.stack([1 - first - second, first, second], axis=1)
+    measure = replicas[:, :, None, None] * physics.measure
+    return centers, widths, coherence[:, None], measure
+
+
+def batch_generate(physics, target_physics, parameters, family):
+    bands = 3 if family == 3 else 2
+    if bands == 3:
+        first = .18 + .3 * parameters[:, 0]
+        second = (1 - first) * (.3 + .4 * parameters[:, 1])
+        mixture = np.stack([first, second, 1 - first - second], axis=1)
+    else:
+        first = .25 + .5 * parameters[:, 0]
+        mixture = np.stack([first, 1 - first], axis=1)
+    weight = mixture[:, None, :] * np.array([[1., 1., 1.], [.45, 1., 1.65]])[None, :, :bands]
+    weight /= weight.sum(axis=2, keepdims=True)
+    values = np.zeros((len(parameters), 2, 2, len(physics.omega)))
