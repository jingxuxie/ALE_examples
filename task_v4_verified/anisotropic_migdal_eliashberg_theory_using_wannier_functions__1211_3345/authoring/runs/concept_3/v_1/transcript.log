  active=np.arange(30 if family==3 else 22);active=active[active"'!=1] if family!=3 else active
  logdet[index,family]=np.linalg.slogdet(fits['"'hessians'][index,family][np.ix_(active,active)])[1]
for volume in [0,.5,1.]:
 for temperature in [1.,2.,4.]:
