+import os
+os.environ['OPENBLAS_NUM_THREADS'] = '1'
+import argparse
+import time
+import numpy as np
+from model import Physics, InterpolatedPhysics, Fit
+from network import predict_network
+from experiment import PUBLIC, OUTPUT, score
+
+
+CORE = np.array([0, 1, 2, 3, 6, 11, 12, 13, 14, 19, 20, 21, 22, 27, 28, 29])
+SCALES = np.array([.008] * 7 + [.010, .012, .012, .012, .010, .008, .006])
+
+
+def physical_features(physics, target_physics, observed, sigma, neural, random):
+    fitter = Fit(physics, observed, sigma, 3, 3.)
+    parameters, fitted = fitter.run(max_nfev=60)
+    alternative, result = fitter.run(random.uniform(.05, .95, 30), max_nfev=60)
+    if result.cost < fitted.cost:
+        parameters, fitted = alternative, result
+    covariance = np.linalg.inv(fitted.jac.T @ fitted.jac)
+    mass = target_physics.target(parameters, 3)
+    return np.concatenate([parameters[CORE], np.sqrt(np.diag(covariance))[CORE],
+                           ((mass - neural) / SCALES).ravel(), (neural / SCALES).ravel(),
+                           [np.log(sigma[0, 0, 0] / .0012)]])
+
+
+def generate(count=5000):
+    data = np.load(OUTPUT / 'synthetic_extra.npz')
+    omega = np.load(PUBLIC / 'validation_features.npz')['omega']
+    physics = InterpolatedPhysics(omega, 12, 20)
+    target_physics = Physics(omega, 32)
+    random = np.random.default_rng(183881)
+    coefficients = data['inputs'][:count]
+    white = coefficients.reshape(count, 2, 2, 20) @ data['basis'].T
+    amplitudes = np.exp(random.uniform(np.log(.0006), np.log(.0024), count))
+    white += amplitudes[:, None, None, None] * random.normal(size=white.shape)
+    for frequency in range(1, 64):
+        white[..., frequency] = .4 * white[..., frequency - 1] + np.sqrt(.84) * white[..., frequency]
+    observed = white * data['sigma']
+    sigma = amplitudes[:, None, None, None] * np.broadcast_to(data['sigma'], (count, 2, 2, 64))
+    neural = predict_network(observed, sigma, OUTPUT / 'network.npz')
+    features = []
+    started = time.process_time()
+    for index in range(count):
+        features.append(physical_features(physics, target_physics, observed[index], sigma[index], neural[index], random))
+        if index % 100 == 0:
+            print(index, 'CPU', time.process_time() - started, flush=True)
+            np.savez(OUTPUT / 'calibration_data.npz', features=features, neural=neural[:len(features)], target=data['targets'][:len(features)])
+    np.savez(OUTPUT / 'calibration_data.npz', features=features, neural=neural, target=data['targets'][:count])
+    for split in ['train', 'validation']:
+        archive = np.load(PUBLIC / (split + '_features.npz'))
+        labels = np.load(PUBLIC / (split + '_labels.npz'))
+        mask = archive['sheet_count'] == 3
+        observed, sigma = archive['observed'][mask], archive['sigma'][mask]
+        neural = predict_network(observed, sigma, OUTPUT / 'network.npz')
+        features = [physical_features(physics, target_physics, measured, noise, base, random) for measured, noise, base in zip(observed, sigma, neural)]
+        np.savez(OUTPUT / ('calibration_' + split + '.npz'), features=features, neural=neural, target=labels['spectral_mass'][mask])
+
+
+def fit():
+    data = np.load(OUTPUT / 'calibration_data.npz')
+    features = data['features']
+    center = features.mean(axis=0)
+    scale = np.maximum(features.std(axis=0), .03)
+    inputs = (features - center) / scale
+    inputs = np.concatenate([np.ones((len(inputs), 1)), inputs], axis=1)
+    targets = ((data['target'] - data['neural']) / SCALES).reshape(len(inputs), -1)
+    count = int(.8 * len(inputs))
+    for penalty in [10., 100., 1000., 10000.]:
+        coefficients = np.linalg.solve(inputs[:count].T @ inputs[:count] + penalty * np.eye(inputs.shape[1]), inputs[:count].T @ targets[:count])
+        print('penalty', penalty, flush=True)
+        corrected = data['neural'][count:] + (inputs[count:] @ coefficients).reshape(-1, 3, 14) * SCALES
+        corrected = np.maximum(corrected, 0); corrected /= corrected.sum(axis=2, keepdims=True)
+        score(corrected, data['target'][count:], np.full(len(corrected), 3))
+        for split in ['train', 'validation']:
+            holdout = np.load(OUTPUT / ('calibration_' + split + '.npz'))
+            holdout_features = (holdout['features'] - center) / scale
+            holdout_features = np.concatenate([np.ones((len(holdout_features), 1)), holdout_features], axis=1)
+            corrected = holdout['neural'] + (holdout_features @ coefficients).reshape(-1, 3, 14) * SCALES
+            corrected = np.maximum(corrected, 0);corrected /= corrected.sum(axis=2, keepdims=True)
+            score(corrected, holdout['target'], np.full(len(corrected), 3))
+            np.savez(OUTPUT / ('calibrated_' + str(penalty) + '_' + split + '.npz'), spectral_mass=corrected)
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser()
+    parser.add_argument('mode', choices=['generate', 'fit'])
+    parser.add_argument('--count', type=int, default=5000)
+    arguments = parser.parse_args()
+    generate(arguments.count) if arguments.mode == 'generate' else fit()
