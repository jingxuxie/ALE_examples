+
+
+def local_predictions(train, targets, query, amplitudes, distance_scale, neighbors, penalty=1., bandwidth=1.):
+    dimensions = min(12, train.shape[1])
+    tree = cKDTree(train[:, :dimensions] / distance_scale[:dimensions])
+    distances, indices = tree.query(query[:, :dimensions] / distance_scale[:dimensions], k=neighbors)
+    predictions = []
+    for query_index in range(len(query)):
+        selected = indices[query_index]
+        distance = distances[query_index] ** 2
+        weights = np.exp(-distance / (max(distance[-1], 1e-12) * bandwidth))
+        weights /= weights.sum()
+        local_x = train[selected]
+        local_y = targets[selected]
+        mean_x = weights @ local_x
+        mean_y = weights @ local_y
+        centered_x = local_x - mean_x
+        centered_y = local_y - mean_y
+        covariance_x = centered_x.T @ (weights[:, None] * centered_x)
+        covariance_xy = centered_x.T @ (weights[:, None] * centered_y)
+        covariance_x += penalty * amplitudes[query_index] ** 2 * np.eye(train.shape[1])
+        prediction = mean_y + (query[query_index] - mean_x) @ np.linalg.solve(covariance_x, covariance_xy)
+        predictions.append(prediction)
+    predictions = np.maximum(np.array(predictions).reshape(-1, 3, 14), 0)
+    predictions /= predictions.sum(axis=2, keepdims=True)
+    return predictions
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--data', default='synthetic3')
