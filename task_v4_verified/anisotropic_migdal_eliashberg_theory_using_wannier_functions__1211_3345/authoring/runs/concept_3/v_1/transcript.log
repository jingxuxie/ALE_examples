+def truncated_samples(center, covariance, initial, count, random, sweeps=70):
+    eigenvalues, eigenvectors = np.linalg.eigh(covariance)
+    transform = eigenvectors * np.sqrt(np.maximum(eigenvalues, 1e-12))
+    coordinates = np.broadcast_to(np.linalg.solve(transform, initial - center), (count, len(center))).copy()
+    positions = np.broadcast_to(initial, (count, len(center))).copy()
+    for sweep in range(sweeps):
+        for axis in range(len(center)):
+            direction = transform[:, axis]
+            without = positions - coordinates[:, axis, None] * direction
+            edge_zero = -without / direction
+            edge_one = (1 - without) / direction
+            lower = np.max(np.minimum(edge_zero, edge_one), axis=1)
+            upper = np.min(np.maximum(edge_zero, edge_one), axis=1)
+            quantile = ndtr(lower) + random.uniform(size=count) * (ndtr(upper) - ndtr(lower))
+            new_coordinate = ndtri(np.clip(quantile, 1e-15, 1 - 1e-15))
+            positions = without + new_coordinate[:, None] * direction
+            coordinates[:, axis] = new_coordinate
+    return positions, coordinates
+
+
+def estimate(physics, target_physics, observed, sigma, family, parameters, hessian, count=256, seed=123, penalty=3., prior=0., sweeps=70):
+    fitter = Fit(physics, observed, sigma, family, penalty)
+    active = fitter.active
+    fitter.evaluate(parameters[active])
+    hessian = hessian[np.ix_(active, active)]
+    covariance = np.linalg.inv(hessian)
+    center = parameters[active] - covariance @ (fitter.jacobian.T @ fitter.residual)
+    random = np.random.default_rng(seed)
+    samples, coordinates = truncated_samples(center, covariance, parameters[active], count, random, sweeps)
+    logweights = np.zeros(count)
+    predictions = np.zeros((count, 3, 14))
+    for index, sample in enumerate(samples):
+        latent = parameters.copy()
+        latent[active] = sample
+        residual = whiten(physics.forward(latent, family, False) - observed, sigma)
+        logweights[index] = -.5 * np.sum(residual ** 2) + .5 * np.sum(coordinates[index] ** 2) - .5 * prior ** 2 * np.sum((sample - .5) ** 2)
+        predictions[index] = target_physics.target(latent, family)
+    weights = np.exp(logweights - logsumexp(logweights))
+    return np.einsum('n,nij->ij', weights, predictions), 1 / np.sum(weights ** 2), samples, logweights, predictions
