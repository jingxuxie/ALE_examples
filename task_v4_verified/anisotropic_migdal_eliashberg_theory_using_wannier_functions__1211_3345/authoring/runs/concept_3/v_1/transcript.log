+import os
+os.environ['OPENBLAS_NUM_THREADS'] = '1'
+os.environ['OMP_NUM_THREADS'] = '1'
+import argparse
+import time
+import numpy as np
+from model import Physics, InterpolatedPhysics, RANGES, EDGES, whiten
+from experiment import PUBLIC, OUTPUT, score
+
+
+def batch_components(physics, parameters, family, band):
+    latent = parameters[:, 6 + 8 * band:14 + 8 * band]
+    gap_range = RANGES[family, band]
+    center = gap_range[0] + (gap_range[1] - gap_range[0]) * latent[:, 0]
+    anis = (.04 + .30 * latent[:, 1]) if family == 1 else (.015 + .18 * latent[:, 1])
+    gap = center[:, None, None] * (1 + anis[:, None, None] * physics.cos2 + (-.09 + .18 * latent[:, 2, None, None]) * physics.cos4)
+    life = .025 + (.13 if family == 1 else .075) * latent[:, 3]
+    width = life[:, None, None] * (1 + .55 * latent[:, 4, None, None] * physics.coswidth)
+    bandwidth = 4.5 + 2.5 * latent[:, 5]
+    energy = np.sqrt(gap ** 2 + (bandwidth[:, None, None] * physics.xi) ** 2)
+    coherence = gap / energy
+    shifts = np.stack([np.zeros(len(parameters)), 3.2 + 2.3 * parameters[:, 2], 6.7 + 3.3 * parameters[:, 3]], axis=1)
+    dispersions = np.stack([np.zeros(len(parameters)), .1 + .5 * parameters[:, 4], .15 + .75 * parameters[:, 5]], axis=1)
+    centers = energy[:, None] + shifts[:, :, None, None] + dispersions[:, :, None, None] * physics.cosrep[band]
+    widths = width[:, None] + .025 * physics.xi ** 2 + .13 * np.arange(3)[None, :, None, None]
+    first = (.15 + .18 * latent[:, 6]) if family == 2 else (.025 + .13 * latent[:, 6])
+    second = (.07 + .11 * latent[:, 7]) if family == 2 else (.01 + .09 * latent[:, 7])
+    replicas = np.stack([1 - first - second, first, second], axis=1)
+    measure = replicas[:, :, None, None] * physics.measure
+    return centers, widths, coherence[:, None], measure
+
+
+def batch_generate(physics, target_physics, parameters, family):
+    bands = 3 if family == 3 else 2
+    if bands == 3:
+        first = .18 + .3 * parameters[:, 0]
+        second = (1 - first) * (.3 + .4 * parameters[:, 1])
+        mixture = np.stack([first, second, 1 - first - second], axis=1)
+    else:
+        first = .25 + .5 * parameters[:, 0]
+        mixture = np.stack([first, 1 - first], axis=1)
+    weight = mixture[:, None, :] * np.array([[1., 1., 1.], [.45, 1., 1.65]])[None, :, :bands]
+    weight /= weight.sum(axis=2, keepdims=True)
+    values = np.zeros((len(parameters), 2, 2, len(physics.omega)))
+    targets = np.zeros((len(parameters), 3, 14))
+    omega = physics.omega.ravel()[None, :, None, None, None]
+    for band in range(bands):
+        energy, width, coherence, measure = batch_components(physics, parameters, family, band)
+        frequency = omega + width[:, None]
+        inverse = 1 / (frequency ** 2 + energy[:, None] ** 2)
+        diagonal = np.sum(omega * frequency * inverse * measure[:, None], axis=(2, 3, 4))
+        anomalous = np.sum(omega * coherence[:, None] * energy[:, None] * inverse * measure[:, None], axis=(2, 3, 4))
+        sheet = np.stack([diagonal, anomalous], axis=1)
+        values += weight[:, :, band, None, None] * sheet[:, None]
+        energy, width, coherence, measure = batch_components(target_physics, parameters, family, band)
+        cumulative = (np.arctan((EDGES[None, :, None, None, None] - energy[:, None]) / (width[:, None] + .06))
+                      + np.arctan((EDGES[None, :, None, None, None] + energy[:, None]) / (width[:, None] + .06))) / np.pi
+        targets[:, band] = np.sum(np.diff(cumulative, axis=1) * measure[:, None], axis=(2, 3, 4))
+    return values @ physics.interpolation.T, targets
+
+
+def create_data(count, seed, family, name):
+    omega = np.load(PUBLIC / 'validation_features.npz')['omega']
+    physics = InterpolatedPhysics(omega, 12, 20)
+    target_physics = Physics(omega, 32)
+    sigma = (1 + .35 * np.arange(2))[None, :, None] * (.6 + .4 / (1 + omega / 6))
+    basis = physics.interpolation / sigma[0, 0, :, None]
+    basis[1:] = (basis[1:] - .4 * basis[:-1]) / np.sqrt(.84)
+    basis = np.linalg.qr(basis)[0]
+    random = np.random.default_rng(seed)
+    parameters = random.uniform(size=(count, 32))
+    inputs = np.zeros((count, 80), dtype=np.float32)
+    targets = np.zeros((count, 3, 14), dtype=np.float32)
+    started = time.process_time()
+    for offset in range(0, count, 64):
+        clean, target = batch_generate(physics, target_physics, parameters[offset:offset + 64], family)
+        inputs[offset:offset + len(clean)] = (whiten(clean, sigma) @ basis).reshape(len(clean), -1)
+        targets[offset:offset + len(clean)] = target
+        if offset % 6400 == 0:
+            print('generate', offset, 'CPU', time.process_time() - started, flush=True)
+    np.savez(OUTPUT / (name + '.npz'), inputs=inputs, targets=targets, sigma=sigma, basis=basis)
+
+
+def train(name, epochs=100, width=256, seed=123, asset='network', family=3, dimensions=32):
+    import torch
+    from torch import nn
+    torch.set_num_threads(1)
+    torch.manual_seed(seed)
+    data = np.load(OUTPUT / (name + '.npz'))
+    clean = data['inputs'].astype(np.float64)
+    center = clean.mean(axis=0)
+    covariance = np.cov(clean.T)
+    eigenvalues, eigenvectors = np.linalg.eigh(covariance)
+    selected = np.argsort(eigenvalues)[::-1][:dimensions]
+    print('eigenvalues', eigenvalues[selected], flush=True)
+    projection = eigenvectors[:, selected] / np.sqrt(np.maximum(eigenvalues[selected], 1e-12) + .0013 ** 2)
+    clean = (clean - center) @ projection
+    target = data['targets'].reshape(len(clean), -1)
+    target_center = target.mean(axis=0)
+    scales = np.tile(np.array([.008] * 7 + [.010, .012, .012, .012, .010, .008, .006]), 3)
+    normalized = (target - target_center) / scales
+    noise_scale = np.sqrt(np.sum(projection ** 2, axis=0))
+    train_input = torch.tensor(clean, dtype=torch.float32)
+    train_target = torch.tensor(normalized, dtype=torch.float32)
+    noise_scale_t = torch.tensor(noise_scale, dtype=torch.float32)
+    network = nn.Sequential(nn.Linear(dimensions + 1, width), nn.SiLU(), nn.Linear(width, width), nn.SiLU(), nn.Linear(width, width), nn.SiLU(), nn.Linear(width, 42))
+    optimizer = torch.optim.AdamW(network.parameters(), lr=.001, weight_decay=.0001)
+    holdout = []
+    for split in ['train', 'validation']:
+        features = np.load(PUBLIC / (split + '_features.npz'))
+        labels = np.load(PUBLIC / (split + '_labels.npz'))
+        mask = labels['family'] == family
+        encoded = (whiten(features['observed'][mask], data['sigma']) @ data['basis']).reshape(mask.sum(), -1)
+        amplitude = features['sigma'][mask, 0, 0, 0] / data['sigma'][0, 0, 0]
+        encoded = np.concatenate([(encoded - center) @ projection, (np.log(amplitude / .0012))[:, None]], axis=1)
+        holdout.append((torch.tensor(encoded, dtype=torch.float32), labels['spectral_mass'][mask], labels['family'][mask]))
+    started = time.process_time()
+    for epoch in range(epochs):
+        order = torch.randperm(len(clean))
+        losses = []
+        learning_rate = .001 * (.15 + .85 * (1 + np.cos(np.pi * epoch / epochs)) / 2)
+        for group in optimizer.param_groups:
+            group['lr'] = learning_rate
+        for offset in range(0, len(clean), 1024):
+            indices = order[offset:offset + 1024]
+            amplitude = torch.exp(torch.empty(len(indices), 1).uniform_(np.log(.0006), np.log(.0024)))
+            noisy = train_input[indices] + torch.randn(len(indices), dimensions) * amplitude * noise_scale_t
+            noisy = torch.cat([noisy, torch.log(amplitude / .0012)], dim=1)
+            prediction = network(noisy)
+            loss = ((prediction - train_target[indices]) ** 2).mean()
+            optimizer.zero_grad()
+            loss.backward()
+            optimizer.step()
+            losses.append(float(loss.detach()))
+        if epoch % 5 == 0 or epoch == epochs - 1:
+            print('epoch', epoch, 'loss', np.mean(losses), 'CPU', time.process_time() - started, flush=True)
+            for encoded, target, families in holdout:
+                with torch.no_grad():
+                    predicted = network(encoded).numpy() * scales + target_center
+                predicted = predicted.reshape(-1, 3, 14)
+                predicted = np.maximum(predicted, 0)
+                predicted /= predicted.sum(axis=2, keepdims=True)
+                score(predicted, target, families)
+            assets = dict(center=center, projection=projection, target_center=target_center, scales=scales, sigma=data['sigma'], basis=data['basis'])
+            for index, layer in enumerate(network):
+                if isinstance(layer, nn.Linear):
+                    assets['weight' + str(index // 2)] = layer.weight.detach().numpy()
+                    assets['bias' + str(index // 2)] = layer.bias.detach().numpy()
+            np.savez(OUTPUT / (asset + '.npz'), **assets)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('mode', choices=['generate', 'train'])
+    parser.add_argument('--count', type=int, default=100000)
+    parser.add_argument('--seed', type=int, default=13715)
+    parser.add_argument('--family', type=int, default=3)
+    parser.add_argument('--name', default='synthetic3')
+    parser.add_argument('--epochs', type=int, default=100)
+    parser.add_argument('--width', type=int, default=256)
+    parser.add_argument('--dimensions', type=int, default=32)
+    parser.add_argument('--asset', default='network')
+    arguments = parser.parse_args()
+    if arguments.mode == 'generate':
+        create_data(arguments.count, arguments.seed, arguments.family, arguments.name)
+    else:
+        train(arguments.name, arguments.epochs, arguments.width, arguments.seed, arguments.asset, arguments.family, arguments.dimensions)
+
+
+if __name__ == '__main__':
+    main()
