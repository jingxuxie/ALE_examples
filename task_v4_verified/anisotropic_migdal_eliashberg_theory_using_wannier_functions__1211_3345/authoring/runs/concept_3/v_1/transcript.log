+import os
+os.environ['OPENBLAS_NUM_THREADS'] = '1'
+import argparse
+import numpy as np
+from network import predict_network
+from experiment import PUBLIC, OUTPUT, score
+
+
+parser = argparse.ArgumentParser()
+parser.add_argument('--asset', default='network')
+arguments = parser.parse_args()
+for split in ['train', 'validation']:
+    features = np.load(PUBLIC / (split + '_features.npz'))
+    labels = np.load(PUBLIC / (split + '_labels.npz'))
+    mask = features['sheet_count'] == 3
+    predicted = predict_network(features['observed'][mask], features['sigma'][mask], OUTPUT / (arguments.asset + '.npz'))
+    print(split, 'NETWORK', flush=True)
+    score(predicted, labels['spectral_mass'][mask], labels['family'][mask])
+    np.savez(OUTPUT / (arguments.asset + '_' + split + '.npz'), spectral_mass=predicted)
+    hmc_path = OUTPUT / ('trainhmc.npz' if split == 'train' else 'hmcshort.npz')
+    if hmc_path.exists():
+        hmc = np.load(hmc_path)['spectral_mass']
+        count = len(hmc)
+        hmc = hmc[mask[:count]]
+        for weight in [.25, .5, .75]:
+            print(split, 'BLEND', weight, flush=True)
+            score(weight * predicted[:len(hmc)] + (1 - weight) * hmc, labels['spectral_mass'][:count][mask[:count]], labels['family'][:count][mask[:count]])
