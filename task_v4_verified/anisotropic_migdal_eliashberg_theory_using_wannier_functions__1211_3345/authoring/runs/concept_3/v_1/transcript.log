+        amplitude = features['sigma'][mask, 0, 0, 0] / data['sigma'][0, 0, 0]
+        holdout.append(((encoded - mean) @ vectors, amplitude, labels['spectral_mass'][mask], labels['family'][mask]))
+    for floor in [.003, .006, .012, .025]:
+        distance_scale = np.maximum(np.sqrt(values[order]), floor)
+        for neighbors in [256, 1024, 4096]:
+            for penalty in [1., 2.]:
+                print('SETTINGS', floor, neighbors, penalty, flush=True)
+                for split, (query, amplitude, target, families) in zip(['train', 'validation'], holdout):
+                    predicted = local_predictions(train, targets, query, amplitude, distance_scale, neighbors, penalty)
+                    score(predicted, target, families)
+                    np.savez(OUTPUT / ('local_' + str(floor) + '_' + str(neighbors) + '_' + str(penalty) + '_' + split + '.npz'), spectral_mass=predicted)
+
