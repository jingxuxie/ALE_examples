+import os
+os.environ['OPENBLAS_NUM_THREADS'] = '1'
+os.environ['OMP_NUM_THREADS'] = '1'
+import argparse
+import time
+import numpy as np
+from model import Physics, Fit, whiten
+from experiment import PUBLIC, OUTPUT, score
+
+
+def drift(position, momentum, factor, duration):
+    position = position.copy()
+    momentum = momentum.copy()
+    remaining = duration
+    for bounce in range(150):
+        velocity = factor @ momentum
+        times = np.where(velocity > 0, 1 - position, -position) / velocity
+        boundary = np.argmin(times)
+        crossing = max(times[boundary], 0.)
+        if crossing >= remaining:
+            return position + remaining * velocity, momentum
+        position += crossing * velocity
+        position[boundary] = 1. if velocity[boundary] > 0 else 0.
+        normal = factor[boundary]
+        momentum -= (2 * np.dot(momentum, normal) / np.dot(normal, normal)) * normal
+        remaining -= crossing
+    return np.full_like(position, np.nan), momentum
+
+
+def hmc_posterior(physics, target_physics, observed, sigma, family, parameters, hessian, chains=4, steps=200, seed=123, penalty=3., prior=0., warmup=60, trajectory=1.8, step_size=.15):
+    fitter = Fit(physics, observed, sigma, family, penalty)
+    active = fitter.active
+    covariance = np.linalg.inv(hessian[np.ix_(active, active)])
+    factor = np.linalg.cholesky(covariance)
+    random = np.random.default_rng(seed)
+
+    def potential(position):
+        latent = parameters.copy()
+        latent[active] = position
+        values, jacobian = physics.forward(latent, family)
+        residual = whiten(values - observed, sigma).ravel()
+        jacobian = whiten(jacobian, sigma, True).reshape(-1, jacobian.shape[-1])[:, active]
+        energy = .5 * (np.dot(residual, residual) + prior ** 2 * np.sum((position - .5) ** 2))
+        gradient = factor.T @ (jacobian.T @ residual + prior ** 2 * (position - .5))
+        return energy, gradient
+
+    accepted = 0
+    total = 0
+    saved = []
+    step_sizes = []
+    for chain in range(chains):
+        position = parameters[active].copy()
+        energy, gradient = potential(position)
+        epsilon = step_size
+        for iteration in range(steps + warmup):
+            momentum = random.normal(size=len(active))
+            initial_energy = energy + .5 * np.dot(momentum, momentum)
+            proposed = position.copy()
+            proposed_gradient = gradient.copy()
+            proposed_energy = energy
+            leapfrogs = max(2, int(trajectory * random.uniform(.7, 1.3) / epsilon))
+            leapfrogs = min(leapfrogs, 60)
+            for leapfrog in range(leapfrogs):
+                momentum -= .5 * epsilon * proposed_gradient
+                proposed, momentum = drift(proposed, momentum, factor, epsilon)
+                if not np.all(np.isfinite(proposed)):
+                    proposed_energy = np.inf
+                    break
+                proposed_energy, proposed_gradient = potential(proposed)
+                momentum -= .5 * epsilon * proposed_gradient
+            difference = initial_energy - proposed_energy - .5 * np.dot(momentum, momentum)
+            probability = np.exp(min(0., difference))
+            if random.uniform() < probability:
