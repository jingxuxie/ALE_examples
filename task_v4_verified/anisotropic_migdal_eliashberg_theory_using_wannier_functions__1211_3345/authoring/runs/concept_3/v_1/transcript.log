+    clean = data['inputs'].astype(float)
+    mean = clean.mean(axis=0)
+    values, vectors = np.linalg.eigh(np.cov(clean.T))
+    order = np.argsort(values)[::-1][:24]
+    vectors = vectors[:, order]
+    train = (clean - mean) @ vectors
+    targets = data['targets'].reshape(len(clean), -1).astype(float)
+    holdout = []
+    for split in ['train', 'validation']:
+        features = np.load(PUBLIC / (split + '_features.npz'))
+        labels = np.load(PUBLIC / (split + '_labels.npz'))
+        mask = features['sheet_count'] == 3
