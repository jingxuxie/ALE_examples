+        inverse = 1 / (frequency ** 2 + energy[:, None] ** 2)
+        diagonal = np.sum(omega * frequency * inverse * measure[:, None], axis=(2, 3, 4))
+        anomalous = np.sum(omega * coherence[:, None] * energy[:, None] * inverse * measure[:, None], axis=(2, 3, 4))
+        sheet = np.stack([diagonal, anomalous], axis=1)
