+
+import numpy as np
+from scipy.sparse.linalg import LinearOperator, eigs
+from scipy.optimize import brentq
+
+from solve import Model, ReducedModel
+
+
+def leading(model):
+    zero = np.zeros(model.shape)
+    normal_z, mapped = model.map(zero)
+    derivative = model.linearize(zero, normal_z, mapped)
+
+    def product(direction):
+        return direction - derivative(direction.reshape(model.shape)).ravel()
+
+    operator = LinearOperator((zero.size, zero.size), matvec=product, dtype=np.float64)
+    eigenvalue, eigenvector = eigs(operator, k=1, which='LR', tol=2e-12, v0=np.ones(zero.size))
+    return eigenvalue[0].real
+
+
+def calibrate(data, excess):
+    full = Model(data)
+    reduced = ReducedModel(full)
+    original_coupling = reduced.weighted_coupling.copy()
+    original_z = reduced.normal_z.copy()
+
+    def objective(factor):
+        reduced.weighted_coupling = factor * original_coupling
+        reduced.normal_z = 1 + factor * (original_z - 1)
+        value = leading(reduced)
+        print('factor', factor, 'lambda', value, 'cpu', time.process_time(), flush=True)
+        return value - 1 - excess
+
+    factor = brentq(objective, 0.01, 2, xtol=1e-13)
+    data['coupling'] *= factor
+    print('full eigenvalue', leading(Model(data)), 'cpu', time.process_time(), flush=True)
+    return data
+
+
+def main():
+    output = Path(__file__).parent
+    if sys.argv[1] == 'critical':
+        with np.load(output / 'stress_large.npz') as archive:
+            data = {key: np.array(archive[key]) for key in archive.files}
+    else:
+        with np.load(Path.cwd() / 'input/examples/combined.npz') as archive:
+            data = {key: np.array(archive[key]) for key in archive.files}
+        parents = np.arange(40) % 12
+        counts = np.bincount(parents, minlength=12)
+        data['weights'] = data['weights'][parents] / counts[parents]
+        data['coupling'] = data['coupling'][:, parents][:, :, parents]
+        data['coulomb'] = data['coulomb'][parents][:, parents]
+        rng = np.random.default_rng(271)
+        perturb = rng.uniform(.8, 1.2, (4, 40, 40))
+        data['coupling'] *= .5 * (perturb + perturb.transpose(0, 2, 1))
+        data['temperature'] = data['omega'].max() / 12000
+        data['omega'][0] = data['omega'].max() / 4000
+        data['omega'][1] = data['omega'].max() / 100
+        data['n_freq'] = np.array(32768)
+        frequency = np.pi * data['temperature'] * (2 * np.arange(32768) + 1)
+        data['initial_delta'] = np.repeat((.4 * data['omega'].max() / (1 + (frequency / data['omega'].max()) ** 2))[None, :], 40, axis=0)
+    data = calibrate(data, 2e-5)
+    np.savez(output / ('stress_' + sys.argv[1] + '.npz'), **data)
+
+
+if __name__ == '__main__':
+    main()
