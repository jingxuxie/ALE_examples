+        warmup = 0
+    else:
+        warmup = 6
+    delta, renormalization = solve_newton(model, delta, tolerance=5e-12, warmup=warmup, verbose=args.verbose)
+    np.savez(args.output, delta=delta, z=renormalization)
+
