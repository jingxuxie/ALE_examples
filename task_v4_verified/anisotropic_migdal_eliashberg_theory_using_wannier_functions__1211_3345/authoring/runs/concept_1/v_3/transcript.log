+def interpolation_matrix(nodes, count):
+    points = np.arange(count)
+    starts = np.clip(np.searchsorted(nodes, points) - 2, 0, len(nodes) - 4)
+    indices = starts[:, None] + np.arange(4)
+    selected = nodes[indices]
