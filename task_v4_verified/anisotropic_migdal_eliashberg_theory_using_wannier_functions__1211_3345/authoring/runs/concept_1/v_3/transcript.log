+        addition = self.frequencies[:, None] + full.frequencies[None, :]
+        difference **= 2
+        addition **= 2
+        for omega in self.omega:
+            minus = omega ** 2 / (omega ** 2 + difference)
+            plus = omega ** 2 / (omega ** 2 + addition)
+            self.kernels.append(((self.interpolation.T @ (minus + plus).T).T.copy(),
+                                 (self.interpolation.T @ (minus - plus).T).T.copy()))
