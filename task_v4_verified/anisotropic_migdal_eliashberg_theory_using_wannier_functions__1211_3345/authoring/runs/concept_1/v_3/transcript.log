+    def map(self, delta):
+        radius = np.hypot(self.frequencies, delta)
+        normal_ratio = -(delta / radius) * (delta / (radius + self.frequencies))
+        normal = self.convolve(normal_ratio, -1)
+        ratio = delta / radius
+        pairing = self.convolve(ratio, 1)
