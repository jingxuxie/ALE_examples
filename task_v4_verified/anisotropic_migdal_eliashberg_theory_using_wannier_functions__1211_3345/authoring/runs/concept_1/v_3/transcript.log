+        rows = 1 + 2 * cumulative[:, indices] + cumulative[:, self.n_freq - 1 - indices] - cumulative[:, self.n_freq + indices]
+        self.normal_z = 1 + np.pi * self.temperature * np.einsum('sab,sn->an', self.weighted_coupling, rows) / self.frequencies
