+        self.weighted_coulomb = full.weighted_coulomb
+        nodes = [0]
+        while nodes[-1] < full.n_freq - 1:
+            nodes.append(min(full.n_freq - 1, nodes[-1] + max(1, int((nodes[-1] + 1) * spacing))))
