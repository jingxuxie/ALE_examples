*** Begin Patch
*** Add File: /srv/home/xuandong/mnt/jingxu/ALE/tasks_v4/anisotropic_migdal_eliashberg_theory_using_wannier_functions__1211_3345/concept_1/attempts/v_5/dev_stress.py
+import os
+os.environ['OPENBLAS_NUM_THREADS'] = '1'
+os.environ['OMP_NUM_THREADS'] = '1'
+import sys
+import time
+from pathlib import Path
+import numpy as np
+from scipy.sparse.linalg import LinearOperator, eigs
+from scipy.sparse.csgraph import connected_components
+from scipy.optimize import brentq
+from fast_model import Model
+from solve import solve
+
+ROOT = Path(__file__).resolve().parent
+PUBLIC = Path(sys.argv[1])
+sys.path.insert(0, str(PUBLIC))
+from eliashberg import Model as Original, load_instance
+
+
+def eigenvalue(instance):
+    model = Model(instance)
+    renormalization = model.map(np.zeros(model.shape))[0]
+    def apply(direction):
+        ratio = direction.reshape(model.shape) / model.frequencies
+        pairing = model.convolve(ratio, 1)
+        pairing -= 2 * (model.weighted_coulomb @ ratio.sum(axis=1))[:, None]
+        return (np.pi * model.temperature * pairing / renormalization).ravel()
+    operator = LinearOperator((np.prod(model.shape), np.prod(model.shape)), matvec=apply, dtype=float)
+    return eigs(operator, k=1, which='LR', v0=np.ones(np.prod(model.shape)), tol=2e-13)[0][0].real
+
+
+def tune(instance, target):
+    base = instance['coupling'].copy()
+    def measure(factor):
+        instance['coupling'] = base * factor
+        return eigenvalue(instance) - target
+    factor = brentq(measure, 0.2, 5., xtol=2e-14)
+    instance['coupling'] = base * factor
+    return factor
+
+
+def check(name, instance):
+    started = time.process_time()
+    delta, renormalization = solve(instance)
+    elapsed = time.process_time() - started
+    norms = Original(instance).residual_norms(delta, renormalization)
+    other = dict(instance)
+    other['initial_delta'] = instance['initial_delta'] * 0.02
+    other_delta, other_z = solve(other)
+    distance = np.max(np.abs(delta - other_delta) / np.max(np.abs(delta), axis=1)[:, None])
+    print(name, 'time', elapsed, 'residual', norms, 'distance', distance,
+          'gaps', delta[:, 0].min(), delta[:, 0].max(), flush=True)
+    if norms[0] > 2e-8 or distance > .002 or np.any(delta[:, 0] <= 0):
+        np.savez(ROOT / ('failed_' + name + '.npz'), **instance)
+
+
+for index, excess in enumerate([3e-9, 1e-8, 1e-6]):
+    instance = load_instance(PUBLIC / 'examples/critical_coulomb_3072.npz')
+    tune(instance, 1 + excess)
+    check('global_' + str(index), instance)
+
+for index, excess in enumerate([3e-9, -3e-9, -1e-6, 1e-5]):
+    instance = load_instance(PUBLIC / 'examples/competing_sheets_2304.npz')
+    coupling = instance['coupling'].sum(axis=0)
+    count, labels = connected_components(coupling > .02 * coupling.max())
+    same = labels[:, None] == labels[None, :]
+    instance['coupling'][:, ~same] *= .001
+    for label, target in enumerate([1.08, 1 + excess, .8]):
+        selected = np.flatnonzero(labels == label)
+        block = dict(instance)
+        block['coupling'] = instance['coupling'][:, selected][:, :, selected]
+        block['coulomb'] = instance['coulomb'][selected][:, selected]
+        block['weights'] = instance['weights'][selected]
+        factor = tune(block, target)
+        mask = (labels[:, None] == label) & (labels[None, :] == label)
+        instance['coupling'][:, mask] *= factor
+    check('sheets_' + str(index), instance)
+
+for index, factor in enumerate([1e-3, 1e-6, 1e-8]):
+    instance = load_instance(PUBLIC / 'examples/weak_interband.npz')
+    coupling = instance['coupling'].sum(axis=0)
+    count, labels = connected_components(coupling > .02 * coupling.max())
+    instance['coupling'][:, labels[:, None] "'!= labels[None, :]] *= factor
+    check('"'weak_' + str(index), instance)
