from eliashberg import load_instance
from fast_model import Model
instance=load_instance('input/examples/phonon_continuum_96.npz')
generator=np.random.default_rng(333)
indices=np.tile(np.arange(12),4)[:40];generator.shuffle(indices)
instance['coupling']=instance['coupling'][:,indices][:,:,indices]
perturb=generator.uniform(.9,1.1,(40,40));perturb=(perturb+perturb.T)/2
instance['coupling']*=perturb
instance['coulomb']=instance['coulomb'][indices][:,indices]
instance['weights']=instance['weights'][indices];instance['weights']/=instance['weights'].sum()
instance['temperature']=np.max(instance['omega'])/12000
instance['n_freq']=32768
freq=np.pi*instance['temperature']*(2*np.arange(32768)+1)
instance['initial_delta']=np.tile(.4*np.max(instance['omega'])/(1+(freq/np.max(instance['omega']))**2),(40,1))
