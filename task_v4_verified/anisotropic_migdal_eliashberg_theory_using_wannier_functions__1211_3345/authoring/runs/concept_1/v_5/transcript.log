+import os
+os.environ['OPENBLAS_NUM_THREADS'] = '1'
+os.environ['OMP_NUM_THREADS'] = '1'
+import sys
+import json
+import time
+from pathlib import Path
+import numpy as np
+from scipy.sparse.linalg import LinearOperator, gmres
+from solve import solve
+
+PUBLIC = Path(sys.argv[1])
+ROOT = Path(__file__).resolve().parent
+sys.path.insert(0, str(PUBLIC))
+from eliashberg import Model, load_instance
+
+
+def reference(instance):
+    model = Model(instance)
+    model.weighted_coupling = np.ascontiguousarray(model.weighted_coupling)
+    model.weighted_coulomb = np.ascontiguousarray(model.weighted_coulomb)
+    delta = np.array(instance['initial_delta'], copy=True, order='C')
+    for iteration in range(20):
+        delta = .3 * delta + .7 * model.map(delta)[1]
+    for iteration in range(60):
+        renormalization, mapped = model.map(delta)
+        amplitude = delta[:, :1].copy()
+        residual = (delta - mapped) / amplitude
+        jacobian = model.linearize(delta)
+        def product(direction):
+            return (jacobian(amplitude * direction.reshape(model.shape)) / amplitude).ravel()
+        operator = LinearOperator((delta.size, delta.size), matvec=product, dtype=float)
+        correction, status = gmres(operator, -residual.ravel(), tol=1e-8, atol=2e-15, restart=35, maxiter=3)
+        correction = correction.reshape(model.shape)
+        scale = np.maximum(np.max(np.abs(delta), axis=1, keepdims=True), np.pi * model.temperature * 1e-10)
+        norm = np.max(np.abs(delta - mapped) / scale)
+        if norm < 2e-12 and np.max(np.abs(correction)) < 2e-6:
+            return delta
+        fraction = min(1., .999999 / max(.999999, -np.min(correction[:, 0])))
+        for backtrack in range(15):
+            candidate = delta + fraction * amplitude * correction
+            next_mapped = model.map(candidate)[1]
+            if np.max(np.abs(candidate - next_mapped) / scale) < norm * (1 - .01 * fraction):
+                break
+            fraction *= .5
+        delta = candidate
+    return delta
+
+
+results = []
+for path in sorted((PUBLIC / 'examples').glob('*.npz')):
+    instance = load_instance(path)
+    started = time.process_time()
+    delta, renormalization = solve(instance)
+    cpu = time.process_time() - started
+    gap_residual, z_residual = Model(instance).residual_norms(delta, renormalization)
+    reference_delta = reference(instance)
+    scale = np.maximum(np.max(np.abs(reference_delta), axis=1, keepdims=True), np.pi * float(instance['temperature']) * 1e-10)
+    distance = float(np.max(np.abs(delta - reference_delta) / scale))
+    result = dict(example=path.name, solver_cpu_seconds=cpu, gap_residual=gap_residual,
+                  z_residual=z_residual, reference_distance=distance,
+                  all_low_frequency_gaps_positive=bool(np.all(delta[:, 0] > 0)))
+    results.append(result)
+    print(json.dumps(result), flush=True)
+    np.savez(ROOT / (path.stem + '_solution.npz'), delta=delta, z=renormalization)
+with open(ROOT / 'validation.json', 'w') as stream:
+    json.dump(dict(method='Public operator residuals and independently implemented ordinary Newton refinement from public initial guesses', examples=results), stream, indent=2)
