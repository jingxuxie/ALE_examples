import numpy as np,time
from scipy.sparse.linalg import LinearOperator,eigs
from scipy.optimize import brentq
from solve import Model,CoarseModel
with np.load('stress_large_input.npz') as archive:
    instance={key:archive[key].copy() for key in archive.files}
full=Model(instance)
coarse=CoarseModel(full)
original_coupling=coarse.coupling.copy()
normal=coarse.z_normal-1
zero=np.zeros(coarse.shape)
seed=np.ones(zero.size)
started=time.process_time()
def eigenvalue(factor):
    coarse.coupling=original_coupling*factor
    coarse.z_normal=1+factor*normal
    def action(direction):
        return coarse.map(direction.reshape(coarse.shape)*1e-30)[1].ravel()*1e30
    operator=LinearOperator((zero.size,zero.size),matvec=action,dtype=np.float64)
    value=eigs(operator,k=1,which='LR',v0=seed,tol=1e-12,return_eigenvectors=False)[0].real
    print('lambda',factor,value,flush=True)
    return value
factor=brentq(lambda factor:eigenvalue(factor)-1-3e-9,.01,1,xtol=1e-14)
instance['coupling']*=factor
np.savez('stress_critical_input.npz',**instance)
print('calibration',factor,'cpu',time.process_time()-started)
