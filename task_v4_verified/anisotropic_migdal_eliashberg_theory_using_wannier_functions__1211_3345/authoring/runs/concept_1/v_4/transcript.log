+def solve(instance, verbose=False):
+    started = time.process_time()
+    model = Model(instance)
+    if model.n_freq > 512:
+        coarse = CoarseModel(model)
+        if verbose:
+            print('coarse', coarse.shape, 'build', time.process_time() - started, flush=True)
+        delta, unused = newton(coarse, instance['initial_delta'][:, coarse.indices].copy(), verbose)
+        delta = coarse.expand(delta)
+        z, mapped = model.map(delta)
+        residual_norm = np.max(np.abs(delta - mapped) / np.max(np.abs(delta), axis=1)[:, None])
+        if verbose:
+            print('fine residual', residual_norm, 'cpu', time.process_time() - started, flush=True)
+        if residual_norm > 2e-10:
+            delta, z = newton(model, delta, verbose)
+        return delta, z
