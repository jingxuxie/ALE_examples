from solve import Model
from validate import enlarge
from scipy.fft import dct,dst,idct,idst

def spectral_convolve(self,values,parity):
    if parity==1:
        transformed=dct(values,type=2,n=self.transform_length,workers=1)
        combined=np.einsum('abk,bk->ak',self.spectral[:,:,:-1],transformed,optimize=False)
        return idct(combined,type=2,workers=1)[:,:self.n_freq]
    transformed=dst(values,type=2,n=self.transform_length,workers=1)
    combined=np.einsum('abk,bk->ak',self.spectral[:,:,1:],transformed,optimize=False)
    return idst(combined,type=2,workers=1)[:,:self.n_freq]

def separate_convolve(self,values,parity):
    transform,inverse=(dct,idct) if parity==1 else (dst,idst)
    kernels=self.kernel_fft[:,:-1] if parity==1 else self.kernel_fft[:,1:]
    transformed=transform(values,type=2,n=self.transform_length,workers=1)
    result=np.zeros(self.shape)
    for matrix,kernel in zip(self.weighted_coupling,kernels):
        filtered=inverse(transformed*kernel[None,:],type=2,workers=1)[:,:self.n_freq]
        result+=matrix@filtered
    return result

