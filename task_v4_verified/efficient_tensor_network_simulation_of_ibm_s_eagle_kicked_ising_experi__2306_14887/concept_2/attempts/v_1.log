+    lower = max(0.12, 1.45 - 0.118 * (depth - 1) / 5)
+    center = random.uniform(max(lower + 0.06, 1.20), 1.40)
+    initial = np.clip(center + random.normal(0, 0.055, 6), lower + 0.001, 1.449)
