    "time_dependence": "static for the entire sequence",
    "z_drift_radians_per_layer_each_site": [-0.01,0.01],
    "z_drift_exponent": "-i * z_drift_radians_per_layer[site] * Z / 2",
    "z_drift_placement": "after every layer's RX kicks, including the final layer",
