import search
import numpy as np
for name in ['smooth_best.json','robust_best.json','polish_best.json']:
    if not (search.ROOT/name).exists():
        continue
    result=search.evaluate(search.load(name))
    print(name, search.summary(result))
    full=np.linalg.norm(result['sensitivity'],axis=1)*1000/np.sqrt(3)
    vv=np.linalg.norm(result['triple_gradient'],axis=1)*1000/np.sqrt(3)
    print('max_full_sigma_micro',float(full.max()),'max_vv_sigma_micro',float(vv.max()))
    for position in np.argsort(full)[-4:]:
        mask=search.model.TRIPLE_MASKS[position]
        sensitivity=result['sensitivity'][position]
        order=np.argsort(np.abs(sensitivity))[-6:]
        print('triple',mask,'increment_micro',result['triples'][position]*1e6,'sigma_micro',full[position], 'vv_sigma_micro',vv[position], 'dominant',list(zip(order.tolist(),sensitivity[order].tolist())))
