import json
import subprocess
import search
baseline=json.loads((search.ROOT/'finalist_summary.json').read_text())[0]['file']
selected=[baseline]+[f'pareto_{position:03d}_probability.json' for position in range(3)]
for seed in [504721,272176]:
    with (search.ROOT/f'pareto_validation_{seed}.log').open('w') as output:
        subprocess.run([search.sys.executable,'-B','validate.py',*selected,'--count','512','--seed',str(seed)],stdin=subprocess.DEVNULL,stdout=output,stderr=subprocess.STDOUT,check=True)
rows=[]
for name in selected:
    reports=[json.loads((search.ROOT/(name.removesuffix('.json')+f'_validation_{seed}_512.json')).read_text()) for seed in [504721,272176]]
    fractions={family:sum(report['families'][family]['successes'] for report in reports)/1024 for family in ['vv','full']}
    score=(1+sum(min(1,fraction/.95) for fraction in fractions.values()))/3
    rows.append(dict(file=name,fractions=fractions,score=score,nominal_passed=all(report['nominal']['passed'] for report in reports)))
rows.sort(key=lambda row:row['score'],reverse=True)
baseline_row=next(row for row in rows if row['file']==baseline)
best=rows[0]
replace=best['score']>=baseline_row['score']+.004 and best['fractions']['vv']>=.965 and best['nominal_passed']
(search.ROOT/'pareto_comparison.json').write_text(json.dumps(dict(baseline=baseline,replaced=replace,rows=rows),indent=2)+'\\n')
for row in rows:
    print(json.dumps(row),flush=True)
if replace:
    search.save(search.load(best['file']),'witness.json')
    subprocess.run([search.sys.executable,'-B','final_review.py'],stdin=subprocess.DEVNULL,check=True)
    print('Replaced final artifact with',best['file'],flush=True)
else:
    print('Retained final artifact',baseline,flush=True)
