+        derivative_elevation=np.array([-np.cos(azimuth)*np.sin(elevation),-np.sin(azimuth)*np.sin(elevation),np.cos(elevation)]).T*amplitude
+        gradient_azimuth=-2*np.sum(vectors*derivative_azimuth.T[None],axis=1)
