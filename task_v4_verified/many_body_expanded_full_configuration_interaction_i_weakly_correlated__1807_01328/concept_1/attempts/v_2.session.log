import ast,json,os,pathlib,subprocess,sys
root=pathlib.Path.cwd()
required=root.joinpath('SUBMISSION_FILES.txt').read_text().splitlines()
for name in required:
    path=root/name
    assert path.is_file(),name
    if path.suffix=='.py':
        ast.parse(path.read_text(),filename=name)
environment=dict(os.environ,PYTHONPATH='',PYTHONDONTWRITEBYTECODE='1',OPENBLAS_NUM_THREADS='1',OMP_NUM_THREADS='1')
process=subprocess.Popen([sys.executable,str(root/'solution.py')],cwd=root,env=environment,stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True)
def send(message):
    process.stdin.write(json.dumps(message)+'\\n');process.stdin.flush()
observed={mask for mask in range(256) if mask.bit_count()<=2}
remaining=160
send({'event':'start','nvirtual':8,'npairs':3,'family':'mixed','orbital_energy':[-.45,-.22,0.]+[1.2]*8,'budget':160,'costs':{'3':1,'4':4,'5':16,'6':64},'values':[[mask,0.] for mask in sorted(observed)]})
actions=0
while True:
    message=json.loads(process.stdout.readline())
    actions+=1
    if 'estimate' in message:
        assert message=={'estimate':0.0},message
        break
    masks=message['query']
    assert len(masks)==len(set(masks))
    assert all(isinstance(mask,int) and 0<=mask<256 and mask.bit_count()<=6 for mask in masks)
    remaining-=sum(4**(mask.bit_count()-3) for mask in masks if mask not in observed)
    assert remaining>=0
    observed.update(masks)
    send({'event':'result','remaining':remaining,'values':[[mask,0.] for mask in masks]})
send({'event':'accepted'});send({'event':'done'})
process.stdin.close()
assert process.wait(timeout=20)==0
assert not process.stdout.read()
report={'valid':True,'estimate':0.0,'cost':160-remaining,'actions':actions,'runtime_files':required,'runtime_bytes':sum((root/name).stat().st_size for name in required)}
(root/'smoke_report.json').write_text(json.dumps(report,indent=2))
print(json.dumps(report,indent=2))
