+
+import numpy as np
+
+from quadrature import ORDERS, SUBSET, HIGH, CANDIDATES, SELECTOR, TRIPLES, mobius
+from neural import predict as neural_predict
+from neural_policy import variance_predict
+from design import covariance, design, estimate
+
+ROOT = Path(__file__).resolve().parent
+
+
+def load_models():
+    neural_models = {}
+    variance_models = {}
+    for order in [4, 5]:
+        with np.load(ROOT / ('neural_' + str(order) + '.npz')) as archive:
+            neural_models[order] = [archive['weight' + str(index)] for index in range(len(archive.files))]
+        with np.load(ROOT / ('variance_' + str(order) + '.npz')) as archive:
+            variance_models[order] = (archive['scale'], archive['coefficient'], float(archive['multiplier']))
+    configuration = json.loads((ROOT / 'policy_config.json').read_text())
+    return neural_models, variance_models, configuration
+
+
+def send(message):
+    sys.stdout.write(json.dumps(message, separators=(',', ':'), allow_nan=False) + '\\n')
+    sys.stdout.flush()
+
+
+def receive():
+    line = sys.stdin.readline()
+    return json.loads(line) if line else {'event': 'done'}
+
+
+def request(masks, values, observed):
+    send({'query': [int(mask) for mask in masks]})
+    response = receive()
+    for mask, value in response['values']:
+        values[mask] = value
+        observed.add(mask)
+
+
+def solve(observation, neural_models, variance_models, configuration):
+    values = np.zeros(256)
+    observed = set()
+    for mask, value in observation['values']:
+        values[mask] = value
+        observed.add(mask)
+    requested = [int(mask) for mask in TRIPLES if mask not in observed]
+    if requested:
+        request(requested, values, observed)
+    orbital = np.asarray(observation['orbital_energy'], dtype=float)
+    means = np.zeros(len(HIGH))
+    weights = np.zeros(len(HIGH))
+    for order in [4, 5]:
+        predicted = neural_predict(values[None], orbital[None], neural_models[order], order)[0]
+        means[ORDERS[HIGH] == order] = predicted
+        weights[ORDERS[HIGH] == order] = variance_predict(values, predicted, order, variance_models[order])
+    parents = ORDERS[HIGH] == 5
+    for order in range(6, 9):
+        selected = ORDERS[HIGH] == order
+        raw = SUBSET[HIGH[selected]][:, HIGH[parents]] @ (weights[parents] + means[parents] ** 2)
+        weights[selected] = raw * configuration['higher_factors'][str(order)]
+    weights = np.maximum(weights, 1e-25)
+    matrix = covariance(weights, configuration['correlation'], configuration['power'])
+    chosen = design(matrix, configuration['mode'])
+    masks = CANDIDATES[chosen]
+    if len(masks):
+        request(masks, values, observed)
+    terms = mobius(values)
+    terms[ORDERS > 3] = 0
+    low = SUBSET @ terms
+    truth = np.zeros(len(CANDIDATES) + 1)
+    truth[chosen] = values[masks] - low[masks]
+    mean = SELECTOR @ means
+    if chosen:
+        correction = estimate(matrix, mean, truth, chosen)[0]
+    else:
+        correction = float(mean[-1])
+    predicted = float(low[-1] + correction)
+    if not math.isfinite(predicted):
+        predicted = float(low[-1])
+    predicted = min(predicted, min(values[mask] for mask in observed))
+    send({'estimate': predicted})
+
+
+def main():
+    models = load_models()
+    while True:
+        observation = receive()
+        event = observation.get('event')
+        if event == 'done':
+            return
+        if event == 'start':
+            solve(observation, *models)
+
+
+if __name__ == '__main__':
+    main()
