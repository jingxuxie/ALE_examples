+            mask = 0
+            for index in chosen:
+                mask |= categories[index]
+            value = self.query(source, mask)
+            allowed = list(chosen) if value else [index for index in allowed if index not in chosen]
+        mask = 0
+        for index in allowed:
+            mask |= categories[index]
+        return mask, allowed
