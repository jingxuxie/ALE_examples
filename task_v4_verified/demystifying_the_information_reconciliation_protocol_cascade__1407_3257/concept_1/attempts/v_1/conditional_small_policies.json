{
  "first1_paper": {
    "version": 1,
    "max_passes": 20,
    "schedule": [
      {
        "size": {
          "basis": "estimate",
          "scale": 1,
          "round": "nearest"
        },
        "reuse": "all",
        "batch": "smallest",
        "stop": false
      },
      {
        "size": {
          "basis": "paper_second",
          "scale": 1,
          "round": "nearest"
        },
        "reuse": "all",
        "batch": "smallest",
        "stop": false
      },
      {
        "size": {
          "basis": "frame",
          "scale": 0.5,
          "round": "nearest"
        },
        "reuse": "all",
        "batch": "smallest",
        "stop": false
      },
      {
        "size": {
          "basis": "frame",
          "scale": 0.5,
          "round": "nearest"
        },
        "reuse": "all",
        "batch": "smallest",
        "stop": false
      }
    ],
    "rules": [
      {
        "when": [
          [
            "pass_index",
            "ge",
            3
          ],
          [
            "quiet_passes",
            "ge",
            6
          ],
          [
            "corrected_fraction",
            "gt",
            0
          ]
        ],
        "action": {
          "stop": true
        }
      },
      {
        "when": [
          [
            "pass_index",
            "ge",
            3
          ],
          [
            "quiet_passes",
            "ge",
            14
          ]
        ],
        "action": {
          "stop": true
        }
      }
    ]
  },
