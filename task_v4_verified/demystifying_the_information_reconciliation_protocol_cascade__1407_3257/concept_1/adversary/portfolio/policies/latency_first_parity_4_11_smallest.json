{
  "version": 1,
  "max_passes": 11,
  "schedule": [
    {
      "size": {
        "basis": "paper_first",
        "scale": 1,
        "round": "nearest"
      },
      "reuse": "all",
      "batch": "smallest",
      "stop": false
    },
    {
      "size": {
        "basis": "parity",
        "scale": 4,
        "round": "nearest"
      },
      "reuse": "all",
      "batch": "smallest",
      "stop": false
    },
    {
      "size": {
        "basis": "frame",
        "scale": 0.25,
        "round": "nearest"
      },
      "reuse": "all",
      "batch": "smallest",
      "stop": false
    },
    {
      "size": {
        "basis": "frame",
        "scale": 0.5,
        "round": "nearest"
      },
      "reuse": "all",
      "batch": "smallest",
      "stop": false
    }
  ],
  "rules": [
    {
      "when": [
        [
          "pass_index",
          "lt",
          1
        ],
        [
          "latency",
          "ge",
          0.004
        ]
      ],
      "action": {
        "size": {
          "basis": "paper_first",
          "scale": 0.5,
          "round": "nearest"
        }
      }
    }
  ]
}
