+    for (int check : checks[position]) {
+        energy += parity[check] ? -1 : 1;
+        parity[check] ''^= 1;
+    }
+}
+
+int gain(int position) {
+    int value = 0;
+    for (int check : checks[position]) value += weights[check] * (2 * parity[check] - 1);
+    return value;
+}
+
+void save(const std::string& path, int seed, int best) {
