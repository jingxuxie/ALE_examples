+            ++total;
+            if (energy < best) {
+                best = energy;
+                std::cout << "best " << best << " weight " << weight << " restart " << restart << " iteration " << iteration << " total " << total << " seconds " << elapsed << std::endl;
+                save(path, seed, best);
+                if (best == 0) return 0;
+            }
+            if (energy < local_best) {
+                local_best = energy;
+                stagnant = 0;
+            } else ++stagnant;
