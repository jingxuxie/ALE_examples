+            int block;
+            input >> block;
+            int check = pass * 64 + block;
+            checks[position][pass] = check;
+            neighbors[check][counts[check]++] = position;
+        }
+    }
+    auto started = std::chrono::steady_clock::now();
+    int best = 384;
