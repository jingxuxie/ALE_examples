+}
+
+struct OrbitalPair {
+    double score;
+    int first, second;
+    bool operator<(const OrbitalPair& other) const { return score > other.score; }
+};
+
+extern "C" double joint_polish(int dimension, int rank, double* one_body, double* factors, double* orbital, double* auxiliary, int sweeps, double seconds) {
+    auto deadline = std::chrono::steady_clock::now() + std::chrono::duration<double>(seconds);
+    int entries = dimension * dimension;
+    std::vector<double> temporary_body(entries), rotated_factors(rank * entries), temporary_factors(rank * entries), temporary_auxiliary(rank * rank);
+    for (int sweep = 0; sweep < sweeps; ++sweep) {
+        double previous = total_cost(dimension, rank, one_body, factors);
+        std::vector<OrbitalPair> pairs;
+        std::vector<double> row_weights(dimension, 0.0);
+        for (int row = 0; row < dimension; ++row) {
+            for (int factor = 0; factor < rank; ++factor) {
+                for (int column = 0; column < dimension; ++column) {
+                    double value = factors[factor * entries + row * dimension + column];
+                    row_weights[row] += value * value;
+                }
+            }
+        }
+        for (int first = 0; first < dimension; ++first) {
+            for (int second = first + 1; second < dimension; ++second) {
+                double score = 0.0;
+                for (int factor = 0; factor < rank; ++factor) {
+                    double value = factors[factor * entries + first * dimension + second];
+                    score += value * value;
+                }
+                score /= 1e-15 + std::sqrt(row_weights[first] * row_weights[second]);
+                if (score > 1e-7) pairs.push_back({score, first, second});
+            }
+        }
+        std::sort(pairs.begin(), pairs.end());
+        if (pairs.size() > static_cast<size_t>(2 * dimension)) pairs.resize(2 * dimension);
+        for (const OrbitalPair& pair : pairs) {
+            if (std::chrono::steady_clock::now() >= deadline) return total_cost(dimension, rank, one_body, factors);
+            std::vector<std::pair<double, int>> active;
+            for (int factor = 0; factor < rank; ++factor) {
+                double weight = 0.0;
+                for (int column = 0; column < dimension; ++column) {
+                    double first_value = factors[factor * entries + pair.first * dimension + column];
+                    double second_value = factors[factor * entries + pair.second * dimension + column];
+                    weight += first_value * first_value + second_value * second_value;
+                }
+                active.emplace_back(-weight, factor);
+            }
+            std::sort(active.begin(), active.end());
+            int active_count = std::min(rank, 4);
+            double original = total_cost(dimension, rank, one_body, factors), best = original;
+            double best_angle = 0.0, best_auxiliary_angle = 0.0;
+            int best_first = -1, best_second = -1;
+            auto evaluate = [&](double angle, int restricted_first, int restricted_second) {
+                std::copy(one_body, one_body + entries, temporary_body.begin());
+                std::copy(factors, factors + rank * entries, rotated_factors.begin());
+                apply_orbital(dimension, rank, temporary_body.data(), rotated_factors.data(), nullptr, pair.first, pair.second, angle);
+                double unoptimized = total_cost(dimension, rank, temporary_body.data(), rotated_factors.data());
+                double trial_best = unoptimized;
+                for (int first_index = 0; first_index < active_count; ++first_index) {
+                    for (int second_index = first_index + 1; second_index < active_count; ++second_index) {
+                        int first = active[first_index].second, second = active[second_index].second;
+                        if (restricted_first >= 0 && (first != restricted_first || second != restricted_second)) continue;
+                        std::copy(rotated_factors.begin(), rotated_factors.end(), temporary_factors.begin());
+                        std::fill(temporary_auxiliary.begin(), temporary_auxiliary.end(), 0.0);
+                        for (int factor = 0; factor < rank; ++factor) temporary_auxiliary[factor * rank + factor] = 1.0;
+                        double improvement = auxiliary_pair(dimension, rank, temporary_factors.data(), temporary_auxiliary.data(), first, second);
+                        double value = unoptimized - improvement;
+                        trial_best = std::min(trial_best, value);
+                        if (value < best) {
+                            best = value; best_angle = angle; best_first = first; best_second = second;
+                            best_auxiliary_angle = std::atan2(temporary_auxiliary[first * rank + second], temporary_auxiliary[first * rank + first]);
+                        }
+                    }
+                }
+                return trial_best;
+            };
+            for (int sample = 0; sample <= 32; ++sample) {
+                if (std::chrono::steady_clock::now() >= deadline) break;
+                evaluate(-pi / 4 + sample * pi / 64, -1, -1);
+            }
+            if (best_first >= 0 && best < original - 1e-9 * std::max(original, 1.0)) {
+                double lower = std::max(-pi / 4, best_angle - pi / 64);
+                double upper = std::min(pi / 4, best_angle + pi / 64);
+                int selected_first = best_first, selected_second = best_second;
+                double left = upper - .6180339887498949 * (upper - lower);
+                double right = lower + .6180339887498949 * (upper - lower);
+                double left_value = evaluate(left, selected_first, selected_second);
+                double right_value = evaluate(right, selected_first, selected_second);
+                for (int iteration = 0; iteration < 35; ++iteration) {
+                    if (std::chrono::steady_clock::now() >= deadline) break;
+                    if (left_value < right_value) {
+                        upper = right; right = left; right_value = left_value;
+                        left = upper - .6180339887498949 * (upper - lower); left_value = evaluate(left, selected_first, selected_second);
+                    } else {
+                        lower = left; left = right; left_value = right_value;
+                        right = lower + .6180339887498949 * (upper - lower); right_value = evaluate(right, selected_first, selected_second);
+                    }
+                }
+                apply_orbital(dimension, rank, one_body, factors, orbital, pair.first, pair.second, best_angle);
+                double cosine = std::cos(best_auxiliary_angle), sine = std::sin(best_auxiliary_angle);
+                for (int entry = 0; entry < entries; ++entry) {
+                    double first_value = factors[best_first * entries + entry], second_value = factors[best_second * entries + entry];
+                    factors[best_first * entries + entry] = cosine * first_value + sine * second_value;
+                    factors[best_second * entries + entry] = -sine * first_value + cosine * second_value;
+                }
+                for (int entry = 0; entry < rank; ++entry) {
+                    double first_value = auxiliary[best_first * rank + entry], second_value = auxiliary[best_second * rank + entry];
+                    auxiliary[best_first * rank + entry] = cosine * first_value + sine * second_value;
+                    auxiliary[best_second * rank + entry] = -sine * first_value + cosine * second_value;
+                }
+            }
+        }
+        double current = total_cost(dimension, rank, one_body, factors);
+        if (previous - current < 1e-8 * std::max(previous, 1.0)) return current;
+    }
+    return total_cost(dimension, rank, one_body, factors);
+}
