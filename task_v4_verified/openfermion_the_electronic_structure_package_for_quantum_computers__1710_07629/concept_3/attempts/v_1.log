_,orbitals=np.linalg.eigh(-hopping+np.diag(potential+(interaction-np.mean(interaction))*.5))
up=half; down=half-1
normal_up=trial(sites,up,orbitals); normal_down=trial(sites,down,orbitals)
rotated=orbitals.copy(); rotated[:,[down-1,down]]=rotated[:,[down,down-1]]
extra_down=trial(sites,down,rotated)
for mixture in [.01,.1,.3,1.0]:
