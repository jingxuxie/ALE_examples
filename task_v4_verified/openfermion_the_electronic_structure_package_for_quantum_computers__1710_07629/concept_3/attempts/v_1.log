    energy=LIBRARY.ground_energy(sites,up,down,pointer(hopping),pointer(interaction),pointer(potential),pointer(normal_up),pointer(initial_down),160,1e-7,pointer(history))
    print('mixture',mixture,'energy',energy,'steps',np.flatnonzero(np.isfinite(history))[-1]+1,flush=True)
