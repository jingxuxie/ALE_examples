+class Likelihood:
+    def __init__(self, experiments, counts):
+        self.model = Model(experiments)
+        self.counts = np.array(counts, dtype=float)
+        self.shots = self.counts.sum(axis=1)[:, None]
+        self.frequencies = self.counts / self.shots
+        self.last = None
