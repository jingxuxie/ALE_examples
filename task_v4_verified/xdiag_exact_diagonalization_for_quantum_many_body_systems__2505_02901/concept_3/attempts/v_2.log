+    results = []
+    for repeat in range(args.repeat):
+        for index, example in enumerate(examples):
+            result = trial(example["parameters"], config, args.seed + repeat * 1000 + index, args.verbose)
+            result["family"] = example["family"]
+            results.append(result)
+            print(example["family"], repeat, index, "rmse", round(result["rmse"], 5), "cpu", round(result["cpu"], 2),
+                  "errors", result["error"], flush=True)
+            Path(args.output).write_text(json.dumps(results))
+    print("mean", np.mean([result["rmse"] for result in results]), flush=True)
+
