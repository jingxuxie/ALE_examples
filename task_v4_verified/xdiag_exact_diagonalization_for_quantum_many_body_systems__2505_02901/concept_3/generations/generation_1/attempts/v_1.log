@@ -0,0 +1,58 @@
+import os
+for name in ('OPENBLAS_NUM_THREADS', 'OMP_NUM_THREADS', 'MKL_NUM_THREADS'):
+    os.environ[name] = '1'
+import json
+import sys
+import time
+import numpy as np
+from solve import Model, LOWER, SCALE, fit_data, experiment, information
+
+ASSETS = '/srv/home/xuandong/mnt/jingxu/ALE/tasks_v4/xdiag_exact_diagonalization_for_quantum_many_body_systems__2505_02901/concept_3/generations/generation_1/participant'
+
+def truths(number=30, seed=42):
+    random = np.random.default_rng(seed)
+    examples = json.load(open(ASSETS + '/input/development.json'))
+    values = [(np.array(item['parameters']) - LOWER) / SCALE for item in examples]
+    for index in range(number - 3):
+        params = random.uniform(0, 1, 20)
+        if index % 3 == 1:
+            params[:6] *= .4
+        elif index % 3 == 2:
+            params[:6] *= .65
+            params[12:14] = random.uniform(.65, 1, 2)
+        values.append(params)
+    return values[:number]
+
+def fixed_settings(duration=2.5):
+    random = np.random.default_rng(1231)
+    return [experiment(prep, duration + .4 * index, random.uniform(-2, 2, 6))
+            for index, prep in enumerate([21, 25, 11])]
+
+def test_fixed(number=12, duration=2.5, starts=20):
+    settings = fixed_settings(duration)
+    model = Model(settings)
+    random = np.random.default_rng(432)
+    errors = []
+    for index, truth in enumerate(truths(number)):
+        began = time.process_time()
+        probability, gradient = model.evaluate(truth)
+        fisher = information(probability, gradient).sum(axis=0) * 12288
+        bound = np.sqrt(np.trace(np.linalg.inv(fisher)) / 20)
+        counts = [random.multinomial(12288, row / row.sum()) for row in probability]
+        best = (None, np.inf, None)
+        costs = []
+        for attempt in range(starts):
+            initial = random.uniform(.1, .9, 20) if attempt else np.full(20, .5)
+            initial[14:] = .5
+            result = fit_data(settings, counts, initial, max_nfev=120)
+            costs.append(result[1])
+            if result[1] < best[1]:
+                best = result
+        error = np.sqrt(np.mean((best[0] - truth) ** 2))
+        oracle = fit_data(settings, counts, truth, max_nfev=120)
+        errors.append(error)
+        print(index, 'err', round(error, 4), 'crb', round(bound, 4), 'cost', round(best[1], 2), 'oracle', round(oracle[1], 2), 'hits', sum(value < best[1] + .1 for value in costs), 'cpu', round(time.process_time() - began, 2), flush=True)
+    print('MEAN', np.mean(errors), 'REGIMES', [np.mean(errors[offset::3]) for offset in range(3)], flush=True)
+
+if __name__ == '__main__':
+    test_fixed(int(sys.argv[1]) if len(sys.argv)>1 else 12, float(sys.argv[2]) if len(sys.argv)>2 else 2.5, int(sys.argv[3]) if len(sys.argv)>3 else 20)

