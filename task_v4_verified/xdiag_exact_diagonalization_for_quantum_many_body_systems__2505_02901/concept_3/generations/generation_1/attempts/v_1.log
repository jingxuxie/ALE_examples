+        costs = []
+        for attempt in range(starts):
+            initial = random.uniform(.1, .9, 20) if attempt else np.full(20, .5)
+            initial[14:] = .5
+            result = fit_data(settings, counts, initial, max_nfev=120)
+            costs.append(result[1])
