+    for index in range(number - 3):
+        params = random.uniform(0, 1, 20)
+        if index % 3 == 1:
+            params[:6] *= .4
+        elif index % 3 == 2:
+            params[:6] *= .65
+            params[12:14] = random.uniform(.65, 1, 2)
+        values.append(params)
+    return values[:number]
+
+def fixed_settings(duration=2.5):
+    random = np.random.default_rng(1231)
+    return [experiment(prep, duration + .4 * index, random.uniform(-2, 2, 6))
