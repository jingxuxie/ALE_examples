+                                if best_second is None or score < best_second[0]:
+                                    best_second = (score, route_index, chosen, usage)
+                            continue
+                        score = float(prices[np.arange(len(chosen)), chosen].sum()) + sensor_price[second]
+                        if best_second is None or score < best_second[0]:
+                            best_second = (score, route_index, chosen, usage)
