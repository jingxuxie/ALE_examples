+
+    def output(self, policy):
+        tree = policy[4]
+        if isinstance(tree, (int, np.integer)):
+            return {'case_id': self.case_id, 'root': 'open', 'action': self.action_ids[tree]}
+        return {'case_id': self.case_id, 'root': 'probe', 'branches': [
