+    result = linprog(objective, A_ub=matrix, b_ub=upper, A_eq=equality, b_eq=np.ones(len(leaves)),
+                     bounds=(0, None), method='highs', options={'time_limit': max(.01, min(2, deadline-time.monotonic()))})
+    if not result.success:
