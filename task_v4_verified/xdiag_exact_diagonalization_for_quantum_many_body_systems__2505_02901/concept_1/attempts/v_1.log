+def load(directory):
+    directory = Path(directory)
+    manifest = json.loads((directory / 'manifest.json').read_text())
+    sensor_ids = list(manifest['sensor_usage_caps'])
+    action_ids = list(manifest['action_usage_caps'])
+    cases = []
+    for entry in manifest['cases']:
