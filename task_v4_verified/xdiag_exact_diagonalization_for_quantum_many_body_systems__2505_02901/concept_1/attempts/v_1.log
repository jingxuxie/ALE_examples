@@ -0,0 +1,71 @@
+import json
+import sys
+import time
+from pathlib import Path
+
+import numpy as np
+
+import solve
+
+
+def check(manifest, cases, policy):
+    assert policy['fleet_id'] == manifest['fleet_id']
+    shared_sensors = policy['shared_sensors']
+    shared_actions = policy['shared_actions']
+    assert len(shared_sensors) == len(set(shared_sensors)) <= manifest['shared_sensor_count']
+    assert len(shared_actions) == len(set(shared_actions)) <= manifest['shared_action_count']
+    sensors = dict.fromkeys(manifest['sensor_usage_caps'], 0)
+    actions = dict.fromkeys(manifest['action_usage_caps'], 0)
+    losses = []
+    assert len(policy['cases']) == len(cases)
+    for case, entry in zip(cases, policy['cases']):
+        config = case.config
+        assert entry['case_id'] == case.case_id
+        action_map = {entry['action_id']: entry for entry in config['actions']}
+        sensor_map = {entry['sensor_id']: entry for entry in config['sensors']}
+        test = config['calibration_test']
+        if entry['root'] == 'open':
+            action = entry['action']
+            assert action in shared_actions
+            assert action_map[action]['cost'] <= config['total_budget']
+            actions[action] += 1
+            loss = case.open[:, case.action_ids.index(action)].copy()
+        else:
+            assert entry['root'] == 'probe'
+            assert len(entry['branches']) == len(test['results'])
+            loss = np.zeros(case.scenario_count)
+            for result_index, (result, branch) in enumerate(zip(test['results'], entry['branches'])):
+                first = branch['first_sensor']
+                assert first in shared_sensors and first in test['allowed_first_sensor_ids'][result]
+                sensors[first] += 1
+                assert len(branch['seconds']) == sensor_map[first]['order']
+                first_index = case.sensor_ids.index(first)
+                for sector, second_entry in enumerate(branch['seconds']):
+                    second = second_entry['second_sensor']
+                    assert second in shared_sensors and second in test['allowed_second_sensor_ids_by_sector'][first][sector]
+                    sensors[second] += 1
+                    assert len(second_entry['actions']) == sensor_map[second]['order']
+                    route_index = next(index for index in case.route_by_first[first_index][sector]
+                                       if case.sensor_ids[case.routes[index][1]] == second)
+                    for outcome, action in enumerate(second_entry['actions']):
+                        assert action in shared_actions
+                        assert test['cost'] + sensor_map[first]['cost'] + sensor_map[second]['cost'] + action_map[action]['cost'] <= config['total_budget']
+                        actions[action] += 1
+                        loss += case.routes[route_index][2][result_index, :, outcome, case.action_ids.index(action)]
+        losses.append(float(np.max(loss)))
+    assert all(count <= manifest['sensor_usage_caps'][name] for name, count in sensors.items()), sensors
+    assert all(count <= manifest['action_usage_caps'][name] for name, count in actions.items()), actions
+    return max(losses), losses, sensors, actions
+
+
+if __name__ == '__main__':
+    input_directory = sys.argv[1]
+    start = time.monotonic()
+    manifest, cases = solve.load(input_directory)
+    if len(sys.argv) > 2 and sys.argv[2].endswith('.json'):
+        policy = json.loads(Path(sys.argv[2]).read_text())
+    else:
+        seconds = float(sys.argv[2]) if len(sys.argv) > 2 else 15
+        policy = solve.solve(manifest, cases, start + seconds)
+    print('time', time.monotonic() - start, 'result', check(manifest, cases, policy), flush=True)
+    print('designs', policy['shared_sensors'], policy['shared_actions'], flush=True)

