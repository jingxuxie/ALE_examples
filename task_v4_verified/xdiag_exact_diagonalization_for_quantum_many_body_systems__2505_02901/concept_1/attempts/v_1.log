+import json
+import sys
+import time
+from pathlib import Path
+
+import numpy as np
+
+import solve
+
+
+def check(manifest, cases, policy):
+    assert policy['fleet_id'] == manifest['fleet_id']
+    shared_sensors = policy['shared_sensors']
+    shared_actions = policy['shared_actions']
+    assert len(shared_sensors) == len(set(shared_sensors)) <= manifest['shared_sensor_count']
+    assert len(shared_actions) == len(set(shared_actions)) <= manifest['shared_action_count']
+    sensors = dict.fromkeys(manifest['sensor_usage_caps'], 0)
+    actions = dict.fromkeys(manifest['action_usage_caps'], 0)
+    losses = []
+    assert len(policy['cases']) == len(cases)
+    for case, entry in zip(cases, policy['cases']):
+        config = case.config
+        assert entry['case_id'] == case.case_id
+        action_map = {entry['action_id']: entry for entry in config['actions']}
+        sensor_map = {entry['sensor_id']: entry for entry in config['sensors']}
+        test = config['calibration_test']
+        if entry['root'] == 'open':
+            action = entry['action']
+            assert action in shared_actions
+            assert action_map[action]['cost'] <= config['total_budget']
+            actions[action] += 1
+            loss = case.open[:, case.action_ids.index(action)].copy()
+        else:
+            assert entry['root'] == 'probe'
+            assert len(entry['branches']) == len(test['results'])
+            loss = np.zeros(case.scenario_count)
+            for result_index, (result, branch) in enumerate(zip(test['results'], entry['branches'])):
+                first = branch['first_sensor']
+                assert first in shared_sensors and first in test['allowed_first_sensor_ids'][result]
+                sensors[first] += 1
+                assert len(branch['seconds']) == sensor_map[first]['order']
+                first_index = case.sensor_ids.index(first)
