+    selected_sensors = policy['shared_sensors']
+    selected_actions = policy['shared_actions']
+    assert len(set(selected_sensors)) == len(selected_sensors) <= manifest['shared_sensor_count']
+    assert len(set(selected_actions)) == len(selected_actions) <= manifest['shared_action_count']
