@@ -0,0 +1,52 @@
+import collections
+
+from fleet import objective
+
+
+def validate(manifest, cases, policy):
+    assert set(policy) == {'fleet_id', 'shared_sensors', 'shared_actions', 'cases'}
+    assert policy['fleet_id'] == manifest['fleet_id']
+    selected_sensors = policy['shared_sensors']
+    selected_actions = policy['shared_actions']
+    assert len(set(selected_sensors)) == len(selected_sensors) <= manifest['shared_sensor_count']
+    assert len(set(selected_actions)) == len(selected_actions) <= manifest['shared_action_count']
+    assert set(selected_sensors) <= set(manifest['sensor_usage_caps'])
+    assert set(selected_actions) <= set(manifest['action_usage_caps'])
+    assert len(policy['cases']) == len(cases) == len(manifest['cases'])
+    sensor_counts, action_counts = collections.Counter(), collections.Counter()
+    for entry, data, tree in zip(manifest['cases'], cases, policy['cases']):
+        config = data['configuration']
+        assert tree['case_id'] == entry['case_id']
+        actions = {action['action_id']: action for action in config['actions']}
+        sensors = {sensor['sensor_id']: sensor for sensor in config['sensors']}
+        if tree['root'] == 'open':
+            assert set(tree) == {'case_id', 'root', 'action'}
+            assert tree['action'] in selected_actions
+            assert actions[tree['action']]['cost'] <= config['total_budget']
+            action_counts[tree['action']] += 1
+            continue
+        assert tree['root'] == 'probe'
+        assert set(tree) == {'case_id', 'root', 'branches'}
+        test = config['calibration_test']
+        assert len(tree['branches']) == len(test['results'])
+        for result, branch in zip(test['results'], tree['branches']):
+            assert set(branch) == {'first_sensor', 'seconds'}
+            first = branch['first_sensor']
+            assert first in selected_sensors and first in test['allowed_first_sensor_ids'][result]
+            sensor_counts[first] += 1
+            assert len(branch['seconds']) == sensors[first]['order']
+            for sector, second_branch in enumerate(branch['seconds']):
+                assert set(second_branch) == {'second_sensor', 'actions'}
+                second = second_branch['second_sensor']
+                assert second in selected_sensors
+                assert second in test['allowed_second_sensor_ids_by_sector'][first][sector]
+                sensor_counts[second] += 1
+                assert len(second_branch['actions']) == sensors[second]['order']
+                for action in second_branch['actions']:
+                    assert action in selected_actions
+                    cost = test['cost'] + sensors[first]['cost'] + sensors[second]['cost'] + actions[action]['cost']
+                    assert cost <= config['total_budget']
+                    action_counts[action] += 1
+    assert all(count <= manifest['sensor_usage_caps'][name] for name, count in sensor_counts.items())
+    assert all(count <= manifest['action_usage_caps'][name] for name, count in action_counts.items())
+    return objective(cases, policy['cases'])
