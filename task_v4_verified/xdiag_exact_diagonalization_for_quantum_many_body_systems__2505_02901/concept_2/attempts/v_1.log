+import argparse
+import json
+import time
+from pathlib import Path
+
+import numpy as np
+from scipy.linalg import eigh
+from scipy.optimize import minimize
+
+
+class Compiler:
+    def __init__(self, directory, members=None, objective='real'):
+        directory = Path(directory)
+        self.spec = json.loads((directory / 'spec.json').read_text())
+        with np.load(directory / 'hamiltonians.npz') as archive:
+            self.drifts = archive['drifts']
+            self.controls = archive['controls']
+            self.initial = archive['initial']
+        with np.load(directory / 'targets.npz') as archive:
+            self.targets = archive['targets']
+        if members is not None:
+            self.drifts = self.drifts[members]
+            self.targets = self.targets[members]
+        self.duration = self.spec['slice_duration']
+        self.limits = np.asarray(self.spec['amplitude_limits'])
+        self.objective = objective
+        self.calls = 0
+        self.start = time.monotonic()
+        self.best = 2.0
+
+    def evaluate(self, flat):
+        pulse = flat.reshape(-1, 3)
+        gradient = np.zeros_like(pulse)
+        loss = 0.0
+        overlaps = []
+        for drift, target in zip(self.drifts, self.targets):
+            states = self.initial.copy()
+            records = []
+            for amplitudes in pulse:
+                hamiltonian = drift + np.einsum('c,cij->ij', amplitudes, self.controls)
+                energies, vectors = eigh(hamiltonian, check_finite=False, driver='evd')
+                phases = np.exp(-1j * self.duration * energies)
+                rotated = vectors.conj().T @ states
+                records.append((energies, vectors, phases, rotated))
+                states = vectors @ (phases[:, None] * rotated)
+            overlap = np.vdot(target, states) / self.initial.shape[1]
+            overlaps.append(overlap)
+            if self.objective == 'real':
+                loss += 1.0 - overlap.real
+                backward = target.copy()
+            else:
+                loss += 1.0 - abs(overlap)
+                backward = target * np.exp(1j * np.angle(overlap))
+            for step in range(len(pulse) - 1, -1, -1):
+                energies, vectors, phases, rotated = records[step]
+                backward_rotated = vectors.conj().T @ backward
+                midpoint = (energies[:, None] + energies[None, :]) * (self.duration / 2)
+                difference = (energies[:, None] - energies[None, :]) * (self.duration / (2 * np.pi))
+                frechet = -1j * self.duration * np.exp(-1j * midpoint) * np.sinc(difference)
+                sensitivity = (backward_rotated.conj() @ rotated.T) * frechet
+                for channel, control in enumerate(self.controls):
+                    rotated_control = vectors.conj().T @ control @ vectors
+                    gradient[step, channel] -= np.sum(sensitivity * rotated_control).real / self.initial.shape[1]
+                backward = vectors @ (phases.conj()[:, None] * backward_rotated)
+        loss /= len(self.drifts)
+        gradient /= len(self.drifts)
+        self.calls += 1
+        self.last_overlaps = overlaps
+        self.last_loss = loss
+        return loss, gradient.ravel()
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--input', required=True)
+    parser.add_argument('--output', required=True)
+    parser.add_argument('--seed', type=int, default=0)
+    parser.add_argument('--members', default='1')
+    parser.add_argument('--objective', default='real')
+    parser.add_argument('--maxiter', type=int, default=1000)
+    parser.add_argument('--start')
+    parser.add_argument('--scale', type=float, default=0.3)
+    parser.add_argument('--test', action='store_true')
+    arguments = parser.parse_args()
+    members = [int(value) for value in arguments.members.split(',')]
+    compiler = Compiler(arguments.input, members, arguments.objective)
+    generator = np.random.default_rng(arguments.seed)
+    if arguments.start:
+        pulse = np.asarray(json.loads(Path(arguments.start).read_text())['amplitudes'])
+    elif arguments.seed == 0:
+        pulse = np.zeros((24, 3))
+    else:
+        coarse = generator.normal(size=(6, 3))
+        pulse = np.column_stack([np.interp(np.linspace(0, 5, 24), np.arange(6), coarse[:, channel]) for channel in range(3)])
+        pulse *= compiler.limits * arguments.scale
+    if arguments.test:
+        pulse = generator.normal(size=(24, 3)) * 0.2
+        start = time.monotonic()
+        value, gradient = compiler.evaluate(pulse.ravel())
+        print('evaluation', time.monotonic() - start, value, flush=True)
+        direction = generator.normal(size=72)
+        delta = 1e-5
+        plus = compiler.evaluate(pulse.ravel() + delta * direction)[0]
+        minus = compiler.evaluate(pulse.ravel() - delta * direction)[0]
+        print('gradient', (plus - minus) / (2 * delta), gradient @ direction, flush=True)
+        return
+    output = Path(arguments.output)
+    iteration = [0]
+    def callback(flat):
+        iteration[0] += 1
+        if iteration[0] % 20 == 0:
+            payload = {'schema_version': 1, 'amplitudes': flat.reshape(24, 3).tolist()}
+            output.write_text(json.dumps(payload) + '\\n')
+            print('progress', arguments.seed, iteration[0], compiler.calls, compiler.last_loss,
+                  [round(abs(value) ** 2, 8) for value in compiler.last_overlaps],
+                  round(time.monotonic() - compiler.start, 2), flush=True)
+    bounds = [(-limit, limit) for step in range(24) for limit in compiler.limits]
+    result = minimize(compiler.evaluate, pulse.ravel(), method='L-BFGS-B', jac=True, bounds=bounds,
+                      callback=callback, options={'maxiter': arguments.maxiter, 'ftol': 1e-14, 'gtol': 1e-9, 'maxls': 30, 'maxcor': 30})
+    output.write_text(json.dumps({'schema_version': 1, 'amplitudes': result.x.reshape(24, 3).tolist()}) + '\\n')
+    print('finished', arguments.seed, result.fun, result.message, compiler.calls,
+          time.monotonic() - compiler.start, flush=True)
+
