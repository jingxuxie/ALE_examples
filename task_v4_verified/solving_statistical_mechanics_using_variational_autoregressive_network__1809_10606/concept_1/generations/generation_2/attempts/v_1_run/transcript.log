+               'ess': float(np.exp(-logsumexp(2 * log_target - log_model)))}
+    print('global', metrics, 'elapsed', time.monotonic() - started, flush=True)
+    return {'mixing': [0.125] * 8, 'weights': weights.tolist(), 'biases': biases.tolist(), 'orders': orders}
+
+
