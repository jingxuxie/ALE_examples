+        probabilities = []
+        log_mixing = self.initial_mixing + vector[-self.components:]
+        log_mixing -= logsumexp(log_mixing)
+        mixing = np.exp(log_mixing)
+        for order, component in zip(self.orders, parameters):
+            joint = np.zeros(1)
+            predicted = []
+            for design, values in zip(self.design, component):
+                logits = design @ values
+                predicted.append(expit(logits))
+                joint = np.concatenate((joint - np.logaddexp(0, logits), joint - np.logaddexp(0, -logits)))
