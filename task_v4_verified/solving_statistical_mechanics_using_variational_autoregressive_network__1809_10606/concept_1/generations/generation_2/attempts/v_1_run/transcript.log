+def solve(instance, regularization=0.001, trials=8):
+    started = time.monotonic()
+    count = instance['n']
+    couplings = np.asarray(instance['couplings'])
+    fields = np.asarray(instance['fields'])
+    blocks = regions(couplings)
+    spins = configurations(count)
+    log_target = 0.5 * np.sum((spins @ couplings) * spins, axis=1) + spins @ fields
+    log_target -= logsumexp(log_target)
+    target = np.exp(log_target)
+    rng = np.random.default_rng(3818)
+    fits = []
+    ids = []
+    for block in blocks:
+        index = ((spins[:, block] > 0).astype(np.int32) @ (1 << np.arange(len(block))))
+        ids.append(index)
+        marginal = np.bincount(index, weights=target, minlength=1 << len(block))
+        log_local = np.log(marginal)
+        candidates = []
+        for trial in range(trials):
+            orders = [rng.permutation(len(block)), rng.permutation(len(block))]
+            fit = LocalMixture(log_local, orders)
+            metrics = fit.fit(1000, regularization=regularization)
+            score = fit.evaluate(fit.parameters, regularization=regularization)[0]
+            candidates.append((score, fit))
+        best = min(candidates, key=lambda pair: pair[0])[1]
+        weights, biases = best.artifact()
+        local_spins = configurations(len(block))
+        component_logs = np.asarray([-np.logaddexp(0, -local_spins * (local_spins @ matrix.T + bias)).sum(axis=1)
+                                     for matrix, bias in zip(weights, biases)])
+        variance = np.sum(np.exp(log_local) * np.tanh(0.5 * (component_logs[0] - component_logs[1])) ** 2)
+        print('local', block, best.last, 'variance', variance, 'elapsed', time.monotonic() - started, flush=True)
+        fits.append((best, weights, biases, component_logs, variance))
+    block_count = len(blocks)
+    codes = [1, 2, 4] if block_count == 3 else ([1, 2, 4, 7] if block_count == 4 else [1, 2, 4, 3, 5])
+    local_choices = np.asarray([[(component & code).bit_count() % 2 for code in codes] for component in range(8)])
+    weights = np.zeros((8, count, count))
+    biases = np.zeros((8, count))
+    orders = []
+    log_model = np.full(1 << count, -np.inf)
+    for component in range(8):
+        order = []
+        joint = np.zeros(1 << count)
+        for block_index, block in enumerate(blocks):
+            choice = local_choices[component, block_index]
+            fit, local_weights, local_biases, component_logs, variance = fits[block_index]
+            weights[component][np.ix_(block, block)] = local_weights[choice]
+            biases[component, block] = local_biases[choice]
+            order.extend(np.asarray(block)[fit.orders[choice]].tolist())
+            joint += component_logs[choice, ids[block_index]]
+        orders.append(order)
