+                      constraints={'type': 'ineq', 'fun': lambda split: LIMIT - 2e-12 - split.sum(),
+                                   'jac': lambda split: -np.ones(2 * count)},
+                      options={'maxiter': 120, 'ftol': 1e-10})
+    return result.x[:count] - result.x[count:], float(result.fun - entropy)
