+             '| Metric | Measured | Requirement |', '|---|---:|---:|']
+    for key, (threshold, lower) in GATES.items():
+        lines.append(f'| {key} | {report[key]:.12g} | {\">=\" if lower else \"<=\"} {threshold:g} |')
+    lines += ['', f'Core score: {report[\"core_score\"]:.12g}.', '',
