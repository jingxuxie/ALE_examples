+                self.history[step, 3] = second_phase
+            state = self.kinetic(state * second_phase)
+        overlap = self.volume * np.sum(self.target.conj() * state, axis=(1, 2, 3))
+        losses = 1 - np.abs(overlap) ** 2
+        weights = np.full(len(losses), 1 / len(losses))
+        loss = np.mean(losses)
+        if self.risk:
