+import json
+from optimize import OUT, PROTOCOL, training_cases
+
+keys = list(PROTOCOL['uncertainty'])
+scan = sorted(json.loads((OUT/'scan2.json').read_text()), key=lambda result: result['fidelity'])
+
+def extend(cases, count):
+    selected = []
+    seen = set()
+    for case in cases:
+        point = tuple(case[key] for key in keys)
+        if point not in seen:
+            selected.append(case)
+            seen.add(point)
+    added = 0
+    for result in scan:
+        case = result['case']
+        point = tuple(case[key] for key in keys)
+        if point not in seen:
+            selected.append(case)
+            seen.add(point)
+            added += 1
+        if added >= count:
+            break
+    return selected
+
+training = extend(json.loads((OUT/'expanded_cases.json').read_text()), 12)
+audit = extend(training_cases(16), 8)
+(OUT/'stage3_cases.json').write_text(json.dumps(training, indent=2))
+(OUT/'audit_cases.json').write_text(json.dumps(audit, indent=2))
+print('training', len(training), 'audit', len(audit), flush=True)

**Evaluating scores and errors**

I'm calculating the scores by subtracting B_case from physicalscore. I need to determine the gradients for combined errors and assess the objective weights, especially regarding boundary conditions. If the boundary conditions are invalid, it will log a negative error. Plus, I realized that the score files might not accurately reflect F, although I can incorporate true scores and boundary metadata for future reference. It's crucial to keep everything aligned properly!
codex
The audit found excessive boundary mass. I’ll constrain that before continuing.

