+import json
+from optimize import OUT, PROTOCOL, training_cases
+
+keys = list(PROTOCOL['uncertainty'])
+scan = sorted(json.loads((OUT/'scan2.json').read_text()), key=lambda result: result['fidelity'])
+
+def extend(cases, count):
+    selected = []
+    seen = set()
+    for case in cases:
+        point = tuple(case[key] for key in keys)
+        if point not in seen:
+            selected.append(case)
+            seen.add(point)
+    added = 0
+    for result in scan:
+        case = result['case']
+        point = tuple(case[key] for key in keys)
+        if point not in seen:
+            selected.append(case)
+            seen.add(point)
+            added += 1
+        if added >= count:
+            break
+    return selected
+
+training = extend(json.loads((OUT/'expanded_cases.json').read_text()), 12)
+audit = extend(training_cases(16), 8)
+(OUT/'stage3_cases.json').write_text(json.dumps(training, indent=2))
+(OUT/'audit_cases.json').write_text(json.dumps(audit, indent=2))
+print('training', len(training), 'audit', len(audit), flush=True)

**Evaluating core scoring**

I'm working on the ranking system, figuring out how to prioritize user objectives. There's a need to approximate scores accurately, even when some data isn't available. I could restrict design choices to avoid risks that lower core scores. It seems like I need to evaluate several families and run audits to finalize the blend maximizing fidelity. The pipeline might require adjustments, especially with time constraints, but screening could help pick the best rank efficiently. Options are on the table!
