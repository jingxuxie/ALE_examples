+
+source = OUT / (sys.argv[1] if len(sys.argv) > 1 else 'scan1.json')
+destination = OUT / (sys.argv[2] if len(sys.argv) > 2 else 'expanded_cases.json')
+count = int(sys.argv[3]) if len(sys.argv) > 3 else 16
+scan = json.loads(source.read_text())
+cases = training_cases(16)
+keys = list(PROTOCOL['uncertainty'])
+seen = {tuple(case[key] for key in keys) for case in cases}
+added = 0
+for result in sorted(scan, key=lambda result: result['fidelity']):
+    case = result['case']
+    point = tuple(case[key] for key in keys)
+    if point not in seen:
+        cases.append(case)
+        seen.add(point)
+        added += 1
+    if added >= count:
+        break
+destination.write_text(json.dumps(cases, indent=2))
+print('selected', len(cases), 'cases', flush=True)
