+++ b/tasks_v4/xmds2_fast_scalable_simulation_of_coupled_stochastic_partial_different__1204_4255/concept_3/attempts/v_3/analyze.py
@@ -0,0 +1,75 @@
+import os
+os.environ['OPENBLAS_NUM_THREADS'] = '1'
+os.environ['OMP_NUM_THREADS'] = '1'
+import argparse
+import itertools
+import json
+import time
+import multiprocessing as mp
+import numpy as np
+from scipy.stats import qmc
+from optimize import ROOT, OUT, PROTOCOL, fc, worker
+
+def all_cases(interiors=0):
+    keys = list(PROTOCOL['uncertainty'])
+    cases = fc.read_json(ROOT / 'input/public_cases.json')
+    points = list(itertools.product([0, 1], repeat=8))
+    if interiors:
+        points.extend(qmc.Sobol(8, scramble=True, seed=491).random_base2(int(np.ceil(np.log2(interiors))))[:interiors])
+    for index, point in enumerate(points):
+        case = {'id': 'envelope_%03d' % index, 'family': 'joint'}
+        for key, coordinate in zip(keys, point):
+            low, high = PROTOCOL['uncertainty'][key]
+            case[key] = float(low+(high-low)*coordinate)
+        cases.append(case)
+    return cases
+
+def audit_group(arguments):
+    cases, data = arguments
+    splines, control_diagnostics = fc.validate_artifact(data, PROTOCOL)
+    shapes = [(80,40), (112,56), (112,56)]
+    timesteps = [0.01, 0.01, 0.005]
+    scores, states, diagnostics, residuals = [], [], [], []
+    for shape, dt in zip(shapes, timesteps):
+        initial, target, residual = fc.references(cases, shape, OUT/'cache')
+        state, diagnostic = fc.evolve(splines, cases, shape, dt, initial)
+        scores.append(fc.fidelities(state, target, shape))
+        states.append(state)
+        diagnostics.append({key: value.tolist() for key, value in diagnostic.items()})
+        residuals.append(residual)
+    allowance = 2*(np.abs(scores[0]-scores[1])+np.abs(scores[1]-scores[2]))+2e-6
+    distance_ab = fc.state_distance(fc.prolong(states[0], shapes[1]), states[1], shapes[1])
+    distance_bc = fc.state_distance(states[1], states[2], shapes[2])
+    return {'cases': [case['id'] for case in cases], 'scores': np.asarray(scores).tolist(), 'allowance': allowance.tolist(), 'audited': (scores[2]-allowance).tolist(), 'distance_ab': distance_ab.tolist(), 'distance_bc': distance_bc.tolist(), 'diagnostics': diagnostics, 'residuals': residuals}
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--artifact', default=str(OUT/'control.json'))
+    parser.add_argument('--audit', action='store_true')
+    parser.add_argument('--cases')
+    parser.add_argument('--interiors', type=int, default=64)
+    parser.add_argument('--nx', type=int, default=48)
+    parser.add_argument('--ny', type=int, default=24)
+    parser.add_argument('--dt', type=float, default=0.05)
+    parser.add_argument('--output', default='scan.json')
+    arguments = parser.parse_args()
+    data = fc.read_json(arguments.artifact)
+    vector = np.array([data['controls'][channel][3:-3] for channel in fc.CHANNELS]).ravel()
+    cases = fc.read_json(arguments.cases) if arguments.cases else (fc.read_json(ROOT/'input/public_cases.json') if arguments.audit else all_cases(arguments.interiors))
+    groups = [list(group) for group in np.array_split(cases, 4)]
+    started = time.time()
+    with mp.Pool(4) as pool:
+        if arguments.audit:
+            output = pool.map(audit_group, [(group, data) for group in groups])
+            print(json.dumps(output, indent=2), flush=True)
+        else:
+            scores = np.concatenate(pool.map(worker, [(group, (arguments.nx, arguments.ny), arguments.dt, vector, False) for group in groups]))
+            output = [{'case': case, 'fidelity': float(score)} for case, score in zip(cases, scores)]
+            print('mean', scores.mean(), 'min', scores.min(), 'quantiles', np.quantile(scores, [0,.05,.1,.25,.5,1]), flush=True)
+            for index in np.argsort(scores)[:20]:
+                print(scores[index], cases[index], flush=True)
+        (OUT/arguments.output).write_text(json.dumps(output, indent=2))
+    print('seconds', time.time()-started, flush=True)
+
+if __name__ == '__main__':
+    main()
