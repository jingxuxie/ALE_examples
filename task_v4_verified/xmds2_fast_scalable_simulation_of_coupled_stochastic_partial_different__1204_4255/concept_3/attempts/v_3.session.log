@@ -0,0 +1,15 @@
+import json
+import sys
+import numpy as np
+from optimize import OUT, PROTOCOL
+
+groups = json.loads((OUT/sys.argv[1]).read_text())
+scores = [(identifier, score) for group in groups for identifier, score in zip(group['cases'], group['audited'])]
+maxima = {key: max(float(np.max(diagnostic[key])) for group in groups for diagnostic in group['diagnostics']) for key in ['norm_error', 'boundary_mass', 'spectral_tail']}
+maxima['allowance'] = max(float(np.max(group['allowance'])) for group in groups)
+maxima['state_distance'] = max(float(np.max(group[key])) for group in groups for key in ['distance_ab', 'distance_bc'])
+maxima['reference_residual'] = max(max(group['residuals']) for group in groups)
+valid = all(value <= PROTOCOL['audit']['max_'+key] for key, value in maxima.items())
+print('AUDIT VALID', valid, 'MAXIMA', maxima)
+print('mean', np.mean([score for identifier, score in scores]), 'minimum', min(scores, key=lambda item: item[1]))
+print('worst', sorted(scores, key=lambda item: item[1])[:10])
