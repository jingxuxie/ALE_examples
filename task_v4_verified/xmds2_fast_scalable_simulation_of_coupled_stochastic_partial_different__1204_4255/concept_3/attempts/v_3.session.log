+maxima['allowance'] = max(float(np.max(group['allowance'])) for group in groups)
+maxima['state_distance'] = max(float(np.max(group[key])) for group in groups for key in ['distance_ab', 'distance_bc'])
+maxima['reference_residual'] = max(max(group['residuals']) for group in groups)
