+print('AUDIT VALID', valid, 'MAXIMA', maxima)
+print('mean', np.mean([score for identifier, score in scores]), 'minimum', min(scores, key=lambda item: item[1]))
+print('worst', sorted(scores, key=lambda item: item[1])[:10])
