    ],
    "relative_phase": [
      -3.141592653589793,
      3.141592653589793
    ]
  },
  "equation": "i d_t psi = -dispersion d_xx psi + [[detuning,coupling],[coupling,-detuning]] psi - nonlinearity diag(|psi_1|^2+cross|psi_2|^2, |psi_2|^2+cross|psi_1|^2) psi, x in [0,2*pi), periodic",
  "initial_condition": {
    "raw_first": "1+a1*cos(x)+b1*cos(2*x+phase1)+i*c1*sin(x+phase2)",
    "raw_second": "exp(i*relative_phase)*(1+a2*cos(x+shift)+b2*cos(3*x+phase2)+i*c2*sin(2*x+phase1))",
    "normalization": "Normalize first and second mean squared moduli to population and 1-population separately. Total mean density is exactly 1. Fourier coefficients are fft(psi)/N.",
    "support": "Exactly |k|<=3; no input lattice, coefficients, noise, potential, or integrator settings may be supplied."
  },
  "method_under_test": {
    "name": "Fourier-Galerkin method of lines with fourth-order interaction-picture Runge-Kutta",
    "grid": 32,
    "coarse_steps": 512,
    "fine_steps": 1024,
    "modes": "-16,...,15; complex fields, with no imposed real-field Nyquist convention",
    "nonlinear_quadrature": "64-point zero-padded cubic products, projected back to the 32 retained modes; exact cubic Galerkin convolution, not initial or cubic-product aliasing",
    "linear_flow": "Exact matrix exponential of dispersion*k^2*I plus the constant 2x2 mixing matrix",
    "certificate": "Maximum normalized complex-field L2 distance between coarse and fine at all eight times, without Richardson division or phase alignment. Parseval normalization is sum_{component,k}|difference_k|^2; initial norm is 1.",
    "claim_under_test": "For this constrained experiment, a small step-halving certificate and modest sampled spectral tail certify the low-wave-number density prediction. This is a hypothesis about the supplied workflow, NOT a claim or bug allegation about XMDS2."
  },
