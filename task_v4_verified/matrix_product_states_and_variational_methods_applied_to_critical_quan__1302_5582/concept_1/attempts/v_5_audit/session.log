+import numpy as np
+import improved
+from optimizer import left_block, right_block, effective_action, factor
+from truncation import energy_factor
+
+
+def full_pair(tensors, charges, site, left_environment, right_environment,
+              onsite, positions, couplings, direction, cap, tolerance,
+              max_steps, clock):
+    first, second = tensors[site:site+2]
+    left, dimension, middle = first.shape
+    right = second.shape[2]
+    row_charge = (charges[site][:, None] ^ (np.arange(dimension)[None, :] % 2)).ravel()
+    column_charge = ((np.arange(dimension)[:, None] % 2) ^ charges[site+2][None, :]).ravel()
+    left_matrix = left_block(left_environment, onsite[site], positions[site],
+                             couplings[site-1] if site else 0.0)
+    right_matrix = right_block(right_environment, site+1],
+               olumn_charge)
+    left_matix = np.diag(right_values)
+    left_position = left_basis.T @ np.kron(np.eye(left), positions[site]) @ left_basis
+    right_position = right_basis.T @ np.kron(positions[site+1], np.eye(right)) @ right_basis
+    matvec, diagonal, pack, unpack = effective_action(left_matrix, right_matrix,
+        left_position, right_position, couplings[site], row_charge, column_charge)
+    initial = (left_basis.T @ first.reshape(left*dimension, middle)) @ (second.reshape(middle, dimension*right) @ right_basis)
+    vector, energy = improved.lowest(matvec, diagonal, pack(initial), tolerance, 40, clock)
+    optimized = unpack(vector)
+    left_vectors, values, right_vectors, new_charge = energy_factor(optimized,
+        row_charge, column_charge, cap, left_matrix, right_matrix,
+        left_position, right_position, couplings[site])
+    values /= np.linalg.norm(values)
+    if direction == 1:
+        tensors[site] = (left_basis @ left_vectors).reshape(left, dimension, len(values))
+        tensors[site+1] = ((values[:, None]*right_vectors) @ right_basis.T).reshape(len(values), dimension, right)
+    else:
+        tensors[site] = (left_basis @ (left_vectors*values)).reshape(left, dimension, len(values))
+        tensors[site+1] = (right_vectors @ right_basis.T).reshape(len(values), dimension, right)
+    charges[site+1] = new_charge
+    return energy
+
+
+def optimize(request, start_cpu=None, start_wall=None):
+    improved.reduced_pair = full_pair
+    return improved.optimize(request, start_cpu, start_wall)
*** End Patch
