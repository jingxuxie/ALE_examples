def full_spectrum(reduced, spatial):
    result = np.empty(spatial + reduced.shape[len(spatial):], dtype=np.complex128)
    for index in np.ndindex(spatial):
        if index[-1] <= spatial[-1] // 2:
            result[index] = reduced[index]
        else:
            partner = tuple((-coordinate) % length for coordinate, length in zip(index, spatial))
            result[index] = reduced[partner].conj()
    return result


