maximum_error = 0.0
maximum_direction_error = 0.0

def assert_close(actual, expected, label, tolerance=3e-11):
    global maximum_error
    actual = np.asarray(actual)
    expected = np.asarray(expected)
    assert actual.shape == expected.shape, (label, actual.shape, expected.shape)
    assert np.all(np.isfinite(actual)), label
    if actual.dtype "'!= bool:
        difference = np.max(np.abs(actual - expected), initial=0)
        relative = difference / max(1.0, float(np.max(np.abs(expected), initial=0)))
        maximum_error = max(maximum_error, relative)
    np.testing.assert_allclose(actual, expected, rtol=tolerance, atol=tolerance, err_msg=label)


def make_inputs(spatial, batch, channel, shared, parameter_count, probe_count):
    reduced = spatial[:-1] + (spatial[-1] // 2 + 1,)
    spectrum_shape = reduced if shared else reduced + channel
    field_shape = batch + spatial + channel
    base = np.exp(random.normal(scale=0.3, size=spectrum_shape) + 1j * random.normal(scale=0.5, size=spectrum_shape))
    amplitude = random.normal(scale=0.12, size=(parameter_count,) + spectrum_shape)
    phase = random.normal(scale=0.15, size=(parameter_count,) + spectrum_shape)
    boundaries = [0] + ([spatial[-1] // 2] if spatial[-1] % 2 == 0 else [])
    nonself_pair = None
    for prefix in np.ndindex(spatial[:-1]):
        for last in boundaries:
            index = prefix + (last,)
            partner = tuple((-coordinate) % length for coordinate, length in zip(index, spatial))
            if index == partner:
                base[index] = random.choice([-1.0, 1.0], size=base[index].shape) * np.abs(base[index])
                phase[(slice(None),) + index] = 0
            elif index > partner:
                nonself_pair = index
                base[index] = np.conj(base[partner])
                amplitude[(slice(None),) + index] = amplitude[(slice(None),) + partner]
                phase[(slice(None),) + index] = -phase[(slice(None),) + partner]
    probes = np.broadcast_to(base, (probe_count,) + spectrum_shape).copy()
    if probe_count > 1:
        probes[1] = 0
    if probe_count > 2:
        probes[(2,) + (0,) * len(spatial)] += 0.3j
    if probe_count > 3 and nonself_pair is not None:
        probes[(3,) + nonself_pair] += 0.6 + 0.8j
    if probe_count > 4 and spatial[-1] > 2:
