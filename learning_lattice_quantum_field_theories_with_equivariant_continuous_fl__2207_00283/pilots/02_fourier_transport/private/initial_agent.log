            matrix[:, column] = image
        assert_close(log_determinant, np.linalg.slogdet(matrix)[1], 'dense determinant')
        dense_gradient = (inputs['cotangent'].reshape(-1, event_size) @ matrix / scale).reshape(inputs['x'].shape)
        assert_close(output['grad_x'], dense_gradient, 'dense adjoint')
    if case_number % 13 == 0:
        epsilon = 3e-6
        positive = dict(inputs)
        negative = dict(inputs)
        for name, direction in [('x', 'direction_x'), ('theta', 'direction_theta'), ('log_density', 'direction_log_density')]:
            positive[name] = inputs[name] + epsilon * inputs[direction]
            negative[name] = inputs[name] - epsilon * inputs[direction]
        positive_output = solve.solve(positive)
        negative_output = solve.solve(negative)
        difference = (positive_output['y'] - negative_output['y']) / (2 * epsilon)
        np.testing.assert_allclose(output['jvp_y'], difference, rtol=2e-8, atol=2e-8)
        derivative = lambda result: np.sum(inputs['cotangent'] * result['y']) / scale + np.mean(result['log_density_y']) / (volume * channels)
        numerical = (derivative(positive_output) - derivative(negative_output)) / (2 * epsilon)
        analytic = np.sum(output['grad_x'] * inputs['direction_x']) + np.sum(output['grad_theta'] * inputs['direction_theta']) + np.mean(inputs['direction_log_density']) / (volume * channels)
        np.testing.assert_allclose(analytic, numerical, rtol=2e-8, atol=2e-8)
        maximum_direction_error = max(maximum_direction_error, abs(analytic - numerical))
    return output, solve_seconds

