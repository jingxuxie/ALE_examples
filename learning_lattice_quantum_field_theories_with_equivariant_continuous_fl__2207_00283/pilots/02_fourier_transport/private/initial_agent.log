maximum_errors = {}

def check(name, actual, expected, tolerance=2e-11):
    actual = np.asarray(actual)
    expected = np.asarray(expected)
    assert actual.shape == expected.shape, (name, actual.shape, expected.shape)
    assert np.all(np.isfinite(actual)), name
    error = float(np.max(np.abs(actual - expected), initial=0)) if actual.dtype "'!= bool else float(np.any(actual != expected))
    maximum_errors[name] = max(error, maximum_errors.get(name, 0))
    np.testing.assert_allclose(actual, expected, rtol=tolerance, atol=tolerance, err_msg=name)


def reference_geometry(spatial):
    reduced = spatial[:-1] + (spatial[-1] // 2 + 1,)
    real = np.zeros(reduced, dtype=bool)
    imaginary = np.zeros(reduced, dtype=bool)
    momenta = np.zeros(reduced + (len(spatial),))
    shells = np.zeros(reduced, dtype=np.int64)
    for index in np.ndindex(reduced):
        partner = tuple((-coordinate) % length for coordinate, length in zip(index, spatial))
        stored = partner[-1] < reduced[-1]
        real[index] = not stored or index <= partner
        imaginary[index] = real[index] and index != partner
        for axis, (coordinate, length) in enumerate(zip(index, spatial)):
            signed = coordinate if 2 * coordinate <= length else coordinate - length
            momenta[index + (axis,)] = 2 * np.pi * signed / length
            shells[index] += signed ** 2
    return real, imaginary, momenta, shells


def expand_spectrum(reduced_spectrum, spatial):
    full = np.empty(spatial + reduced_spectrum.shape[len(spatial):], dtype=np.complex128)
    for index in np.ndindex(spatial):
        if index[-1] <= spatial[-1] // 2:
            full[index] = reduced_spectrum[index]
        else:
            partner = tuple((-coordinate) % length for coordinate, length in zip(index, spatial))
            full[index] = np.conj(reduced_spectrum[partner])
    return full


def reference_transport(inputs, field=None, parameters=None, reverse=False):
    spatial = tuple(inputs['"'spatial_shape'])
    channel = tuple(inputs['channel_shape'])
    batch = tuple(inputs['batch_shape'])
    axes = tuple(range(len(batch), len(batch) + len(spatial)))
    if field is None:
        field = inputs['x']
    if parameters is None:
        parameters = inputs['theta']
    log_delta = sum(parameter * (amplitude + 1j * phase) for parameter, amplitude, phase in zip(parameters, inputs['amplitude'], inputs['phase']))
    spectrum = inputs['base'] * np.exp(log_delta)
    full = expand_spectrum(spectrum, spatial)
    log_det = np.sum(np.log(np.abs(full)))
    if inputs['base'].ndim == len(spatial):
        log_det *= math.prod(channel)
        full = full.reshape(spatial + (1,) * len(channel))
    field_fft = np.fft.fftn(field, s=spatial, axes=axes, norm='ortho')
    transformed = field_fft / full if reverse else field_fft * full
    image = np.fft.ifftn(transformed, s=spatial, axes=axes, norm='ortho')
    assert np.max(np.abs(image.imag), initial=0) < 1e-11
    return image.real, log_det


