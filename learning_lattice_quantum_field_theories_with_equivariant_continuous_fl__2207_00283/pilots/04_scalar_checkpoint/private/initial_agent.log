+        compare(actual, expected, "absolute " + str(case["operation"]) + " " + str(case["model"]), tolerance=2e-10)
+    zero_case = dict(cases[-1], phi=np.zeros_like(cases[-1]["phi"]), operation=np.array("forward"))
