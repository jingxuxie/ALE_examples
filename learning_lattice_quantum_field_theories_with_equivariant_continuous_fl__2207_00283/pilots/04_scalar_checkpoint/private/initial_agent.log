+    if len(sys.argv) != 3:
+        raise SystemExit("Usage: solve.py INPUT.npz OUTPUT.npz")
+    with np.load(sys.argv[1], allow_pickle=False) as archive:
+        request = dict(archive)
+    result = solve(request)
+    np.savez(sys.argv[2], **result)
