+def walsh(values):
+    output = np.array(values, dtype=float, copy=True)
+    width = 1
+    while width < output.shape[-1]:
+        blocks = output.reshape(output.shape[:-1] + (-1, 2 * width))
+        left = blocks[..., :width].copy()
+        right = blocks[..., width:].copy()
+        blocks[..., :width] = left + right
+        blocks[..., width:] = left - right
+        width *= 2
+    return output
+
