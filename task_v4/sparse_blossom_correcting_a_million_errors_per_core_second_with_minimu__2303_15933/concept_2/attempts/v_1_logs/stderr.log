+import itertools
+import json
+import sys
+import time
+
+import numpy as np
+
+import search
+import cuts
+
+def canonical(detectors):
+    choices = []
+    for flip_col in [False, True]:
+        for flip_row in [False, True]:
+            transformed = [(4 * (4 - detector // 4 if flip_col else detector // 4) + (3 - detector % 4 if flip_row else detector % 4)) for detector in detectors]
+            choices.append(tuple(sorted(transformed)))
+    return min(choices)
+
+def main():
+    count = int(sys.argv[1]) if len(sys.argv)>1 else 4
+    rng = np.random.default_rng(1234 + count)
+    start = time.time()
+    cases = []
+    for detectors in itertools.combinations(range(20), count):
+        syndrome = sum(1 << detector for detector in detectors)
+        if search.valid_syndrome(syndrome) and canonical(detectors) == detectors:
+            cases.append(syndrome)
+    rng.shuffle(cases)
+    print('CASES', len(cases), flush=True)
+    best = -100
+    records = {}
+    iteration = 0
+    for sweep in range(10):
+        for syndrome in cases:
+            for physical in [0, 1]:
+                key = (syndrome, physical)
+                if sweep and key in records and rng.random() < .7:
+                    weights = np.clip(records[key][1] + rng.normal(0, rng.uniform(.3, 1.5), 39), search.LOW, search.HIGH)
+                else:
+                    weights = rng.uniform(search.LOW, search.HIGH, 39)
+                    if rng.random() < .6:
+                        paths = search.evaluate(weights, syndrome)[2]
+                        weights = np.clip(weights - search.bits(paths[physical]), search.LOW, search.HIGH)
+                weights, result = search.optimize(weights, syndrome, physical=physical, maxiter=120)
+                measured = search.metrics(weights, syndrome, physical)
+                if measured[0] > .85:
+                    weights, result = cuts.optimize(weights, syndrome, physical=physical, maxiter=150)
+                    measured = search.metrics(weights, syndrome, physical)
+                score = measured[0]
+                if (1/(1+np.exp(weights))).mean() > .085000001:
+                    continue
+                if key not in records or score > records[key][0]:
+                    records[key] = (score, weights.copy())
+                if score > best:
+                    best = score
+                    search.save(weights, syndrome, f'best_sys{count}.json')
+                    print('BEST', iteration, sweep, round(time.time()-start, 2), measured, [detector for detector in range(20) if syndrome >> detector & 1], physical, result.message, flush=True)
+                if iteration % 100 == 0:
+                    print('progress', iteration, sweep, round(time.time()-start, 2), score, flush=True)
+                    ordered = sorted(records, key=lambda key: -records[key][0])
+                    np.savez(search.ROOT / f'archive_sys{count}.npz', scores=np.array([records[key][0] for key in ordered]), weights=np.array([records[key][1] for key in ordered]), syndromes=np.array([key[0] for key in ordered]), physicals=np.array([key[1] for key in ordered]))
+                iteration += 1
+                if score > 1.0005:
+                    search.save(weights, syndrome, f'witness_sys{count}.json')
+                    print('SUCCESS', flush=True)
+                    return
+
+if __name__ == '__main__':
+    main()
