+        if score > best:
+            best = score
+            save(weights, syndrome, '"'best.json')
+            print('BEST', iteration, round(time.time()-start, 2), measured, [detector for detector in range(20) if syndrome >> detector & 1], result.message, flush=True)
+        if iteration % 10 == 0:
