+import ctypes
+import json
+import math
+import os
+import sys
+import time
+from pathlib import Path
+
+import numpy as np
+from scipy.optimize import minimize
+
+ROOT = Path(__file__).resolve().parent
+LIB = ctypes.CDLL(str(ROOT / '"'inference.so'))
+POINTER = np.ctypeslib.ndpointer(dtype=np.float64, flags='C_CONTIGUOUS')
+LIB.evaluate.argtypes = [POINTER, ctypes.c_int, ctypes.c_double, POINTER, POINTER, np.ctypeslib.ndpointer(dtype=np.uint64, flags='C_CONTIGUOUS')]
+LOW = math.log(0.86 / 0.14)
+HIGH = math.log(0.98 / 0.02)
+TARGET_ODDS = math.log(0.85 / 0.15)
+
+def evaluate(weights, syndrome, alpha=1.0):
+    result = np.zeros(4)
+    gradient = np.zeros((4, 39))
+    paths = np.zeros(2, dtype=np.uint64)
+    LIB.evaluate(np.ascontiguousarray(weights), syndrome, alpha, result, gradient, paths)
+    return result, gradient, paths
+
+def bits(mask):
+    return np.array([(int(mask) >> edge) & 1 for edge in range(39)], dtype=float)
+
+def save(weights, syndrome, filename):
+    probabilities = np.clip(1 / (1 + np.exp(weights)), 0.02, 0.14)
+    data = dict(version=1, probabilities=probabilities.tolist(), syndrome=[detector for detector in range(20) if syndrome >> detector & 1])
+    (ROOT / filename).write_text(json.dumps(data, indent=2) + '\\n')
+
+def metrics(weights, syndrome, physical=None):
+    if physical is None:
+        physical = int(evaluate(weights, syndrome)[0][3] < evaluate(weights, syndrome)[0][2])
+    opposite = 1 - physical
+    probabilities = 1 / (1 + np.exp(weights))
+    allowance = (39 / 0.95 + np.sum(probabilities / (1 - 1.05 * probabilities))) * 0.0025 + 1e-10
+    values = [evaluate(weights, syndrome, alpha)[0] for alpha in [0.95, 1.0, 1.05]]
+    gap = min(value[2+opposite] - value[2+physical] for value in values) - allowance
+    odds = min(value[opposite] - value[physical] for value in values) - allowance
+    mass = min(np.exp(value[:2]).sum() for value in values) * np.exp(-allowance)
+    return min(gap/1.08, odds/TARGET_ODDS, mass/0.0000175), gap, odds, mass
+
+class Objective:
+    def __init__(self, syndrome, physical, gap_target=1.08, mass_target=0.0000175):
+        self.syndrome = syndrome
+        self.physical = physical
+        self.opposite = 1 - physical
+        self.gap_target = gap_target
+        self.mass_target = mass_target
+        self.last = None
+
+    def compute(self, variables):
+        if self.last is not None and np.array_equal(self.last, variables):
+            return
+        self.last = variables.copy()
+        weights = variables[:39]
+        score = variables[39]
+        probabilities = 1 / (1 + np.exp(weights))
+        derivative = -probabilities * (1 - probabilities)
+        allowance = (39 / 0.95 + np.sum(probabilities / (1 - 1.05 * probabilities))) * 0.0025 + 1e-10
+        allowance_gradient = 0.0025 * derivative / (1 - 1.05 * probabilities) ** 2
+        constraints = [(0.085 - probabilities.mean()) * 100]
+        gradients = [np.r_[-derivative / 39 * 100, 0.0]]
+        for alpha in [0.95, 1.05]:
+            result, jac, paths = evaluate(weights, self.syndrome, alpha)
+            gap = result[2+self.opposite] - result[2+self.physical] - allowance
+            odds = result[self.opposite] - result[self.physical] - allowance
+            logmass = np.logaddexp(*result[:2]) - allowance
+            fraction = np.exp(result[:2] - np.logaddexp(*result[:2]))
+            constraints.extend([gap - self.gap_target * score, odds - TARGET_ODDS * score, logmass - math.log(self.mass_target) - (score - 1)])
+            gradients.extend([np.r_[jac[2+self.opposite] - jac[2+self.physical] - allowance_gradient, -self.gap_target], np.r_[jac[self.opposite] - jac[self.physical] - allowance_gradient, -TARGET_ODDS], np.r_[fraction @ jac[:2] - allowance_gradient, -1.0]])
+        self.constraints = np.array(constraints)
+        self.jacobian = np.array(gradients)
+
+    def fun(self, variables):
+        self.compute(variables)
+        return self.constraints
+
+    def jac(self, variables):
+        self.compute(variables)
+        return self.jacobian
+
+def optimize(weights, syndrome, physical=None, maxiter=100):
+    if physical is None:
+        result = evaluate(weights, syndrome)[0]
+        physical = int(result[3] < result[2])
+    objective = Objective(syndrome, physical)
+    variables = np.r_[weights, min(metrics(weights, syndrome, physical)[0], 0.0)]
+    result = minimize(lambda value: -value[39], variables, jac=lambda value: np.r_[np.zeros(39), -1.0], method='SLSQP', bounds=[(LOW, HIGH)]*39 + [(-10, 2)], constraints=[dict(type='ineq', fun=objective.fun, jac=objective.jac)], options=dict(maxiter=maxiter, ftol=1e-8))
+    return result.x[:39], result
+
+def valid_syndrome(syndrome):
+    detectors = [detector for detector in range(20) if syndrome >> detector & 1]
+    return 3 <= len(detectors) <= 6 and len({detector//4 for detector in detectors}) >= 3 and len({detector%4 for detector in detectors}) >= 3
+
+def main():
+    rng = np.random.default_rng(int(sys.argv[1]) if len(sys.argv)>1 else 123)
+    start = time.time()
