+        for(int index=0;index<int(layer.gates.size());index++) { const Gate& gate=layer.gates[index]; if(index) stream<<\",\"; stream<<\"[\"<<gate.control<<\",\"<<gate.target<<\"]\"; raw<<gate.control<<\" \"<<gate.target<<\" \"<<gate.edge<<\" \"; }
