+
+void save(const Circuit& circuit,const std::string& path) {
+    const char* words[]={"I","H","S","HS","SH","HSH"};
+    std::ofstream stream(path+".json"); stream<<"{'"\\\"family\\\":\\\"\"<<family<<\"\\\",\\\"layers\\\":[\";
+    std::ofstream raw(path+\".raw\");
