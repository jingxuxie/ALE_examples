import json
import numpy as np
import optimize as opt
from pathlib import Path
artifact = json.loads(Path('witness.json').read_text())
rows = opt.model.rows_of(artifact)
counts = opt.model.check_constraints(artifact)
values = np.concatenate(rows)
print('Artifact bytes:', Path('witness.json').stat().st_size)
print('Row sums:', sorted(set(map(sum, rows))))
print('Single minimum/maximum:', min(values[:72]), max(values[:72]))
print('CNOT minimum/maximum:', min(values[72:]), max(values[72:]))
print('Maximum exact marginal mismatch:', np.max(np.abs(opt.model.WEIGHTS @ counts - opt.model.BASELINE_MARGINALS)))
print('Exact integer overlap:', values @ opt.Q.astype(np.int64) @ values)
print('Independent fit:', opt.fit(opt.curve(values)))
