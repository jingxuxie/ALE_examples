*** Add File: ../attempts/v_3/rounding.py
+import os
+os.environ['OPENBLAS_NUM_THREADS'] = '1'
+os.environ['OMP_NUM_THREADS'] = '1'
+import sys
+sys.dont_write_bytecode = True
+import argparse
+import json
+import time
+import numpy as np
+from scipy.optimize import milp, Bounds, LinearConstraint
+from scipy.sparse import csc_matrix
+import search
+
+
+def round_family(target, family, radius=1, seconds=90, style='distance', random_seed=0):
+    start, stop = (0, 72) if family == 'single' else (72, 192)
+    rng = np.random.default_rng(random_seed)
+    lower = np.maximum(search.LOWER, np.floor(target + 1e-6) - radius).astype(int)
+    upper = np.minimum(search.UPPER, np.ceil(target - 1e-6) + radius).astype(int)
+    gradient = search.metrics(target, True)[2]
+    choices = []
+    costs = []
+    groups = []
+    for first in range(start, stop):
+        second = search.PAIR[first]
+        if second < first:
+            continue
+        group_start = len(choices)
+        for first_value in range(lower[first], upper[first] + 1):
+            second_values = [first_value] if second == first else range(lower[second], upper[second] + 1)
+            for second_value in second_values:
+                choice = np.zeros(stop - start)
+                choice[first - start] = first_value
+                choice[second - start] = second_value
+                overlap = (first_value - search.BASE[first]) * (second_value - search.BASE[second])
+                if first "'!= second:
+                    overlap *= 2
+                distance = (first_value - target[first]) ** 2
+                linear = -gradient[first] * (first_value - target[first])
+                if first != second:
+                    distance += (second_value - target[second]) ** 2
+                    linear -= gradient[second] * (second_value - target[second])
+                if style == '"'distance':
+                    cost = distance
+                elif style == 'gradient':
+                    cost = linear * 1e6 + distance * 0.05
+                else:
+                    cost = distance + rng.uniform(-2, 2)
+                costs.append(cost)
+                choices.append((choice, overlap))
+        groups.append((group_start, len(choices)))
+    values = np.array([choice[0] for choice in choices]).T
+    overlaps = np.array([choice[1] for choice in choices])
+    matrix_rows = []
+    right = []
+    for begin, end in groups:
+        row = np.zeros(len(choices))
+        row[begin:end] = 1
+        matrix_rows.append(row)
+        right.append(1)
+    matrix_rows.extend(search.LINEAR[:, start:stop] @ values)
+    right.extend(search.LINEAR[:, start:stop] @ search.BASE[start:stop])
+    matrix_rows.append(overlaps)
+    right.append(0)
+    matrix = csc_matrix(np.array(matrix_rows))
+    print('milp', family, radius, style, 'variables', len(choices), flush=True)
+    result = milp(np.array(costs), integrality=np.ones(len(choices)),
+                  bounds=Bounds(0, 1), constraints=LinearConstraint(matrix, right, right),
+                  options={'time_limit': seconds, 'mip_rel_gap': 0.005, 'disp': False})
+    print('milp result', result.message, 'objective', result.fun, flush=True)
+    if result.x is None:
+        return None
+    counts = np.rint(values @ result.x)
+    test = target.copy()
+    test[start:stop] = counts
+    family_overlap = search.overlaps(test)[0 if family == 'single' else 1]
+    assert family_overlap == 0, family_overlap
+    assert np.max(np.abs(search.LINEAR[:, start:stop] @ (counts - search.BASE[start:stop]))) == 0
+    return counts
+
+
+def convert(path, radius, seconds, style, seed):
+    target = np.load(path)
+    print('rounding', path.name, search.metrics(target)[0], search.overlaps(target), flush=True)
+    counts = target.copy()
+    for family, start, stop in [('single', 0, 72), ('cx', 72, 192)]:
+        rounded = round_family(target, family, radius, seconds, style, seed)
+        if rounded is None:
+            return None
+        counts[start:stop] = rounded
+    artifact = search.artifact(counts)
+    search.model.check_constraints(artifact)
+    measured = search.metrics(counts)[0]
+    print('INTEGER', path.name, radius, style, measured, flush=True)
+    destination = search.ROOT / f'integer_{path.stem}_{radius}_{style}_{seed}.json'
+    destination.write_text(json.dumps(artifact, indent=2) + '\\n')
+    incumbent = search.ROOT / 'witness.json'
+    previous = -1
+    if incumbent.exists():
+        loaded = search.model.rows_of(json.loads(incumbent.read_text()))
+        previous = search.metrics(np.concatenate(loaded))[0][0]
+    if measured[0] > previous:
+        incumbent.write_text(json.dumps(artifact, indent=2) + '\\n')
+        print('NEW BEST', measured, flush=True)
+    return counts
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--radius', type=int, default=1)
+    parser.add_argument('--seconds', type=float, default=90)
+    parser.add_argument('--style', default='distance')
+    parser.add_argument('--seed', type=int, default=0)
+    parser.add_argument('--top', type=int, default=5)
+    args = parser.parse_args()
+    candidates = []
+    for path in search.ROOT.glob('continuous_*.npy'):
+        target = np.load(path)
+        if np.max(np.abs(search.overlaps(target))) < 1e-4:
+            candidates.append((search.metrics(target)[0][0], path))
+    candidates.sort(reverse=True)
+    print('candidates', [(score, path.name) for score, path in candidates], flush=True)
+    for score, path in candidates[:args.top]:
+        convert(path, args.radius, args.seconds, args.style, args.seed)
*** End Patch
