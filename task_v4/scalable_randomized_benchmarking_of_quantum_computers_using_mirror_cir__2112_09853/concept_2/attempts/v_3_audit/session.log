    path=pathlib.Path(filename)
    if not path.exists():
        print(filename,'pending')
    elif filename.endswith('.json'):
        report=json.loads(path.read_text())
        print(filename,report['valid'],report['average_family_score'],report['worst_family_score'])
    else:
        rows=[json.loads(line) for line in path.read_text().splitlines()]
        scores={family:1/(1+np.mean([row['normalized_mse'] for row in rows if row['family']==family])) for family in dict.fromkeys(row['family'] for row in rows)}
        print(filename,len(rows),scores, 'mean',np.mean(list(scores.values())))
