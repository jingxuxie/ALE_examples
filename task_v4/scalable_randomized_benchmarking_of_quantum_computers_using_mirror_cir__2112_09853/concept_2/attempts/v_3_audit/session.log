/bin/bash -c "date; python -B - <<'PY'
import glob,json,numpy as np
for path in sorted(glob.glob('research_*.jsonl')):
    records=[json.loads(line) for line in open(path)]
    scores={family:1/(1+np.mean([record['normalized_mse'] for record in records if record['family']==family])) for family in ['local_clusters','distant_pairs','anticorrelated','spam_drift'] if any(record['family']==family for record in records)}
    risks={family:round(float(np.mean([record.get('posterior_risk',0) for record in records if record['family']==family])),3) for family in scores}
    print(path,len(records),[round(value,3) for value in scores.values()],round(np.mean(list(scores.values())),3),list(risks.values()))
print('inference')
print(open('inference_local.jsonl').read())
