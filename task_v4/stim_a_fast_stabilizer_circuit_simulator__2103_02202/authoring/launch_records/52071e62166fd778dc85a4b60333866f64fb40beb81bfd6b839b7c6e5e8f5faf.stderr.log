+        int xselector = values[0] == xcol ? 1 : values[0] == zcol ? 2 : 3;
+        int zselector = values[1] == xcol ? 1 : values[1] == zcol ? 2 : 3;
+        frames |= (xselector | (zselector << 2)) << (qubit * 4);
