+            int narrow = word >> 23;
+            if (narrow < 511) fixed.append(narrow, seed, offset);
+        }
+        if ((seed & 16383) == 0) {
+            double elapsed = std::chrono::duration<double>(std::chrono::steady_clock::now()-start).count();
+            std::cerr << "seed=" << seed << " seconds=" << elapsed << '"'\\n';
+        }
+    }
+    return success ? 0 : 1;
