+                bool zvalue = (matrix[second][0] >> input) & 1;
+                result[first][axis] |= Bits(xvalue) << second;
+                result[first][axis] |= Bits(zvalue) << (second+width);
+                result[first][axis] |= Bits(xvalue"'^zvalue) << (second+2*width);
+            }
+        }
+    }
+    return result;
+}
