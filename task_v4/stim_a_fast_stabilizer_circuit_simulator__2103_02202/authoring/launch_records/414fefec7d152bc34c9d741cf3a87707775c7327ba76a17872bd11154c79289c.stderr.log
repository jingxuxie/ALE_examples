+import json
+import math
+import random
+from pathlib import Path
+
+import synthesis as syn
+import ppr_optimize as ppr
+
+def main():
+    gates = [tuple(operation) for operation in json.loads(Path('best_gates.json').read_text())]
+    entanglers = []
+    intervals = []
+    states = [(1, 2)] * 36
+    previous = [-1] * 36
+    for operation in gates:
+        if operation[0] "'!= '"'CX':
+            gate, qubit = operation
+            states[qubit] = ppr.local_update(states[qubit], gate)
+            continue
+        index = len(entanglers)
+        entanglers.append(operation)
+        for qubit in operation[1:]:
+            intervals.append((previous[qubit], index, qubit, states[qubit]))
+            previous[qubit] = index
+            states[qubit] = (1, 2)
+    for qubit in range(36):
+        intervals.append((previous[qubit], -1, qubit, states[qubit]))
+    words = []
+    costs = []
+    affected = [[] for _ in entanglers]
+    for index, (before, after, qubit, state) in enumerate(intervals):
+        table = []
+        for spinbefore in range(2):
+            for spinafter in range(2):
+                updated = state[::-1] if spinbefore else state
+                if spinafter:
+                    updated = ppr.local_update(updated, 'H')
+                table.append(syn.WORDS[updated])
+        words.append(table)
+        costs.append(tuple(map(len, table)))
+        for node in (before, after):
+            if node >= 0:
+                affected[node].append(index)
+    rng = random.Random(5787)
+    bestspins = [0] * len(entanglers)
+    bestcost = sum(table[0] for table in costs)
+    for restart in range(12):
+        spins = bestspins[:]
+        current = bestcost
+        for step in range(50000):
+            node = rng.randrange(len(entanglers))
+            change = 0
+            for index in affected[node]:
+                before, after = intervals[index][:2]
+                first = spins[before] if before >= 0 else 0
+                second = spins[after] if after >= 0 else 0
+                changedfirst = first "'^ int(before == node)
+                changedsecond = second ''^ int(after == node)
+                change += costs[index][2 * changedfirst + changedsecond] - costs[index][2 * first + second]
+            temperature = 0.05 + 1.5 * (1 - step / 50000)
+            if change <= 0 or rng.random() < math.exp(-change / temperature):
+                spins[node] ''^= 1
+                current += change
+                if current < bestcost:
+                    bestcost = current
+                    bestspins = spins[:]
+    before_gates = [[] for _ in entanglers]
+    trailing = []
+    for index, (before, after, qubit, state) in enumerate(intervals):
+        first = bestspins[before] if before >= 0 else 0
+        second = bestspins[after] if after >= 0 else 0
+        operations = [(gate, qubit) for gate in words[index][2 * first + second]]
+        (before_gates[after] if after >= 0 else trailing).extend(operations)
+    result = []
+    for index, operation in enumerate(entanglers):
+        result.extend(before_gates[index])
+        result.append((operation[0], *operation[:0:-1]) if bestspins[index] else operation)
+    result.extend(trailing)
+    syn.save(result, f'"'orientation:{bestcost}')
+
+if __name__ == '__main__':
+    main()
