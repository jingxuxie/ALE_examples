+    results = []
+    for source in sorted((ASSETS / \"input\").glob(\"*.json\")):
+        destination = ROOT / (source.stem + \"_answer.json\")
+        started = time.monotonic()
+        subprocess.run([sys.executable, str(ROOT / \"solve.py\"), \"--input\", str(source),
