+            rounded[active] = np.round(relaxation.x[:-1])
+            rounded_score = float(np.max(constant + difference @ rounded))
+            if rounded_score < best_score:
+                best_score = rounded_score
+                best = {"selected": answer["selected"], "correction": rounded.astype(int).tolist()}
+            promising.append((relaxation.fun, answer, fixed_one, active, base, reduced))
+    promising.sort(key=lambda item: item[0])
+    for lower, answer, fixed_one, active, base, reduced in promising:
+        remaining = deadline - time.monotonic()
+        if remaining < 0.15:
+            break
+        if lower >= best_score - 1e-9:
+            continue
+        objective = np.zeros(reduced.shape[1] + 1)
+        objective[-1] = 1
+        integrality = np.ones(len(objective))
+        integrality[-1] = 0
+        constraints = np.column_stack((reduced, -np.ones(len(base))))
+        result = milp(objective, integrality=integrality,
+                      bounds=Bounds(np.zeros(len(objective)), np.ones(len(objective))),
+                      constraints=LinearConstraint(constraints, -np.inf, -base),
+                      options={"time_limit": min(0.45, remaining - 0.08),
+                               "mip_rel_gap": 1e-5, "presolve": True})
+        if result.x is not None:
+            table = fixed_one.astype(int)
+            table[active] = np.round(result.x[:-1]).astype(int)
+            score = float(np.max(base + reduced @ table[active]))
+            if score < best_score:
+                best_score = score
+                best = {"selected": answer["selected"], "correction": table.tolist()}
+    return {"selected": best["selected"], "correction": best["correction"]}
+
+
+def main():
+    started = time.monotonic()
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--input", required=True)
+    parser.add_argument("--output", required=True)
+    parser.add_argument("--seconds", type=float, default=40.5)
