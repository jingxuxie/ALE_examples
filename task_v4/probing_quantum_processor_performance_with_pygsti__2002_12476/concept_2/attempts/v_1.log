+        if time.monotonic() - start > 2400:
+            break
+        parameters = RNG.normal(0, 1, (3,5))
+        parameters[:,1:] *= .028 / np.linalg.norm(parameters[:,1:], axis=1)[:,None]
+        parameters[:,0] = RNG.uniform(-np.pi,np.pi,3)
+        parameters = calibrate(parameters.ravel())
+        word, result = circuit_search(parameters, generations=150)
+        initial_score = np.min(abs(result[:,:,0]))
+        print('trial',trial,'initial',initial_score, 'elapsed',time.monotonic()-start, flush=True)
+        best, measured = save_if_better(parameters, word, best)
+        for round_index in range(3):
+            parameters, opt = optimize(parameters, word, iterations=90)
