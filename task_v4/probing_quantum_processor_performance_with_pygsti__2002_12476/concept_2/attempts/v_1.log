+import os
+os.environ['OPENBLAS_NUM_THREADS'] = '1'
+os.environ['OMP_NUM_THREADS'] = '4'
+import ctypes
+import json
+import time
+from pathlib import Path
+import sys
+import numpy as np
+from scipy.optimize import minimize
+
+ROOT = Path(__file__).resolve().parent
+ASSETS = ROOT.parents[1] / 'participant'
+sys.path.insert(0, str(ASSETS / 'workspace'))
+from screen import FAMILIES, SPEC, operators, probabilities, encode, measure
+
+LIB = ctypes.CDLL(str(ROOT / 'fast.so'))
+LIB.batch.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_void_p, ctypes.c_int, ctypes.c_int, ctypes.c_void_p]
+CAL = np.array(encode(sum(FAMILIES.values(), [])), dtype=np.uint8)
+SLICES = []
+offset = 0
+for family in FAMILIES.values():
+    SLICES.append(slice(offset, offset + len(family)))
+    offset += len(family)
+SCALE = np.array([1., .02, .02, .02, .02] * 3)
+RNG = np.random.default_rng(236284)
+
+def evaluate(parameters, words):
+    parameters = np.ascontiguousarray(parameters, dtype=float).reshape(-1, 15)
+    words = np.ascontiguousarray(words, dtype=np.uint8)
+    output = np.empty((len(parameters), len(words), 3))
+    LIB.batch(parameters.ctypes.data, len(parameters), words.ctypes.data, len(words), words.shape[1], output.ctypes.data)
+    return output
+
+def scenarios(parameters):
+    result = np.tile(np.asarray(parameters).reshape(1, 3, 5), (5, 1, 1))
+    result[1, :, 1:] *= .98
+    result[2, :, 1:] *= 1.02
+    result[3, :, 0] -= .002
+    result[4, :, 0] += .002
+    return result.reshape(5, 15)
+
+def calibrate(parameters, margin=.91):
+    parameters = parameters.copy()
+    for iteration in range(3):
+        values = evaluate(scenarios(parameters), CAL)[:, :, 0]
+        ratio = max(np.max(np.abs(values)) / .005, max(np.max(np.sqrt(np.mean(values[:, group] ** 2, axis=1))) / .002 for group in SLICES))
+        parameters.reshape(3, 5)[:, 1:] *= min(1., np.sqrt(margin / max(ratio, 1e-15)))
+    return parameters
+
+def word_string(word):
+    return ''.join('IXY'[int(gate)] for gate in word)
+
+def witness(parameters, word):
+    return {'version': 1, 'gate_parameters': np.asarray(parameters).reshape(3, 5).tolist(), 'circuit': word_string(word)}
+
+def circuit_search(parameters, initial=None, generations=160, population=192, robust=False):
+    words = RNG.integers(0, 3, (population, 64), dtype=np.uint8)
+    for index in range(population // 2):
+        motif = RNG.integers(0, 3, RNG.integers(2, 13), dtype=np.uint8)
+        words[index] = np.resize(motif, 64)
+    if initial is not None:
+        words[:population // 2] = initial
+    params = scenarios(parameters) if robust else parameters
+    best_score = -np.inf
+    stagnation = 0
+    for generation in range(generations):
+        results = evaluate(params, words)
+        errors = np.min(np.abs(results[:, :, 0]), axis=0)
+        leakage = np.max(results[:, :, 1], axis=0)
+        fitness = errors - 2.5 * np.maximum(0., leakage - .0075) - .035 * leakage
+        legal = np.stack([(words == gate).sum(axis=1) >= 4 for gate in range(3)]).all(axis=0)
+        fitness[~legal] -= .2
+        order = np.argsort(-fitness)
+        if fitness[order[0]] > best_score + 1e-10:
+            best_score = fitness[order[0]]
+            best_word = words[order[0]].copy()
+            stagnation = 0
+        else:
+            stagnation += 1
+        elites = words[order[:max(8, population // 12)]].copy()
+        parent = RNG.integers(0, len(elites), population)
+        words = elites[parent].copy()
+        changes = RNG.choice([1, 2, 3, 5, 9, 16], population, p=[.4,.25,.15,.1,.06,.04])
+        for repeat in range(16):
+            indices = np.flatnonzero(changes > repeat)
+            positions = RNG.integers(0, 64, len(indices))
+            words[indices, positions] = (words[indices, positions] + RNG.integers(1, 3, len(indices))) % 3
+        for index in range(population // 8):
+            left, right = np.sort(RNG.integers(0, 64, 2))
+            words[index, left:right] = np.roll(words[index, left:right], RNG.integers(1, 10))
+        words[-len(elites):] = elites
+        if stagnation > 45:
+            words[:population // 4] = RNG.integers(0, 3, (population // 4, 64))
+    result = evaluate(scenarios(parameters), best_word[None])[..., :2]
+    return best_word, result
+
+class Continuous:
+    def __init__(self, word, sign):
+        self.words = np.full((len(CAL)+1, max(64, CAL.shape[1])), 3, dtype=np.uint8)
+        self.words[:-1, :CAL.shape[1]] = CAL
+        self.words[-1, :64] = word
+        self.sign = sign
+        self.last = None
+
+    def calculate(self, normalized):
+        if self.last is not None and np.array_equal(normalized, self.last):
+            return
+        self.last = normalized.copy()
+        epsilon = 2e-5
+        steps = np.eye(15) * epsilon
+        xs = np.vstack([normalized, normalized + steps, normalized - steps])
+        ps = np.vstack([scenarios(row * SCALE) for row in xs])
+        values = evaluate(ps, self.words).reshape(31, 5, len(self.words), 3)
+        calibration = values[:, :, :-1, 0]
+        constraints = [(1 - (calibration / .00496)**2).reshape(31, -1)]
+        constraints.append(np.stack([1 - np.mean(calibration[:, :, group]**2, axis=2) / .001985**2 for group in SLICES], axis=2).reshape(31, -1))
+        constraints.append(1 - values[:, :, -1, 1] / .0098)
+        constraints.append(1 - np.sum(xs.reshape(31, 3, 5)[:, :, 1:]**2, axis=2) / 4.)
+        constraints = np.concatenate(constraints, axis=1)
+        errors = self.sign * values[:, :, -1, 0]
+        objective = -np.mean(errors, axis=1) / .1
+        self.fun = objective[0]
+        self.jac = (objective[1:16] - objective[16:]) / (2 * epsilon)
+        self.cons = constraints[0]
+        self.cjac = ((constraints[1:16] - constraints[16:]) / (2 * epsilon)).T
+
+    def objective(self, normalized):
+        self.calculate(normalized)
+        return self.fun, self.jac
+
+    def constraints(self, normalized):
+        self.calculate(normalized)
+        return self.cons
+
+    def constraint_jacobian(self, normalized):
+        self.calculate(normalized)
+        return self.cjac
+
+def optimize(parameters, word, iterations=100):
+    result = evaluate(parameters, word[None])[0,0,0]
+    problem = Continuous(word, np.sign(result))
+    bounds = [(-np.pi, np.pi), (-2,2), (-2,2), (-2,2), (-2,2)] * 3
+    opt = minimize(problem.objective, parameters / SCALE, jac=True, method='SLSQP', bounds=bounds,
+                   constraints={'type':'ineq', 'fun':problem.constraints, 'jac':problem.constraint_jacobian},
+                   options={'maxiter':iterations, 'ftol':1e-9})
+    return opt.x * SCALE, opt
+
+def save_if_better(parameters, word, best):
+    data = witness(parameters, word)
