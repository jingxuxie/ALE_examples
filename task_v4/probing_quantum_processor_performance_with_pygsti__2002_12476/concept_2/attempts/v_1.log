+        result = measure(data)
+    except ValueError:
+        return best, None
+    eligible = result['calibration_accepted'] and all(row['final_leakage'] <= .01 for row in result['scenarios'])
+    score = result['worst_family_score']
+    if eligible and score > best:
+        (ROOT / 'witness.json').write_text(json.dumps(data, indent=2) + '\\n')
+        (ROOT / 'best_measurement.json').write_text(json.dumps(result, indent=2) + '\\n')
+        print('BEST', score, 'nominal', result['core_score'], 'passed', result['passed'], flush=True)
+        best = score
+    return best, result
+
+def main():
+    start = time.monotonic()
+    parameters = RNG.normal(0, .009, (3,5))
+    parameters[:,0] = RNG.uniform(-np.pi,np.pi,3)
+    values = evaluate(parameters, CAL)[0]
