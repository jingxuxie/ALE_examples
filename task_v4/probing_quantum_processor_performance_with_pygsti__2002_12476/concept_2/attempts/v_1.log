+            if measured is not None:
+                print('optimized', round_index, opt.success, opt.message, measured['worst_family_score'], measured['calibration_accepted'], max(row['final_leakage'] for row in measured['scenarios']), 'elapsed', time.monotonic()-start, flush=True)
+            if best > .10:
