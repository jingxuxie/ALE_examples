+#include <complex>
+#include <cmath>
+#include <cstdint>
+#include <array>
+#include <omp.h>
+using Complex = std::complex<double>;
+
+struct Gates {
+    Complex unitary[3][9];
+    double transfer[3][16];
+};
+
+void build(const double* parameters, Gates& gates) {
+    const Complex imaginary(0,1);
+    const double root = std::sqrt(.5);
+    Complex ideals[3][4] = {{1.,0.,0.,1.},{root,-imaginary*root,-imaginary*root,root},{root,-root,root,root}};
+    Complex paulis[4][4] = {{1.,0.,0.,1.},{0.,1.,1.,0.},{0.,-imaginary,imaginary,0.},{1.,0.,0.,-1.}};
+    for (int gate=0;gate<3;gate++) {
+        const double* row=parameters+5*gate;
+        Complex coupling[2] = {Complex(row[1],row[2]),Complex(row[3],row[4])};
+        double radius=std::sqrt(std::norm(coupling[0])+std::norm(coupling[1]));
+        double sinc=radius>1e-10 ? std::sin(radius)/radius : 1.;
+        double cosine=radius>1e-7 ? (std::cos(radius)-1)/(radius*radius) : -.5;
+        Complex phase=std::exp(-imaginary*row[0]);
+        Complex mixing[9]={};
+        for (int left=0;left<2;left++) for(int right=0;right<2;right++)
+            mixing[3*left+right]=(left==right?1.:0.)+cosine*coupling[left]*std::conj(coupling[right]);
+        for(int index=0;index<2;index++) {
+            mixing[3*index+2]=-imaginary*sinc*coupling[index];
+            mixing[6+index]=-imaginary*sinc*std::conj(coupling[index]);
+        }
+        mixing[8]=std::cos(radius);
+        Complex* unitary=gates.unitary[gate];
+        for(int left=0;left<3;left++) {
+            for(int right=0;right<2;right++) unitary[3*left+right]=mixing[3*left]*ideals[gate][right]+mixing[3*left+1]*ideals[gate][2+right];
+            unitary[3*left+2]=mixing[3*left+2]*phase;
+        }
+        for(int source=0;source<4;source++) {
+            Complex image[4]={};
+            for(int left=0;left<2;left++) for(int right=0;right<2;right++)
+                for(int inner=0;inner<2;inner++) for(int other=0;other<2;other++)
+                    image[2*left+right]+=unitary[3*left+inner]*paulis[source][2*inner+other]*std::conj(unitary[3*right+other]);
+            for(int inner=0;inner<2;inner++) for(int other=0;other<2;other++)
+                image[3]+=unitary[6+inner]*paulis[source][2*inner+other]*std::conj(unitary[6+other]);
+            for(int target=0;target<4;target++) {
+                Complex value=0.;
+                for(int left=0;left<2;left++) for(int right=0;right<2;right++) value+=paulis[target][2*left+right]*image[2*right+left];
+                gates.transfer[gate][4*target+source]=.5*value.real();
+            }
+        }
+    }
+}
+
+void evaluate(const Gates& gates,const uint8_t* words,int count,int length,double* output) {
+    for(int word=0;word<count;word++) {
+        Complex state[3]={1.,0.,0.};
+        double bloch[4]={1.,0.,0.,1.};
+        for(int position=0;position<length;position++) {
+            int gate=words[word*length+position];
+            if(gate==3) break;
+            const Complex* unitary=gates.unitary[gate];
+            const double* transfer=gates.transfer[gate];
+            Complex next[3];
+            double next_bloch[4];
+            for(int target=0;target<3;target++) next[target]=unitary[3*target]*state[0]+unitary[3*target+1]*state[1]+unitary[3*target+2]*state[2];
+            for(int target=0;target<4;target++) next_bloch[target]=transfer[4*target]*bloch[0]+transfer[4*target+1]*bloch[1]+transfer[4*target+2]*bloch[2]+transfer[4*target+3]*bloch[3];
+            for(int target=0;target<3;target++) state[target]=next[target];
+            for(int target=0;target<4;target++) bloch[target]=next_bloch[target];
+        }
+        output[3*word]=.99*(std::norm(state[0])-(bloch[0]+bloch[3])*.5);
+        output[3*word+1]=std::norm(state[2]);
+        output[3*word+2]=.005+.99*(bloch[0]+bloch[3])*.5;
+    }
+}
+
+extern \"C\" void batch(const double* parameters,int parameter_count,const uint8_t* words,int count,int length,double* output) {
+    #pragma omp parallel for schedule(static) num_threads(4) if(parameter_count>1)
+    for(int sample=0;sample<parameter_count;sample++) {
+        Gates gates;
+        build(parameters+15*sample,gates);
+        evaluate(gates,words,count,length,output+sample*count*3);
+    }
+}
