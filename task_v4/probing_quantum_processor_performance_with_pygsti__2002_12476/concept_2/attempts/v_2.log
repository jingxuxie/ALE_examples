import math
import stat
import time
from pathlib import Path

import numpy as np


INPUT = Path(__file__).resolve().parents[1] / "input"
SPEC = json.loads((INPUT / "specification.json").read_text())
FAMILIES = json.loads((INPUT / "calibration.json").read_text())
