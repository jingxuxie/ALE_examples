            variants.append({"name": f"global-{horizon}-{decay}-{tie}", "horizon": horizon,
                             "decay": decay, "tie": tie, "mode": "weighted"})
    variants.append({"name": "suffix-embedding", "horizon": 0, "decay": 1.0,
