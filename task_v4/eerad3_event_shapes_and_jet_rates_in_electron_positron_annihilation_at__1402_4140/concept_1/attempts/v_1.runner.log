+import numpy as np
+
+METRIC = np.array([1., -1., -1., -1.])
+GAMMA = np.zeros((4, 4, 4), dtype=complex)
+GAMMA[0] = np.diag([1, 1, -1, -1])
+PAULI = np.array([[[0, 1], [1, 0]], [[0, -1j], [1j, 0]], [[1, 0], [0, -1]]])
+for axis in range(3):
+    GAMMA[axis + 1, :2, 2:] = PAULI[axis]
+    GAMMA[axis + 1, 2:, :2] = -PAULI[axis]
+
+
+def dot(left, right):
+    return np.sum(left * right * METRIC, axis=-1)
+
+
+def slash(momentum):
+    return np.einsum('...m,mab->...ab', momentum * METRIC, GAMMA)
+
+
+def vertex(left, right, left_p, right_p):
+    return (dot(left, right)[..., None] * (left_p - right_p)
+            + dot(left_p + 2 * right_p, left)[..., None] * right
+            - dot(2 * left_p + right_p, right)[..., None] * left)
+
+
+def polarizations(momentum):
+    direction = momentum[:, 1:] / momentum[:, :1]
+    axis = np.zeros_like(direction)
+    axis[np.arange(len(axis)), np.argmin(abs(direction), axis=1)] = 1
+    first = np.cross(direction, axis)
+    first /= np.linalg.norm(first, axis=1)[:, None]
+    second = np.cross(direction, first)
+    return [np.column_stack([np.zeros(len(axis)), vector]) for vector in [first, second]]
+
+
+def calculate(p, order=(0, 2, 3, 4, 1), sign3=1, sign4=1, gauge=-1):
+    momenta = p[:, order, :][:, :, [3, 0, 1, 2]]
+    quark = momenta[:, 0]
+    anti = momenta[:, -1]
+    gluons = momenta[:, 1:-1]
+    total = momenta.sum(axis=1)
+    count = len(gluons[0])
+    pols = [polarizations(gluons[:, index]) for index in range(count)]
+    momentum = {}
+    for start in range(count):
+        for stop in range(start + 1, count + 1):
+            momentum[start, stop] = gluons[:, start:stop].sum(axis=1)
+    partitions = [[(0, 1), (1, 2), (2, 3)], [(0, 2), (2, 3)], [(0, 1), (1, 3)], [(0, 3)]]
+    result = np.zeros(len(p))
+    for helicity in range(2 ** count):
+        current = {}
+        for start in range(count):
+            current[start, start + 1] = (gluons[:, start] if gauge == start
+                                        else pols[start][(helicity >> start) & 1])
+        for size in range(2, count + 1):
+            for start in range(count - size + 1):
+                stop = start + size
+                value = np.zeros_like(quark)
+                for middle in range(start + 1, stop):
+                    value += sign3 * vertex(current[start, middle], current[middle, stop],
+                                            momentum[start, middle], momentum[middle, stop])
+                if size == 3:
+                    first, second, third = [current[index, index + 1] for index in range(start, stop)]
+                    value += sign4 * (2 * second * dot(first, third)[:, None]
+                                      - first * dot(second, third)[:, None]
+                                      - third * dot(first, second)[:, None])
+                current[start, stop] = value / dot(momentum[start, stop], momentum[start, stop])[:, None]
+        for mu in range(4):
+            amplitude = np.zeros((len(p), 4, 4), dtype=complex)
+            for partition in partitions:
+                for insertion in range(len(partition) + 1):
+                    chain = np.broadcast_to(np.eye(4), (len(p), 4, 4)).copy().astype(complex)
+                    running = quark.copy()
+                    for index in range(len(partition) + 1):
+                        if index == insertion:
+                            chain = chain @ GAMMA[mu]
+                            running -= total
+                        else:
+                            block = partition[index if index < insertion else index - 1]
+                            chain = chain @ slash(current[block])
+                            running += momentum[block]
+                        if index < len(partition):
+                            chain = chain @ (slash(running) / dot(running, running)[:, None, None])
+                    amplitude += chain
+            conjugate = GAMMA[0] @ amplitude.conj().swapaxes(-1, -2) @ GAMMA[0]
+            trace = np.trace(slash(quark) @ amplitude @ slash(anti) @ conjugate, axis1=-2, axis2=-1).real
+            result -= METRIC[mu] * trace
+    return result
+
+
+if __name__ == '__main__':
+    from pathlib import Path
