+def polarizations(momentum):
+    axis=np.zeros_like(momentum)
+    axis[:,1]=1
+    first=np.cross(momentum[:,1:],axis[:,1:])
+    first/=np.linalg.norm(first,axis=1)[:,None]
+    second=np.cross(momentum[:,1:],first)/momentum[:,:1]
+    zero=np.zeros((len(momentum),1))
