+import numpy as np
+from itertools import product
+
+metric = np.array([1.,-1.,-1.,-1.])
+identity = np.eye(4,dtype=complex)
+pauli = np.array([[[0,1],[1,0]],[[0,-1j],[1j,0]],[[1,0],[0,-1]]])
+gamma = np.zeros((4,4,4),complex)
+gamma[0,:2,2:] = np.eye(2)
+gamma[0,2:,:2] = np.eye(2)
+gamma[1:,:2,2:] = pauli
+gamma[1:,2:,:2] = -pauli
+
+def dot(left,right):
+    return np.sum(left*right*metric,axis=-1)
+
+def slash(vector):
+    return np.einsum('...m,mij->...ij',vector*metric,gamma)
+
+def vertex(left,right,pleft,pright):
+    return (2*dot(pright,left)[...,None]*right
+            -2*dot(pleft,right)[...,None]*left
+            +dot(left,right)[...,None]*(pleft-pright))
+
+def amplitude(momentum,pol,sign3=1,sign4=1):
+    count=len(pol)
