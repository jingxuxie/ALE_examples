+                    value+=sign4*(2*middle*dot(first,last)[...,None]-first*dot(middle,last)[...,None]-last*dot(first,middle)[...,None])
+            currents[start,end]=value/dot(total,total)[...,None]
+    left={0:np.broadcast_to(identity,(batch,4,4))}
+    for end in range(1,count+1):
