  "locked": false,
  "title": "spectrum: new interface and zero-finding algorithm",
  "user": {
    "login": "vasdommes",
    "id": 8809142,
    "node_id": "MDQ6VXNlcjg4MDkxNDI=",
    "avatar_url": "https://avatars.githubusercontent.com/u/8809142?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/vasdommes",
    "html_url": "https://github.com/vasdommes",
    "followers_url": "https://api.github.com/users/vasdommes/followers",
    "following_url": "https://api.github.com/users/vasdommes/following{/other_user}",
    "gists_url": "https://api.github.com/users/vasdommes/gists{/gist_id}",
