{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adaptive Cascade policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "max_passes",
    "schedule",
    "rules"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "max_passes": {
      "type": "integer",
      "minimum": 4,
      "maximum": 20
    },
    "schedule": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "size": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "basis",
              "scale",
              "round"
            ],
            "properties": {
              "basis": {
                "enum": [
                  "estimate",
                  "first",
                  "frame",
                  "paper_first",
                  "paper_second",
                  "parity",
                  "remaining"
                ]
              },
              "scale": {
                "type": "number",
                "minimum": 0.0625,
                "maximum": 16
              },
              "round": {
                "enum": [
                  "ceil",
                  "floor",
                  "nearest"
                ]
              }
            }
          },
          "reuse": {
            "enum": [
              "all",
              "roots",
              "recent"
            ]
          },
          "batch": {
            "enum": [
              "pass",
              "smallest"
            ]
          },
          "stop": {
            "const": false
          }
        },
        "required": [
          "size",
          "reuse",
          "batch",
          "stop"
        ]
      }
    },
    "rules": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "when",
          "action"
        ],
        "properties": {
          "when": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "prefixItems": [
                {
                  "enum": [
                    "corrected_fraction",
                    "estimate_ratio",
                    "first_size",
                    "frame_bits",
                    "known_per_bit",
                    "last_corrected_fraction",
                    "last_leak_fraction",
                    "last_odd_fraction",
                    "last_rounds",
                    "latency",
                    "parity_est",
                    "pass_index",
                    "q_est",
                    "q_se",
                    "quiet_passes",
                    "sample_size"
                  ]
                },
                {
                  "enum": [
                    "lt",
                    "le",
                    "gt",
                    "ge"
                  ]
                },
                {
                  "type": "number"
                }
              ]
            }
          },
          "action": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "size": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "basis",
                  "scale",
                  "round"
                ],
                "properties": {
                  "basis": {
                    "enum": [
                      "estimate",
                      "first",
                      "frame",
                      "paper_first",
                      "paper_second",
                      "parity",
                      "remaining"
                    ]
                  },
                  "scale": {
                    "type": "number",
                    "minimum": 0.0625,
                    "maximum": 16
                  },
                  "round": {
                    "enum": [
                      "ceil",
                      "floor",
                      "nearest"
                    ]
                  }
                }
              },
              "reuse": {
                "enum": [
                  "all",
                  "roots",
                  "recent"
                ]
              },
              "batch": {
                "enum": [
                  "pass",
                  "smallest"
                ]
              },
              "stop": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
