{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "4096-pair static inverse EEC witness",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "a"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "a": {
      "type": "array", "minItems": 4096, "maxItems": 4096,
      "items": {"type": "integer", "enum": [0, 1, 2]},
      "allOf": [
        {"contains": {"const": 0}, "minContains": 3328, "maxContains": 3328},
        {"contains": {"const": 1}, "minContains": 512, "maxContains": 512},
        {"contains": {"const": 2}, "minContains": 256, "maxContains": 256}
      ]
    }
  }
}
