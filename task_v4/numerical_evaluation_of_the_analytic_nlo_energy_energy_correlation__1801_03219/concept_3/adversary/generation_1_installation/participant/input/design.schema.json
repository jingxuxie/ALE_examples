{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Static antipodal ternary energy-flow witness",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "a"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "a": {
      "type": "array",
      "minItems": 512,
      "maxItems": 512,
      "items": {"type": "integer", "enum": [0, 1, 2]},
      "allOf": [
        {"contains": {"const": 0}, "minContains": 416, "maxContains": 416},
        {"contains": {"const": 1}, "minContains": 64, "maxContains": 64},
        {"contains": {"const": 2}, "minContains": 32, "maxContains": 32}
      ]
    }
  },
  "$comment": "check.py additionally enforces integer-token syntax, duplicate-key rejection, byte limits, cyclic spacing and all exact target lags. JSON Schema alone cannot express these conditions."
}
