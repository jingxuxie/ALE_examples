+        names.append(name)
+        prediction.append(np.load(path)['alpha2f'])
+prediction=np.array(prediction)
+for name,values in zip(names,prediction):
+    loss,_=case_metrics(values,labels['alpha2f'],inputs)
+    print(name,100*np.exp(-loss.mean()),flush=True)
+def objective(weights,selected):
+    values=np.einsum('m,mbj->bj',weights,prediction)
+    loss,_=case_metrics(values,labels['alpha2f'],inputs)
+    return loss[selected].mean()
+for selected in [np.arange(512),np.arange(0,512,2),np.arange(1,512,2)]:
