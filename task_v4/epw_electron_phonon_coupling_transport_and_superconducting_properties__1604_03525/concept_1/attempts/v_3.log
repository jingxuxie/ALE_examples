+    initial[names.index('4')]=.5
+    fit=minimize(lambda weights:objective(weights,selected),initial,method='SLSQP',bounds=[(0,1)]*len(names),constraints=[{'type':'eq','fun':lambda weights:weights.sum()-1}],options={'maxiter':200,'ftol':1e-10})
