+        posterior_median[selected]=np.diff(cdf,axis=1,prepend=np.zeros((len(selected),1)))
+        offset+=count
+        print('family',code,'rows',len(selected),'seconds',time.time()-start,flush=True)
+    for name,probability in [('mean',posterior_mean),('median',posterior_median),('blend',.5*(posterior_mean+posterior_median))]:
+        probability=np.maximum(probability,0)
+        probability/=probability.sum(1)[:,None]
+        prediction=probability*coupling[:,None]*omega/1.25
+        loss,errors=case_metrics(prediction,labels['alpha2f'],inputs)
+        print(name,100*np.exp(-loss.mean()),[100*np.exp(-loss[labels['family']==code].mean()) for code in range(4)],errors.mean(0),flush=True)
