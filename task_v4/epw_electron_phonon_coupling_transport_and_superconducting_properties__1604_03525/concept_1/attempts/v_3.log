+import os
+os.environ['OPENBLAS_NUM_THREADS']='1'
+os.environ['OMP_NUM_THREADS']='4'
+import time
+import argparse
+import numpy as np
+import torch
+from torch import nn
+from learn import load,evaluate,Net
+
+torch.set_num_threads(4)
+
+
+class ResidualNet(Net):
+    def __init__(self,features_count,center,scale,basis,width=256):
+        super().__init__(features_count,width)
+        self.register_buffer('center',center)
+        self.register_buffer('scale',scale)
+        self.register_buffer('basis',basis)
+
+    def forward(self,features):
+        original=features*self.scale+self.center
+        initial=original[:,40:104]@self.basis.T
+        return torch.softmax(self.layers(features)+initial.clamp_min(1e-7).log(),dim=-1)
+
+
+def main():
+    parser=argparse.ArgumentParser()
+    parser.add_argument('--seed',type=int,default=5)
+    parser.add_argument('--epochs',type=int,default=180)
+    parser.add_argument('--width',type=int,default=256)
+    args=parser.parse_args()
+    torch.manual_seed(args.seed)
+    cache=dict(np.load('nnls_features.npz'))
+    prior=dict(np.load('prior.npz'))
+    train,labels=load('train_input'),load('train_labels')
+    validation,val_labels=load('validation_input'),load('validation_labels')
+    train_x=torch.tensor(cache['train'])
+    center=train_x.mean(0)
+    scale=train_x.std(0).clamp_min(.003)
+    train_x=(train_x-center)/scale
+    val_x=torch.tensor(cache['validation'])
+    indices=torch.tensor(cache['indices'])
+    mass=labels['alpha2f']/train['omega_mev']
+    target=torch.tensor(mass/mass.sum(1)[:,None],dtype=torch.float32)
+    target_cdf=target.cumsum(1)
+    log_omega=torch.tensor(np.log(train['omega_mev']),dtype=torch.float32)
+    target_log=target@log_omega
+    metric=torch.tensor(np.r_[5.5*np.diff(np.log(train['omega_mev']))+np.diff(train['omega_mev'])/30,0],dtype=torch.float32)
+    coupling=(prior['mean']+cache['validation'][:,:40]@prior['basis'].T).sum(1)
+    model=ResidualNet(train_x.shape[1],center,scale,torch.tensor(cache['basis'],dtype=torch.float32),args.width)
+    optimizer=torch.optim.AdamW(model.parameters(),lr=.0007,weight_decay=.002)
+    scheduler=torch.optim.lr_scheduler.CosineAnnealingLR(optimizer,args.epochs,eta_min=.00002)
+    best=100
+    start=time.time()
+    for epoch in range(args.epochs):
+        total=0
+        for selected in torch.randperm(len(train_x)).split(256):
+            label=indices[selected]
+            probability=model(train_x[selected])
+            loss=(torch.sqrt((probability.cumsum(1)-target_cdf[label]).square()+1e-7)*metric).sum(1).mean()
+            loss+=2.5*torch.sqrt((probability@log_omega-target_log[label]).square()+1e-6).mean()
+            optimizer.zero_grad()
+            loss.backward()
+            optimizer.step()
+            total+=loss.item()*len(selected)/len(train_x)
+        scheduler.step()
+        if epoch%5==0 or epoch==args.epochs-1:
+            loss,scores,prediction,errors=evaluate(model,val_x,scale,center,coupling,val_labels,validation)
+            print(epoch,round(time.time()-start,1),'train',round(total,4),'score',round(100*np.exp(-loss),3),np.round(scores,2),np.round(errors,5),flush=True)
+            if loss<best:
+                best=loss
+                torch.save(dict(state=model.state_dict(),center=center,scale=scale,width=args.width,nnls=True),'model%d.pt'%args.seed)
+                np.savez('model%d_validation.npz'%args.seed,alpha2f=prediction)
