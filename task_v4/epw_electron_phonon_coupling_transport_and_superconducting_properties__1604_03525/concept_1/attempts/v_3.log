+def make_prior():
+    inputs = load('train_input')
+    labels = load('train_labels')
+    omega = inputs['omega_mev']
+    mass = labels['alpha2f'] * (2 * inputs['domega_mev'] / omega)
+    mean = mass.mean(0)
+    cumulative = np.cumsum(mass - mean, axis=1)
+    weight = np.sqrt(np.r_[5.5 * np.diff(np.log(omega)) + np.diff(omega) / 30, .02])
+    _, singular, vectors = la.svd(cumulative * weight, full_matrices=False)
+    basis_cdf = vectors[:40].T * singular[:40] / np.sqrt(len(mass) - 1) / weight[:, None]
+    basis = np.diff(basis_cdf, axis=0, prepend=np.zeros((1, 40)))
+    np.savez(ROOT / 'prior.npz', mean=mean, basis=basis, omega=omega)
+    return mean, basis
