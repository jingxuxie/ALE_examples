+import torch
+from torch import nn
+
+
+class MixtureNet(nn.Module):
+    def __init__(self,features_count,width=256):
+        super().__init__()
+        self.layers=nn.Sequential(nn.Linear(features_count,width),nn.SiLU(),nn.Linear(width,width),nn.SiLU(),nn.Linear(width,width),nn.SiLU(),nn.Linear(width,27))
+        self.register_buffer('omega',.3125+.625*torch.arange(192))
+        self.register_buffer('lower',torch.tensor([2.5,10,20,25,40,65]))
+        self.register_buffer('upper',torch.tensor([15,40,55,70,100,112]))
+
+    def forward(self,features):
+        params=self.layers(features)
+        scale=5+35*torch.sigmoid(params[:,0])
+        power=1.8+2.7*torch.sigmoid(params[:,1])
+        centers=self.lower+(self.upper-self.lower)*torch.sigmoid(params[:,2:8])
+        widths=.8+18*torch.sigmoid(params[:,8:14])
+        skew=.5*torch.tanh(params[:,14:20])
+        weights=torch.softmax(params[:,20:],dim=-1)
+        acoustic=self.omega[None,:]*torch.exp(-(self.omega[None,:]/scale[:,None])**power[:,None])
+        standardized=(self.omega[None,:,None]-centers[:,None,:])/widths[:,None,:]
+        optical=torch.exp(-.5*standardized.square())*(1+skew[:,None,:]*torch.tanh(standardized))*(self.omega/(self.omega.square()+4))[None,:,None]
+        bands=torch.cat((acoustic[:,:,None],optical),dim=-1)
+        bands=bands/bands.sum(1,keepdim=True).clamp_min(1e-20)
+        return (bands*weights[:,None,:]).sum(-1)
