+import os
+os.environ['OPENBLAS_NUM_THREADS'] = '1'
+os.environ['OMP_NUM_THREADS'] = '1'
+import time
+import numpy as np
+from scipy.optimize import least_squares
+from scipy.signal import find_peaks, peak_widths
+
+OMEGA = .3125 + .625*np.arange(192)
+
+
+def bands(params, count):
+    scale, power = params[:2]
+    acoustic = OMEGA * np.exp(-(OMEGA / scale)**power)
+    centers = params[2:2+count]
+    widths = params[2+count:2+2*count]
+    skews = params[2+2*count:2+3*count]
+    standardized = (OMEGA[:, None] - centers) / widths
+    optical = np.exp(-.5*standardized**2) * (1+skews*np.tanh(standardized)) * (OMEGA/(OMEGA**2+4))[:, None]
+    shapes = np.column_stack((acoustic, optical))
+    shapes /= shapes.sum(0)
+    return shapes
+
+
+def fit_one(target, family):
+    count = 2 if family == 0 else 3
+    density = target * OMEGA
+    peaks, _ = find_peaks(density, prominence=density.max()*.015)
+    peak_width = peak_widths(density, peaks)[0] * .625/2.355
+    ranges = [[(21,49),(48,95)],[(2.5,13),(16,49),(49,108)],[(20,52),(29,66),(64,112)],[(8,38),(32,70),(62,113)]][family]
+    centers, widths = [], []
+    for lower, upper in ranges:
+        selected = np.flatnonzero((OMEGA[peaks]>=lower)&(OMEGA[peaks]<=upper))
+        if len(selected):
+            chosen = selected[np.argmax(density[peaks[selected]])]
+            centers.append(OMEGA[peaks[chosen]])
+            widths.append(np.clip(peak_width[chosen],1.3,14))
+        else:
+            centers.append((lower+upper)/2)
+            widths.append(5)
+    if family == 2 and centers[1] <= centers[0]+1:
+        strongest = centers[0]
+        centers[0], centers[1] = strongest-4,strongest+4
+        widths[:2] = [3,3]
+    amplitude = np.log(np.maximum(target[:10]/OMEGA[:10],1e-20))
+    def fit_acoustic(params):
+        return params[0] - (OMEGA[:10]/params[1])**params[2] - amplitude
+    fit = least_squares(fit_acoustic, [-9,18,3], bounds=([-20,5,1.5],[0,40,5]), max_nfev=50)
+    initial = [fit.x[1],fit.x[2]] + centers + widths + [0]*count + [1/(count+1)]*(count+1)
+    low = [5,1.5] + [item[0] for item in ranges] + [1]*count + [-.7]*count + [0]*(count+1)
+    high = [45,5] + [item[1] for item in ranges] + [20]*count + [.7]*count + [1]*(count+1)
+    initial = np.clip(initial, np.array(low)+1e-6,np.array(high)-1e-6)
+    def residual(params):
+        prediction = bands(params, count) @ params[2+3*count:]
+        return (prediction - target) / np.sqrt(.002+target)
+    fit = least_squares(residual, initial, bounds=(low,high), max_nfev=160, ftol=2e-7, xtol=2e-7, gtol=1e-7)
+    return fit.x, np.linalg.norm(fit.fun), bands(fit.x,count) @ fit.x[2+3*count:]
+
+
+def main():
+    labels = np.load('../../participant/input/train_labels.npz')
+    masses = labels['alpha2f'] / OMEGA
+    masses /= masses.sum(1)[:,None]
+    params = np.zeros((len(masses),18))
+    errors = np.zeros(len(masses))
+    predicted = np.zeros_like(masses)
+    start = time.time()
+    for row in range(len(masses)):
+        fitted,error,prediction=fit_one(masses[row],labels['family'][row])
+        params[row,:len(fitted)]=fitted
+        errors[row]=error
+        predicted[row]=prediction
+        if row%128==0:
+            print(row, round(time.time()-start,1), np.quantile(errors[:row+1],[.5,.9,.99]),flush=True)
+            np.savez('population.npz', params=params, errors=errors, probability=predicted, family=labels['family'], completed=row+1)
+    np.savez('population.npz', params=params, errors=errors, probability=predicted, family=labels['family'], completed=len(masses))
+
+
+if __name__ == '__main__':
+    main()
