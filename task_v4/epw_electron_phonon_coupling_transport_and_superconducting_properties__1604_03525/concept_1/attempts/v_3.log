+import os
+os.environ['OPENBLAS_NUM_THREADS']='1'
+os.environ['OMP_NUM_THREADS']='4'
+import numpy as np
+import torch
+from learn import load,Net
+from physics import case_metrics
+
+inputs,labels=load('validation_input'),load('validation_labels')
+cache=dict(np.load('features.npz'))
+prior=dict(np.load('prior.npz'))
+omega=inputs['omega_mev']
+coupling=(prior['mean']+cache['val_observed']@prior['basis'].T).sum(1)
+features=torch.tensor(np.concatenate((cache['val_observed'],cache['val_extra']),axis=1))
+
+
+def score(probability,name):
+    prediction=probability*coupling[:,None]*omega/1.25
+    loss,errors=case_metrics(prediction,labels['alpha2f'],inputs)
+    print(name,round(100*np.exp(-loss.mean()),4),[round(100*np.exp(-loss[labels['family']==family].mean()),2) for family in range(4)],np.round(errors.mean(0),5),flush=True)
+    return loss.mean()
+
+
+predictions={}
+for index in range(1,13):
+    if not os.path.exists('model%d_validation.npz'%index):
+        continue
+    mass=np.load('model%d_validation.npz'%index)['alpha2f']*1.25/omega
+    probability=mass/mass.sum(1)[:,None]
+    predictions[index]=probability
+    score(probability,str(index))
+    if index not in [6,8]:
+        continue
+    saved=torch.load('model%d.pt'%index,map_location='cpu',weights_only=False)
+    if saved.get('param_experts'):
+        from param_experts import ParamExpertNet
+        model=ParamExpertNet(130,saved['width'])
+    else:
+        from experts import ExpertNet
+        model=ExpertNet(130,saved['width'])
+    model.load_state_dict(saved['state'])
+    feature=features@saved.get('transform',torch.eye(130))
+    with torch.no_grad():
+        probability,logits=model.components((feature-saved['center'])/saved['scale'])
+    probability,logits=probability.numpy(),logits.numpy()
+    print('classification',index,np.mean(logits.argmax(1)==labels['family']),flush=True)
+    score(probability[np.arange(len(probability)),labels['family']],str(index)+'oracle')
+    for temperature in [.25,.5,.75,1,1.5,2]:
+        weights=np.exp((logits-logits.max(1)[:,None])/temperature)
+        weights/=weights.sum(1)[:,None]
+        score((probability*weights[:,:,None]).sum(1),str(index)+'temp'+str(temperature))
+    cdf=probability.cumsum(-1)
+    sorted_indices=np.argsort(cdf,axis=1)
+    sorted_cdf=np.take_along_axis(cdf,sorted_indices,axis=1)
+    weights=np.exp(logits-logits.max(1)[:,None]); weights/=weights.sum(1)[:,None]
+    sorted_weight=np.take_along_axis(np.broadcast_to(weights[:,:,None],cdf.shape),sorted_indices,axis=1)
+    median=np.take_along_axis(sorted_cdf,(sorted_weight.cumsum(1)>=.5).argmax(1)[:,None,:],axis=1)[:,0]
+    median=np.diff(median,axis=1,prepend=np.zeros((len(median),1)))
+    score(median,str(index)+'median')
+for indices in [[1,2],[2,4],[2,4,7],[2,3,4,6],[2,4,6,8],[1,2,3,4,5,6,7,8]]:
+    if all(index in predictions for index in indices):
+        score(np.mean([predictions[index] for index in indices],axis=0),str(indices))
