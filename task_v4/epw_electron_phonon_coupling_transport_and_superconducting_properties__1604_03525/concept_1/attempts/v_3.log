+import numpy as np
+from scipy import linalg as la
+from learn import load
+
+inputs=load('train_input')
+prior=dict(np.load('prior.npz'))
+omega=inputs['omega_mev']
+basis=prior['basis']
+operators=[]
+for row in range(len(inputs['interaction'])):
+    slots=np.flatnonzero(inputs['mask'][row])
+    kernel=omega[None,:]**2/(omega[None,:]**2+inputs['nu_mev'][row,slots,None]**2)
+    std=inputs['noise_std'][row,slots]
+    rho,length=inputs['noise_rho'][row],inputs['noise_length'][row]
+    covariance=std[:,None]*std[None,:]*((1-rho)*np.eye(len(slots))+rho*np.exp(-np.abs(slots[:,None]-slots)/length))
+    root=la.cholesky(covariance,lower=True)
+    design=la.solve_triangular(root,kernel@basis,lower=True)
+    transfer=la.cho_solve(la.cho_factor(np.eye(basis.shape[1])+design.T@design),design.T)
+    operators.append(transfer@la.solve_triangular(root,kernel,lower=True))
+np.save('operators.npy',np.array(operators,dtype='f'))
+print('saved operators',flush=True)
