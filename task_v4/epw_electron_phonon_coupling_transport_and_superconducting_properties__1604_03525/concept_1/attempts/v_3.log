+        std = inputs['noise_std'][row, slots]
+        rho, length = inputs['noise_rho'][row], inputs['noise_length'][row]
+        cov = std[:, None] * std[None, :] * ((1-rho)*np.eye(len(slots)) + rho*np.exp(-np.abs(slots[:, None]-slots)/length))
+        root = la.cholesky(cov, lower=True)
+        design = la.solve_triangular(root, kernel @ basis, lower=True)
+        posterior = la.cho_solve(la.cho_factor(np.eye(dimensions) + design.T @ design), np.eye(dimensions))
+        transfer = la.solve_triangular(root.T, (posterior @ design.T).T, lower=False).T
