+import os
+os.environ['OPENBLAS_NUM_THREADS']='1'
+os.environ['OMP_NUM_THREADS']='1'
+import time
+import numpy as np
+from scipy import linalg as la
+from scipy.optimize import nnls
+
+
+def basis_for(omega):
+    centers=np.geomspace(1,115,64)
+    spread=1.3+.045*centers
+    basis=np.exp(-.5*((omega[:,None]-centers)/spread)**2)
+    basis*=omega[:,None]/(omega[:,None]**2+4)
+    basis/=basis.sum(0)
+    return basis
+
+
+def generate(inputs,prior,probability=None,repeats=8):
+    rng=np.random.default_rng(7139)
+    omega=inputs['omega_mev']
+    basis=basis_for(omega)
+    mean,pca=prior['mean'],prior['basis']
+    selected=np.tril_indices(12,-1)
+    result=[]
+    label_indices=[]
+    start=time.time()
+    for row in range(len(inputs['interaction'])):
+        slots=np.flatnonzero(inputs['mask'][row])
+        kernel=omega[None,:]**2/(omega[None,:]**2+inputs['nu_mev'][row,slots,None]**2)
+        std=inputs['noise_std'][row,slots]
+        rho,length=inputs['noise_rho'][row],inputs['noise_length'][row]
+        covariance=std[:,None]*std[None,:]*((1-rho)*np.eye(len(slots))+rho*np.exp(-np.abs(slots[:,None]-slots)/length))
+        root=la.cholesky(covariance,lower=True)
+        whitened_kernel=la.solve_triangular(root,kernel,lower=True)
+        design=whitened_kernel@pca
+        posterior=la.cho_solve(la.cho_factor(np.eye(40)+design.T@design),np.eye(40))
+        transfer=posterior@design.T
+        fit_matrix=np.vstack((whitened_kernel@basis,10*np.eye(64)))
+        extra=np.r_[np.log(np.maximum(np.diag(posterior)[:24],1e-8)),posterior[selected]]
+        for repeat in range(repeats if probability is not None else 1):
+            if probability is not None:
+                label=rng.integers(len(probability))
+                target=whitened_kernel@probability[label]*rng.uniform(.55,1.1)+rng.normal(size=len(slots))
+                label_indices.append(label)
+            else:
+                target=la.solve_triangular(root,inputs['interaction'][row,slots],lower=True)
+            observed=transfer@(target-whitened_kernel@mean)
+            coefficient,_=nnls(fit_matrix,np.r_[target,np.zeros(64)],maxiter=1000)
+            coefficient/=coefficient.sum()
+            result.append(np.r_[observed,coefficient,extra])
+        if row%512==0:
+            print(row,round(time.time()-start,1),flush=True)
+    return np.array(result,dtype='f'),np.array(label_indices)
+
+
+def main():
+    train=dict(np.load('../../participant/input/train_input.npz'))
+    validation=dict(np.load('../../participant/input/validation_input.npz'))
+    labels=dict(np.load('../../participant/input/train_labels.npz'))
+    prior=dict(np.load('prior.npz'))
+    mass=labels['alpha2f']/train['omega_mev']
+    probability=mass/mass.sum(1)[:,None]
+    features,indices=generate(train,prior,probability)
+    val_features,_=generate(validation,prior)
+    np.savez('nnls_features.npz',train=features,indices=indices,validation=val_features,basis=basis_for(train['omega_mev']))
+
+
+if __name__=='__main__':
+    main()
