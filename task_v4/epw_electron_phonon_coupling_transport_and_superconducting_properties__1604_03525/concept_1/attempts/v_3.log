+        for code in range(4):
+            group=parameters[family==code]
+            count=2 if code==0 else 3
+            weights=group[:,2+3*count:2+3*count+count+1]
+            weights/=weights.sum(1)[:,None]
+            if code==2:
+                group[:,3]-=group[:,2]
+            lower=np.quantile(group,.01,axis=0)
+            upper=np.quantile(group,.99,axis=0)
+            parameter_groups.append((torch.tensor(group,dtype=torch.float32),torch.tensor(lower,dtype=torch.float32),torch.tensor(upper,dtype=torch.float32)))
+        print('Population accepted', [len(item[0]) for item in parameter_groups],flush=True)
+    model=Net(train_x.shape[1],args.width)
+    optimizer=torch.optim.AdamW(model.parameters(),lr=.0008,weight_decay=.002)
+    scheduler=torch.optim.lr_scheduler.CosineAnnealingLR(optimizer,args.epochs,eta_min=.000025)
+    best=100
+    start=time.time()
+    for epoch in range(args.epochs):
+        total=0
+        for batch in range(32):
+            indices=torch.randint(len(probability),(256,))
+            templates=torch.randint(len(probability),(256,))
+            target=probability[indices].clone()
+            if args.warp:
+                dilation=torch.exp(torch.randn(256,1)*args.warp)
+                locations=((omega[None,:]/dilation-.3125)/.625).clamp(0,191)
+                left=locations.long().clamp(0,190)
+                fraction=locations-left
+                target=target.gather(1,left)*(1-fraction)+target.gather(1,left+1)*fraction
+                target/=target.sum(1)[:,None]
+            if population is not None:
+                synth_count=int(256*args.population)//4
+                for code,(group,lower,upper) in enumerate(parameter_groups):
+                    count=2 if code==0 else 3
+                    sampled=group[torch.randint(len(group),(synth_count,))].clone()
+                    sampled+=torch.randn_like(sampled)*(upper-lower)*args.jitter
+                    sampled=torch.maximum(torch.minimum(sampled,upper),lower)
+                    if code==2:
+                        sampled[:,3]+=sampled[:,2]
+                    acoustic=omega[None,:]*torch.exp(-(omega[None,:]/sampled[:,0,None])**sampled[:,1,None])
+                    standardized=(omega[None,:,None]-sampled[:,None,2:2+count])/sampled[:,None,2+count:2+2*count]
+                    optical=torch.exp(-.5*standardized.square())*(1+sampled[:,None,2+2*count:2+3*count]*torch.tanh(standardized))*(omega/(omega.square()+4))[None,:,None]
+                    bands=torch.cat((acoustic[:,:,None],optical),dim=-1)
+                    bands/=bands.sum(1,keepdim=True)
+                    weights=sampled[:,2+3*count:2+3*count+count+1].clamp_min(.001)
+                    weights/=weights.sum(1,keepdim=True)
+                    target[code*synth_count:(code+1)*synth_count]=(bands*weights[:,None,:]).sum(-1)
+            lambdas=.55+.55*torch.rand(256,1)
+            target_mass=target*lambdas
+            observed=(operators[templates]@(target_mass-mean_mass)[:,:,None]).squeeze(-1)+(noise[templates]@torch.randn(256,40,1)).squeeze(-1)
+            feature=torch.cat((observed,extra[templates]),dim=1)
+            predicted=model((feature-center)/scale)
+            difference=predicted.cumsum(1)-target.cumsum(1)
+            loss=(torch.sqrt(difference.square()+1e-7)*metric).sum(1).mean()
+            loss+=2.5*torch.sqrt(((predicted-target)@log_omega).square()+1e-6).mean()
+            optimizer.zero_grad()
+            loss.backward()
+            optimizer.step()
+            total+=loss.item()/32
+        scheduler.step()
+        if epoch%20==0 or epoch==args.epochs-1:
+            loss,scores,prediction,errors=evaluate(model,val_x,scale,center,coupling,val_labels,validation)
+            print(epoch,round(time.time()-start,1),'train',round(total,4),'score',round(100*np.exp(-loss),3),np.round(scores,2),np.round(errors,5),flush=True)
+            if loss<best:
+                best=loss
+                torch.save(dict(state=model.state_dict(),center=center,scale=scale,width=args.width),ROOT/('model%d.pt'%args.seed))
+                np.savez(ROOT/('model%d_validation.npz'%args.seed),alpha2f=prediction)
+
+
+if __name__=='__main__':
+    main()
