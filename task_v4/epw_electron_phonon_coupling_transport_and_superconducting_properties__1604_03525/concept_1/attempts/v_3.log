+inputs=dict(np.load('../../participant/input/validation_input.npz'))
+labels=dict(np.load('../../participant/input/validation_labels.npz'))
+omega=inputs['omega_mev']
+names=[str(index) for index in [2,3,4,6,8,9,10,11] if os.path.exists('model%d_validation.npz'%index)]
+prediction=[np.load('model%s_validation.npz'%name)['alpha2f'] for name in names]
