*** Add File: experiment.py
+import os
+os.environ['OPENBLAS_NUM_THREADS'] = '1'
+os.environ['OMP_NUM_THREADS'] = '1'
+import time
+import argparse
+import numpy as np
+from scipy.linalg import cho_factor, cho_solve, eigh
+from scipy.sparse import coo_matrix, vstack, csr_matrix
+from scipy.optimize import minimize
+
+
+def prepare(data):
+    source, target = data['source'], data['target']
+    velocities, probes = data['velocities'], data['probes']
+    count = len(velocities)
+    weights = (data['channels'] @ data['mixing'].T).T.copy()
+    degrees = np.array([np.bincount(source, weights=row, minlength=count) + np.bincount(target, weights=row, minlength=count) for row in weights])
+    probe_diff = (probes[source] - probes[target]) ** 2
+    dissipation = weights @ probe_diff
+    drives = []
+    importance = np.zeros(len(source))
+    for row, degree in zip(weights, degrees):
+        matrix = np.full((count, count), 1.0/count)
+        matrix[source,target] -= row
+        matrix[target,source] -= row
+        matrix[np.diag_indices(count)] += degree
+        factor = cho_factor(matrix)
+        response = cho_solve(factor, velocities)
+        conductivity = velocities.T @ response
+        values, vectors = eigh(conductivity)
+        transform = vectors / np.sqrt(values)[None,:]
+        drives.append(velocities @ transform)
+        response = response @ transform
+        response_diff = response[source] - response[target]
+        importance += 0.25 * row * (response_diff ** 2).sum(axis=1) / 3
+        inverse = cho_solve(factor, np.eye(count))
+        resistance = inverse.diagonal()[source] + inverse.diagonal()[target] - 2*inverse[source,target]
+        importance += 0.60 * row * resistance / (count-1)
+    importance += 0.15 * np.sum(weights[:,:,None] * probe_diff[None,:,:] / dissipation[:,None,:], axis=(0,2)) / probes.shape[1]
+    return source, target, weights, degrees, probe_diff, dissipation, np.array(drives), importance
+
+
+def compress(data, iterations=1000, outer=1, method='nonlinear', verbose=False):
+    start = time.monotonic()
+    source, target, weights, degrees, probe_diff, dissipation, drives, importance = prepare(data)
+    count, temp_count, budget = len(data['velocities']), len(weights), int(data['budget'])
+    rng = np.random.default_rng(29)
+    priorities = -np.log(rng.random(len(source))) / importance
+    indices = np.argpartition(priorities, budget-1)[:budget]
+    threshold = np.max(priorities[indices])
+    scale = 1 / (-np.expm1(-importance[indices]*threshold))
+    source, target = source[indices], target[indices]
+    weights = weights[:,indices] * scale[None,:]
+    probe_diff = probe_diff[indices]
+    rows = np.concatenate([source[None,:] + count*np.arange(temp_count)[:,None], target[None,:] + count*np.arange(temp_count)[:,None]],axis=1).ravel()
+    columns = np.tile(np.arange(budget), 2*temp_count)
+    entries = np.concatenate([weights / degrees[:,source], weights / degrees[:,target]],axis=1).ravel() / np.sqrt(count)
+    degree_matrix = coo_matrix((entries, (rows,columns)),shape=(temp_count*count,budget)).tocsr()
+    probe_matrix = (weights[:,None,:] * probe_diff.T[None,:,:] / dissipation[:,:,None]).reshape(-1,budget)
+    linear_matrix = vstack([degree_matrix,csr_matrix(probe_matrix)]).tocsr()
+    linear_target = np.concatenate([np.ones(temp_count*count)/np.sqrt(count),np.ones(len(probe_matrix))])
+    upper = np.triu_indices(3)
+    symmetric_scale = np.array([1,np.sqrt(2),np.sqrt(2),1,np.sqrt(2),1])
+    identity = np.eye(3)
+    eval_count = 0
+
+    def nonlinear(multiplier, jacobian=False):
+        values, gradients = [], []
+        for temp in range(temp_count):
+            row = weights[temp] * multiplier
+            degree = np.bincount(source, weights=row, minlength=count) + np.bincount(target, weights=row,minlength=count)
+            matrix = np.full((count,count),1.0/count)
+            matrix[source,target] -= row
+            matrix[target,source] -= row
+            matrix[np.diag_indices(count)] += degree
+            try:
+                response = cho_solve(cho_factor(matrix),drives[temp])
+            except np.linalg.LinAlgError:
+                matrix[np.diag_indices(count)] += 1e-8
+                response = cho_solve(cho_factor(matrix),drives[temp])
+            conductivity = drives[temp].T @ response
+            values.extend((conductivity-identity)[upper]*symmetric_scale)
+            response_diff = response[source]-response[target]
+            gradient = -weights[temp][None,:] * (response_diff[:,upper[0]]*response_diff[:,upper[1]]).T * symmetric_scale[:,None]
+            gradients.append(gradient)
+        return np.array(values), np.vstack(gradients)
+
+    def objective(multiplier):
+        nonlocal eval_count
+        residual = linear_matrix @ multiplier - linear_target
+        nonlin, gradient = nonlinear(multiplier)
+        loss = np.dot(residual,residual) + np.dot(nonlin,nonlin)
+        derivative = 2*(linear_matrix.T @ residual + gradient.T @ nonlin)
+        eval_count += 1
+        if verbose and eval_count % 100 == 0:
+            print('eval',eval_count,'loss',loss,'nonlin',np.max(np.abs(nonlin)),'elapsed',time.monotonic()-start,flush=True)
+        return loss, derivative
+
+    multiplier = np.ones(budget)
+    for step in range(outer):
+        if method == 'nonlinear':
+            result = minimize(objective,multiplier,jac=True,method='L-BFGS-B',bounds=[(1e-8,None)]*budget,options={'maxiter':iterations,'maxcor':20,'ftol':1e-14,'gtol':1e-9})
+        else:
+            nonlin, gradient = nonlinear(multiplier)
+            fit_matrix = vstack([linear_matrix,csr_matrix(gradient)]).tocsr()
+            fit_target = np.concatenate([linear_target,gradient @ multiplier - nonlin])
+            def linear_objective(candidate):
+                residual = fit_matrix @ candidate - fit_target
+                return np.dot(residual,residual), 2*(fit_matrix.T @ residual)
+            result = minimize(linear_objective,multiplier,jac=True,method='L-BFGS-B',bounds=[(1e-8,None)]*budget,options={'maxiter':iterations,'maxcor':20,'ftol':1e-14,'gtol':1e-9})
+        multiplier = result.x
+        if verbose:
+            print('step',step,'nit',result.nit,'fun',result.fun,'elapsed',time.monotonic()-start,'message',result.message,flush=True)
+    return indices, multiplier*scale
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--input',required=True)
+    parser.add_argument('--output')
+    parser.add_argument('--iterations',type=int,default=500)
+    parser.add_argument('--outer',type=int,default=1)
+    parser.add_argument('--method',default='nonlinear')
+    args = parser.parse_args()
+    data = dict(np.load(args.input))
+    indices,multipliers = compress(data,args.iterations,args.outer,args.method,True)
+    if args.output:
+        np.savez(args.output,indices=indices,multipliers=multipliers)
+    from physics import score
+    result = score(data,indices,multipliers)
+    print(result,flush=True)
+
+
+if __name__ == '__main__':
+    main()
*** End Patch
