+    parser.add_argument('--input',required=True)
+    parser.add_argument('--output')
+    parser.add_argument('--steps',type=int,default=20)
+    parser.add_argument('--iterations',type=int,default=500)
+    parser.add_argument('--no-exchange',action='store_true')
+    args = parser.parse_args()
+    data = dict(np.load(args.input))
+    indices,multipliers = compress(data,args.steps,args.iterations,not args.no_exchange)
+    if args.output:
+        np.savez(args.output,indices=indices,multipliers=multipliers)
+    from physics import score
+    print(score(data,indices,multipliers),flush=True)
+
+
+if __name__ == '__main__':
