+import os
+os.environ['OPENBLAS_NUM_THREADS'] = '1'
+os.environ['OMP_NUM_THREADS'] = '1'
+import argparse
+import json
+from pathlib import Path
+import resource
+import subprocess
+import sys
+import time
+import numpy as np
+from physics import score
+
+
+def limits():
+    resource.setrlimit(resource.RLIMIT_AS, (4 * 1024**3, 4 * 1024**3))
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--pattern', default='*.npz')
+    parser.add_argument('--report', default='validation.json')
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parent
+    inputs = root / '../../participant/input'
+    outputs = root / 'validation_outputs'
+    outputs.mkdir(exist_ok=True)
+    rows = []
+    for path in sorted(inputs.glob(args.pattern)):
+        output = outputs / path.name
+        started = time.monotonic()
+        result = subprocess.run(
+            [sys.executable, str(root / 'solve.py'), '--input', str(path), '--output', str(output)],
+            capture_output=True, text=True, timeout=89, preexec_fn=limits,
+        )
+        elapsed = time.monotonic() - started
+        if result.returncode:
+            raise RuntimeError(result.stderr)
+        with np.load(path) as data, np.load(output) as compressed:
+            diagnostics = score(data, compressed['indices'], compressed['multipliers'])
+        family = path.stem.replace('development_', '').replace('generation_2_', '').rsplit('_', 1)[0]
+        rows.append({'case': path.stem, 'family': family, 'seconds': elapsed, **diagnostics})
+        print(path.stem, 'score', round(diagnostics['score'], 4), 'error', diagnostics['relative_error'], 'seconds', round(elapsed, 3), flush=True)
+        report = {
+            'cases': rows,
+            'mean_score': float(np.mean([row['score'] for row in rows])),
+            'worst_family_score': min(float(np.mean([row['score'] for row in rows if row['family'] == family])) for family in {row['family'] for row in rows}),
+            'maximum_seconds': max(row['seconds'] for row in rows),
+        }
+        with open(root / args.report, 'w') as handle:
+            json.dump(report, handle, indent=2)
+    print({key: value for key, value in report.items() if key != 'cases'}, flush=True)
+
+
+if __name__ == '__main__':
+    main()

