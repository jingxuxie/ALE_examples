@@ -0,0 +1,37 @@
+# Temperature-transferable event compression
+
+Run the standalone submission with:
+
+```sh
+python3 solve.py --input INPUT_NPZ --output OUTPUT_NPZ
+```
+
+Dependencies are NumPy and SciPy. No trained assets or input-specific tables are
+needed. The solver uses one numerical thread.
+
+## Method
+
+The initial sample combines effective-resistance importance with normalized
+transport-response and probe-dissipation importance over every supplied
+temperature. A spanning forest repairs any disconnected initial selection.
+
+All selected events then share one bounded, nonnegative multiplier vector.
+Degree and probe residuals are linear in that vector. Conductivity residuals
+use the full inverse collision operator and are whitened by the original
+conductivity tensor. Bounded, preconditioned Gauss–Newton subproblems fit these
+three observables together; a line search checks the actual nonlinear error.
+
+Periodically, nearly unused events are exchanged for events with favorable
+residual gradients. Each exchange preserves a spanning tree. The solver keeps
+the best selection according to the exact maximum diagnostic, including all
+temperatures, rather than merely its least-squares objective.
+
+Optimization has a 75-second internal deadline and a 40-iteration outer limit.
+The output always uses at most the supplied event budget.
+
+## Validation
+
+`validation.json` records the public development-catalogue results. The
+validation harness runs the submission as a separate process with a 4 GiB
+address-space limit and checks its output using the supplied physical scoring
+model. These are development measurements, not predictions of hidden scores.
diff --git a/tasks_v4/epw_electron_phonon_coupling_transport_and_superconducting_properties__1604_03525/concept_2/attempts/v_2/stress_validation.py b/tasks_v4/epw_electron_phonon_coupling_transport_and_superconducting_properties__1604_03525/concept_2/attempts/v_2/stress_validation.py
new file mode 100644
index 0000000000000000000000000000000000000000..fb3e82eca9182d3b2ad775939716b7148b683e6d
--- /dev/null
+++ b/tasks_v4/epw_electron_phonon_coupling_transport_and_superconducting_properties__1604_03525/concept_2/attempts/v_2/stress_validation.py
@@ -0,0 +1,57 @@
+import os
+os.environ['OPENBLAS_NUM_THREADS'] = '1'
+os.environ['OMP_NUM_THREADS'] = '1'
+import json
+from pathlib import Path
+import subprocess
+import sys
+import time
+import numpy as np
+from physics import score
+from validate_submission import limits
+
+
+def main():
+    root = Path(__file__).resolve().parent
+    directory = root / 'stress_outputs'
+    directory.mkdir(exist_ok=True)
+    rows = []
+    for family, branches in [('valleys', 8), ('forward', 6)]:
+        with np.load(root / ('../../participant/input/generation_2_' + family + '_3.npz')) as original:
+            data = dict(original)
+        generator = np.random.default_rng(817)
+        original_count = len(data['velocities'])
+        mapping = np.concatenate([np.arange(original_count), generator.choice(original_count, 448-original_count, replace=False)])
+        dense = np.zeros((original_count, original_count, branches))
+        dense[data['source'], data['target']] = data['channels'][:, :branches]
+        dense[data['target'], data['source']] = data['channels'][:, :branches]
+        source, target = np.triu_indices(448, 1)
+        channels = dense[mapping[source], mapping[target]]
+        identical = mapping[source] == mapping[target]
+        channels[identical] = np.mean(data['channels'][:, :branches], axis=0)
+        channels *= generator.lognormal(0, 0.15, size=channels.shape)
+        channels *= generator.lognormal(0, 0.4, size=branches)
+        velocities = data['velocities'][mapping]
+        velocities -= velocities.mean(axis=0)
+        probes = data['probes'][mapping]
+        probes = np.column_stack([probes, generator.normal(size=(448, 24-probes.shape[1]))])
+        probes -= probes.mean(axis=0)
+        data.update(source=source, target=target, channels=channels, mixing=data['mixing'][:, :branches], velocities=velocities, probes=probes, positions=data['positions'][mapping], budget=np.array(448*8))
+        input_path = directory / (family + '_448_input.npz')
+        output_path = directory / (family + '_448_output.npz')
+        np.savez(input_path, **data)
+        started = time.monotonic()
+        result = subprocess.run([sys.executable, str(root / 'solve.py'), '--input', str(input_path), '--output', str(output_path)], capture_output=True, text=True, timeout=89, preexec_fn=limits)
+        elapsed = time.monotonic() - started
+        if result.returncode:
+            raise RuntimeError(result.stderr)
+        with np.load(output_path) as selected:
+            measured = score(data, selected['indices'], selected['multipliers'])
+        rows.append({'case': family + '_448_derived', 'states': 448, 'branches': branches, 'probes': 24, 'seconds': elapsed, **measured})
+        print(rows[-1], flush=True)
+        with open(root / 'stress_validation.json', 'w') as handle:
+            json.dump({'description': 'Locally derived size/resource stress tests, not supplied development cases.', 'cases': rows}, handle, indent=2)
+
+
+if __name__ == '__main__':
+    main()
