+import os
+os.environ['OPENBLAS_NUM_THREADS'] = '1'
+os.environ['OMP_NUM_THREADS'] = '1'
+os.environ['OPT'] = 'ip'
+import sys
+import time
+from pathlib import Path
+import numpy as np
+sys.path.insert(0, str(Path(__file__).resolve().parents[2] / 'participant' / 'workspace'))
+from physics import score
+from prototype import compress
+
+root = Path(__file__).resolve().parents[2] / 'participant'
+mode = sys.argv[1] if len(sys.argv) > 1 else 'budget'
+generator = np.random.default_rng(123)
+for path in sorted((root / 'input').glob('*.npz')):
+    data = dict(np.load(path))
+    if mode == 'large':
+        if '_0' in path.name:
+            continue
+        original_count = len(data['velocities'])
+        expanded_count = 168
+        mapping = np.arange(expanded_count) % original_count
+        channel_matrix = np.zeros((original_count, original_count, data['channels'].shape[1]))
+        channel_matrix[data['source'], data['target']] = data['channels']
+        channel_matrix[data['target'], data['source']] = data['channels']
+        channel_matrix[np.arange(original_count), np.arange(original_count)] = channel_matrix.sum(axis=1) / (original_count-1)
+        source, target = np.triu_indices(expanded_count, 1)
+        data['channels'] = channel_matrix[mapping[source], mapping[target]] * np.exp(.2 * generator.standard_normal((len(source), data['channels'].shape[1])))
+        data['source'], data['target'] = source, target
+        for field in ['velocities', 'probes', 'positions']:
+            data[field] = data[field][mapping].copy()
+            if field "'!= '"'positions':
+                data[field] += .05 * data[field].std() * generator.standard_normal(data[field].shape)
+                data[field] -= data[field].mean(axis=0)
+    if mode == 'thermal':
+        extra_channel = np.sqrt(data['channels'][:, 0] * data['channels'][:, 2]) * np.exp(.7 * generator.standard_normal(len(data['source'])))
+        data['channels'] = np.column_stack([data['channels'], extra_channel])
+        temperature_count = 7
+        temperatures = np.linspace(0, 1, temperature_count)
+        data['mixing'] = np.exp(-((temperatures[:, None] - np.linspace(0, 1, 5)) / .3)**2) + .01
+        data['mixing'] /= data['mixing'].sum(axis=1)[:, None]
+        data['temperatures'] = temperatures
+    data['budget'] = 6 * len(data['velocities'])
+    started = time.monotonic()
+    indices, multipliers = compress(data, verbose=False)
+    result = score(data, indices, multipliers)
+    print(mode, path.name, 'seconds', round(time.monotonic()-started, 3), 'score',result['score'],'error',result['relative_error'], flush=True)
*** End Patch
