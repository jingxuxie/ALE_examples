+import time
+import argparse
+import numpy as np
+from scipy.linalg import solve, eigh
+from scipy.optimize import linprog, lsq_linear
+
+
+def compress(data, verbose=False):
+    started = time.monotonic()
+    source, target = data['source'], data['target']
+    channels, mixing = data['channels'], data['mixing']
+    velocities, probes = data['velocities'], data['probes']
+    state_count, probe_count = probes.shape
+    edge_count = len(source)
+    budget = int(data['budget'])
+    weights = mixing @ channels.T
+    temperature_count = len(mixing)
+    incidence = np.zeros((state_count, edge_count))
+    incidence[source, np.arange(edge_count)] = 1
+    incidence[target, np.arange(edge_count)] = 1
+    probe_delta = (probes[source] - probes[target]).T ** 2
+    degrees = weights @ incidence.T
+    dissipations = weights @ probe_delta.T
+    importance = np.mean(weights * (1 / degrees[:, source] + 1 / degrees[:, target]), axis=0)
+    scale = 1 / importance
+    linear = np.concatenate([
+        (incidence * weights[temperature] / degrees[temperature, :, None]) / np.sqrt(state_count)
+        for temperature in range(temperature_count)
+    ] + [
+        (probe_delta * weights[temperature] / dissipations[temperature, :, None]) / np.sqrt(probe_count)
+        for temperature in range(temperature_count)
+    ])
+    linear *= scale
+    linear_target = linear @ importance
+    shift = np.ones((state_count, state_count)) / state_count
+    diagonal = np.diag_indices(state_count)
+    whitened_drives = []
+    original_responses = []
+    tensor_rows, tensor_columns = np.triu_indices(3)
+    tensor_scale = np.where(tensor_rows == tensor_columns, 1., np.sqrt(2.))
+    for temperature in range(temperature_count):
+        matrix = np.zeros_like(shift)
+        matrix[source, target] = -weights[temperature]
+        matrix[target, source] = -weights[temperature]
+        matrix[diagonal] = degrees[temperature]
+        response = solve(matrix + shift, velocities, assume_a='pos')
+        conductivity = velocities.T @ response
+        values, vectors = eigh(conductivity)
+        transform = vectors / np.sqrt(values)
+        whitened_drives.append(velocities @ transform)
+        original_responses.append(response @ transform)
+
+    def tensor_features(indices, values=None):
+        features, residuals = [], []
+        for temperature in range(temperature_count):
+            if values is None:
+                response = original_responses[temperature]
+                conductivity = np.eye(3)
+            else:
+                selected_weights = weights[temperature, indices] * scale[indices] * values
+                matrix = np.zeros_like(shift)
+                matrix[source[indices], target[indices]] = -selected_weights
+                matrix[target[indices], source[indices]] = -selected_weights
+                matrix[diagonal] = -matrix.sum(axis=1)
+                response = solve(matrix + shift, whitened_drives[temperature], assume_a='pos')
+                conductivity = whitened_drives[temperature].T @ response
+            difference = response[source[indices]] - response[target[indices]]
+            feature = difference[:, tensor_rows] * difference[:, tensor_columns]
+            features.append((feature * (weights[temperature, indices] * scale[indices])[:, None] * tensor_scale).T)
+            residuals.append(((conductivity - np.eye(3))[tensor_rows, tensor_columns]) * tensor_scale)
+        return np.concatenate(features), np.concatenate(residuals)
+
+    generator = np.random.default_rng(42)
+    full_indices = np.arange(edge_count)
+    initial_tensor, _ = tensor_features(full_indices)
+    if os.environ.get('INIT', 'random') == 'lp':
+        thermal_rank = min(channels.shape[1], max(2, (budget - 6 * temperature_count - 100) // (state_count + probe_count)))
+        _, _, basis = np.linalg.svd(weights, full_matrices=False)
+        reduced = []
+        for channel in range(thermal_rank):
+            reduced.append(incidence * basis[channel] * scale)
+            reduced.append(probe_delta * basis[channel] * scale)
+        constraints = np.concatenate(reduced + [initial_tensor])
+        targets = constraints @ importance
+        row_scale = np.linalg.norm(constraints, axis=1)
+        constraints /= row_scale[:, None]
+        targets /= row_scale
+        result = linprog(generator.uniform(.5, 1.5, edge_count), A_eq=constraints,
+                         b_eq=targets, bounds=(0, None), method='highs', options={'time_limit': 25})
+        if not result.success:
+            raise RuntimeError(result.message)
+        selected = np.flatnonzero(result.x > 1e-9)
+        remaining = np.setdiff1d(full_indices, selected)
+        priorities = importance[remaining] / generator.exponential(size=len(remaining))
+        added = remaining[np.argsort(priorities)[-(budget-len(selected)):]]
+        indices = np.concatenate([selected, added])
+        values = result.x[indices]
+    else:
+        priorities = importance / generator.exponential(size=edge_count)
+        indices = np.argsort(priorities)[-budget:]
+        features = np.concatenate([linear[:, indices], initial_tensor[:, indices]])
+        targets = np.concatenate([linear_target, initial_tensor @ importance])
+        result = lsq_linear(features, targets, bounds=(0, np.inf), method='trf', tol=1e-10, max_iter=70)
+        values = result.x
+    if verbose:
+        print('initial', time.monotonic()-started, 'edges',len(indices), flush=True)
+    selected_linear = linear[:, indices]
+    for iteration in range(12):
+        tensor, residual = tensor_features(indices, values)
+        linear_residual = linear_target - selected_linear @ values
+        objective = np.linalg.norm(linear_residual)**2 + np.linalg.norm(residual)**2
+        if verbose:
+            print(iteration, 'time',time.monotonic()-started,'linear',np.max(np.abs(linear_residual)), 'tensor',np.max(np.abs(residual)), 'obj',objective,flush=True)
