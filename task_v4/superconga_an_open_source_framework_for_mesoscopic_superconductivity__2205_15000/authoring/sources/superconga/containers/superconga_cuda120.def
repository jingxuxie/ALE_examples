Bootstrap: docker
From: nvidia/cuda:12.0.1-devel-ubuntu22.04

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get -y update

    # Install SuperConga dependencies.
    apt-get install -y build-essential cmake cmake-curses-gui curl g++ gcc gfortran git-all libblas-dev libboost-all-dev libfontconfig1-dev libfreeimage-dev libglfw3-dev libhdf5-dev libjsoncpp-dev liblapack-dev ninja-build pkg-config python3-pip python3-tk texlive-base texlive-latex-extra cm-super dvipng

    # Setup Python 3.
    pip3 install -r home/requirements.txt
    update-alternatives --install /usr/bin/python python /usr/bin/python3 3

%environment
    export LC_ALL=C

%files
    requirements.txt home/
