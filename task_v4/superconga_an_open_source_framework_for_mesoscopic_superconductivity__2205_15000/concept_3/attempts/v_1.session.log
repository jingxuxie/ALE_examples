+import json
+import time
+
+import numpy as np
+
+import bdg
+from inference import InverseProblem
+
+
+scene = bdg.draw_scene(86018, 'clustered')
+table = bdg.ldos_table(scene)
+problem = InverseProblem()
+for action in bdg.uniform_actions(56)[:44]:
+    site, energy = action['site'], action['energy_index']
+    problem.add(site, energy, round(float(table[site, energy]), 12))
+problem.initial_fit()
+while len(problem.actions) < 56:
+    for site, energy in problem.design(min(4, 56 - len(problem.actions))):
+        problem.add(site, energy, round(float(table[site, energy]), 12))
+    problem.refresh()
+print('ACQUIRED', time.process_time() - problem.start_cpu, 'best', problem.best[0], 'sector', problem.sectors[problem.best[1]], flush=True)
