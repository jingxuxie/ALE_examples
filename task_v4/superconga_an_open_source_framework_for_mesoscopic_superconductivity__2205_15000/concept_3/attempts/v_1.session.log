+sector = problem.best[1]
+for anchor_row in range(1, 4):
+    for anchor_column in range(1, 4):
+        free = np.flatnonzero((problem.allowed // 8 >= anchor_row)
+                              & (problem.allowed // 8 < anchor_row + 4)
+                              & (problem.allowed % 8 >= anchor_column)
+                              & (problem.allowed % 8 < anchor_column + 4))
+        for mode in range(3):
+            weights = None if mode == 0 else 0.2 / (problem.observations + 0.02)
+            seed = np.zeros(36) if mode < 2 else problem.generator.uniform(-0.8, 0.8, 36)
+            fitted, objective = problem.optimize(sector, seed, free=free, evaluations=120, weights=weights)
+            print('WINDOW', anchor_row, anchor_column, mode, objective, flush=True)
+            if objective < .005:
+                problem.sparse(sector, fitted, evaluations=100)
