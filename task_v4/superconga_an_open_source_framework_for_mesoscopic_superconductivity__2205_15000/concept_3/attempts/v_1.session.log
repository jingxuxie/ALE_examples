+
+class InverseProblem:
+    def __init__(self, seconds=83.0):
+        self.start_cpu = time.process_time()
+        self.start_wall = time.monotonic()
+        self.deadline = self.start_cpu + seconds
+        self.allowed = np.asarray(bdg.SPEC['impurity_sites'])
+        self.sectors = bdg.sectors()
+        self.matrices = [bdg.hamiltonian(np.zeros(64), sector) for sector in self.sectors]
+        self.matrices[0] = self.matrices[0].real.copy()
+        self.actions = []
