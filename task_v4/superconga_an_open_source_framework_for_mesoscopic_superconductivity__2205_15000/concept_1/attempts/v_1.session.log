+class FastModel:
+    def __init__(self, model):
+        self.model = model
+        self.mask = model.mask
+        self.size = model.size
+        self.shape = model.shape
+        self.alpha = model.h ** 2 * model.alpha[self.mask]
+        self.beta = model.h ** 2 * model.beta[self.mask]
+        indices = np.full(model.shape, -1, dtype=int)
+        indices[self.mask] = np.arange(model.size)
+        sources = np.concatenate((indices[:, :-1].ravel(), indices[:-1].ravel()))
+        targets = np.concatenate((indices[:, 1:].ravel(), indices[1:].ravel()))
+        valid = (sources >= 0) & (targets >= 0)
+        sources = sources[valid]
+        targets = targets[valid]
+        stiffness = np.concatenate((model.kx.ravel(), model.ky.ravel()))[valid]
+        phases = np.concatenate((model.ux.ravel(), model.uy.ravel()))[valid]
+        diagonal = self.alpha + np.bincount(sources, weights=stiffness, minlength=model.size) + np.bincount(targets, weights=stiffness, minlength=model.size)
+        rows = np.concatenate((np.arange(model.size), sources, targets))
+        cols = np.concatenate((np.arange(model.size), targets, sources))
+        data = np.concatenate((diagonal, -stiffness * phases, -stiffness * phases.conj()))
+        self.matrix = coo_matrix((data, (rows, cols)), shape=(model.size, model.size)).tocsr()
+        self.initial = model.initial[self.mask].copy()
+        self.calls = 0
+
+    def objective(self, vector):
+        field = vector.view(np.complex128)
+        density = field.real ** 2 + field.imag ** 2
+        linear = self.matrix @ field
+        nonlinear = self.beta * density
+        energy = np.vdot(field, linear).real + 0.5 * np.dot(density, nonlinear)
+        gradient = 2 * (linear + nonlinear * field)
+        self.calls += 1
+        return energy, gradient.view(np.float64)
