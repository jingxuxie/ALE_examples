+    def relax(self, field, maxiter=900, tol=1e-10):
+        started = time.monotonic()
+        calls = self.calls
+        result = minimize(self.objective, np.ascontiguousarray(field, dtype=np.complex128).view(np.float64), jac=True, method='L-BFGS-B', options={'maxiter': maxiter, 'ftol': tol, 'gtol': 1e-5, 'maxcor': 10})
+        return result.fun, result.x.view(np.complex128).copy(), result.nit, self.calls - calls, time.monotonic() - started
