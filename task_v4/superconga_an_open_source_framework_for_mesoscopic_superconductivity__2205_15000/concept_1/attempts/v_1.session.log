@@ -0,0 +1,54 @@
+# Pinned-grain GL solver
+
+## Run
+
+```sh
+python solve.py --input /path/to/case.json --output /path/to/result.npz
+```
+
+The implementation is self-contained and requires only Python, NumPy, and SciPy.
+It does not import participant files, read other cases, use external executables,
+or retain state across invocations. The output is exactly one `complex128` array,
+`psi`, with the input grid shape and zeros on inactive sites. The exact requested
+output path is used, including when it has no `.npz` extension.
+
+## Search
+
+- Reproduce the two public baseline starts with the original full-grid objective
+  and L-BFGS-B settings; retain the lowest-energy incumbent.
+- Represent the same quadratic GL energy by a Hermitian sparse matrix, preserving
+  the prescribed links and omitted-link boundary conditions exactly.
+- Relax candidates with nonlinear conjugate gradients and safeguarded searches
+  on the exact quartic energy along each search direction.
+- Combine independent complex starts with vortex insertion, removal, relocation,
+  hole-winding changes, local phase disturbances, and low-energy field crossover.
+- Use temporary pin softening or heating and a small basin-hopping population to
+  explore alternative configurations. Evaluate all candidates with the original
+  coefficients, not with the temporary search objective.
+- Finish with tight L-BFGS-B relaxation. Retain a separate stationary fallback.
+
+Vortex diagnostics use covariant bond phases and the supplied plaquette flux.
+No assumptions about the input gauge, case identifier, or uniform bulk flux are
+used. The search is heuristic: attained energies are not ground-state certificates.
+Only the explicit onsite lower bound is used to recognize simple certified cases.
+
+## Resource Handling
+
+BLAS and OpenMP thread counts are set to one before numerical imports. The budget
+tracks both wall and process CPU time from startup, targets at most 57 seconds,
+and reserves approximately three seconds for final relaxation and output. A
+repeatedly recovered, stable incumbent permits earlier termination. No scratch
+files are created by the solver; only the requested output is written.
+
+## Validation
+
+`validation.json` records independently recomputed development energies, gradient
+RMS values, output checks, and measured subprocess runtimes. All three development
+witness energies are recovered to numerical precision, without treating those
+witnesses as proven minima.
+
+Additional checks cover analytic derivatives, large pure-gauge transformations,
+reversed magnetic fields, disconnected domains, normal states, single-site
+domains, and unstable zero initial fields. Resampled development grids up to
+71 by 74 sites exercise the larger-grid time and stationarity limits. These are
+public-asset stress tests, not held-out benchmark results.
diff --git a/tasks_v4/superconga_an_open_source_framework_for_mesoscopic_superconductivity__2205_15000/concept_1/attempts/v_1/experiments/check_model.py b/tasks_v4/superconga_an_open_source_framework_for_mesoscopic_superconductivity__2205_15000/concept_1/attempts/v_1/experiments/check_model.py
new file mode 100644
index 0000000000000000000000000000000000000000..c1c2002e51490903653e2441eb2e354041e021a7
--- /dev/null
+++ b/tasks_v4/superconga_an_open_source_framework_for_mesoscopic_superconductivity__2205_15000/concept_1/attempts/v_1/experiments/check_model.py
@@ -0,0 +1,60 @@
+import sys
+import json
+from pathlib import Path
+ROOT = Path(__file__).resolve().parents[1]
+ASSETS = ROOT.parents[1] / 'participant' / 'input'
+sys.path.insert(0, str(ROOT))
+from solve import Model, Budget, conjugate_relax, Topology
+sys.path.insert(0, str(ASSETS))
+from gl_model import GLModel
+import numpy as np
+
+
+def main():
+    rng = np.random.default_rng(19683)
+    records = []
+    for source in sorted((ASSETS / 'cases').glob('*.json')):
+        case = json.load(open(source))
+        model = Model(case)
+        reference = GLModel(case)
+        field = rng.standard_normal(model.size) + 1j * rng.standard_normal(model.size)
+        energy, gradient = model.energy_gradient(field)
+        exact_energy, exact_gradient = reference.energy_gradient(model.full(field))
+        energy_error = abs(energy - exact_energy)
+        gradient_error = float(np.max(abs(gradient - exact_gradient[model.mask])))
+        assert energy_error < 1e-9 and gradient_error < 1e-11
+        direction = rng.standard_normal(model.size) + 1j * rng.standard_normal(model.size)
+        direction /= np.linalg.norm(direction)
+        difference = (model.energy_gradient(field + 1e-5 * direction)[0] - model.energy_gradient(field - 1e-5 * direction)[0]) / 2e-5
+        analytic = np.vdot(gradient, direction).real
+        derivative_error = abs(difference - analytic)
+        assert derivative_error < 1e-5
+        chi = rng.uniform(-100, 100, model.shape)
+        rotated = np.exp(1j * chi)
+        gauge_case = dict(case)
+        gauge_case['ax'] = (model.ax + chi[:, 1:] - chi[:, :-1]).tolist()
+        gauge_case['ay'] = (model.ay + chi[1:] - chi[:-1]).tolist()
+        gauge_initial = model.full(model.initial) * rotated
+        gauge_case['initial_real'] = gauge_initial.real.tolist()
+        gauge_case['initial_imag'] = gauge_initial.imag.tolist()
+        transformed = Model(gauge_case)
+        gauge_energy, gauge_gradient = transformed.energy_gradient(field * rotated[model.mask])
+        gauge_energy_error = abs(gauge_energy - energy)
+        gauge_gradient_error = float(np.max(abs(gauge_gradient - gradient * rotated[model.mask])))
+        assert gauge_energy_error < 1e-9 and gauge_gradient_error < 1e-10
+        original_run = conjugate_relax(model, model.initial, Budget(5), reserve=.1, maxiter=80, tolerance=0)
+        gauge_run = conjugate_relax(transformed, transformed.initial, Budget(5), reserve=.1, maxiter=80, tolerance=0)
+        trajectory_error = abs(original_run[0] - gauge_run[0])
+        assert trajectory_error < 1e-6
+        positions, charges = Topology(model).vortices(original_run[1])
+        other_positions, other_charges = Topology(transformed).vortices(original_run[1] * rotated[model.mask])
+        assert np.array_equal(positions, other_positions) and np.array_equal(charges, other_charges)
+        record = {'case': source.stem, 'energy_error': energy_error, 'gradient_error': gradient_error, 'directional_derivative_error': derivative_error, 'gauge_energy_error': gauge_energy_error, 'gauge_gradient_error': gauge_gradient_error, 'cg_gauge_trajectory_energy_error': trajectory_error}
+        records.append(record)
+        print(record, flush=True)
+    with open(ROOT / 'experiments' / 'model_checks.json', 'w') as stream:
+        json.dump(records, stream, indent=2)
+
+
+if __name__ == '__main__':
+    main()

