+import os
+for variable in ('OMP_NUM_THREADS', 'OPENBLAS_NUM_THREADS', 'MKL_NUM_THREADS'):
+    os.environ[variable] = '1'
+import sys
+import time
+from pathlib import Path
+import numpy as np
+from scipy.fft import dctn, idctn
+from scipy.optimize import minimize
+from explore import FastModel, ASSETS, load_case
+
+
+class PolarModel:
+    def __init__(self, fast):
+        self.fast = fast
+        self.mask = fast.mask
+        self.shape = fast.shape
+        self.size = fast.size
+        rows, cols = self.shape
+        eigenvalues = 4 * np.sin(np.pi * np.arange(rows) / (2 * rows))[:, None] ** 2 + 4 * np.sin(np.pi * np.arange(cols) / (2 * cols))[None, :] ** 2
+        self.weight = 1 / np.sqrt(eigenvalues + .015)
+        self.weight[0, 0] = 1
+
+    def pack(self, field):
+        theta = np.zeros(self.shape)
+        theta[self.mask] = np.angle(field)
+        phase = dctn(theta, norm='ortho') / self.weight
+        return np.concatenate((abs(field), phase.ravel()))
+
+    def unpack(self, vector):
+        phase = idctn(vector[self.size:].reshape(self.shape) * self.weight, norm='ortho')[self.mask]
+        unit = np.exp(1j * phase)
+        return vector[:self.size] * unit, unit
+
+    def objective(self, vector):
+        field, unit = self.unpack(vector)
+        energy, gradient = self.fast.objective(field.view(float))
+        gradient = gradient.view(complex) * unit.conj()
+        phase_gradient = np.zeros(self.shape)
+        phase_gradient[self.mask] = vector[:self.size] * gradient.imag
+        transformed = dctn(phase_gradient, norm='ortho') * self.weight
+        return energy, np.concatenate((gradient.real, transformed.ravel()))
+
+    def relax(self, field, maxiter=900, tol=1e-10):
+        started = time.monotonic()
+        result = minimize(self.objective, self.pack(field), jac=True, method='L-BFGS-B', options={'maxiter': maxiter, 'ftol': tol, 'gtol': 1e-5, 'maxcor': 10})
+        return result.fun, self.unpack(result.x)[0], result.nit, result.nfev, time.monotonic() - started
+
+
+def main():
+    name = sys.argv[1] if len(sys.argv) > 1 else 'dev_high_vortex'
+    source = Path(name) if name.endswith('.json') else ASSETS / 'cases' / (name + '.json')
+    model = load_case(source)
+    fast = FastModel(model)
+    polar = PolarModel(fast)
+    rng = np.random.default_rng(479)
+    for trial in range(12):
+        field = .5 * (rng.standard_normal(model.size) + 1j * rng.standard_normal(model.size))
+        initial = fast.relax(field, maxiter=120)
+        print(trial, 'initial', initial[0], initial[2:], flush=True)
+        standard = fast.relax(initial[1], maxiter=1400)
+        print(trial, 'standard', standard[0], standard[2:], flush=True)
+        transformed = polar.relax(initial[1], maxiter=1000)
+        final = fast.relax(transformed[1], maxiter=800)
+        print(trial, 'polar', transformed[0], transformed[2:], 'polish', final[0], final[2:], flush=True)
+
+
+if __name__ == '__main__':
+    main()
