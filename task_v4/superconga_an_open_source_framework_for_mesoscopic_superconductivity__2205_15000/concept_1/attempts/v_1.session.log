+    gradient = 2 * (linear + fast.beta * density * field)
+    energy = dot(field, linear) + .5 * np.dot(fast.beta, density ** 2)
+    direction = -gradient
+    previous_decrease = np.inf
+    for iteration in range(maxiter):
+        hessian_direction = fast.matrix @ direction
+        parallel = 2 * (field.real * direction.real + field.imag * direction.imag)
+        square = direction.real ** 2 + direction.imag ** 2
+        derivative = dot(gradient, direction)
+        second = 2 * dot(direction, hessian_direction) + np.dot(fast.beta, 2 * density * square + parallel ** 2)
+        third = 3 * np.dot(fast.beta, parallel * square)
+        fourth = 2 * np.dot(fast.beta, square ** 2)
+        step = line_step(derivative, second, third, fourth)
+        field += step * direction
+        linear += step * hessian_direction
+        density = field.real ** 2 + field.imag ** 2
+        next_gradient = 2 * (linear + fast.beta * density * field)
+        next_energy = dot(field, linear) + .5 * np.dot(fast.beta, density ** 2)
+        decrease = energy - next_energy
+        if np.max(abs(next_gradient)) < 1e-5 or (0 <= decrease < tol * max(1, abs(energy)) and previous_decrease < tol * max(1, abs(energy))):
