+import sys
+import json
+from pathlib import Path
+ROOT = Path(__file__).resolve().parents[1]
+ASSETS = ROOT.parents[1] / 'participant' / 'input'
+sys.path.insert(0, str(ROOT))
+from solve import Model, Budget, conjugate_relax, Topology
+sys.path.insert(0, str(ASSETS))
+from gl_model import GLModel
+import numpy as np
+
+
+def main():
+    rng = np.random.default_rng(19683)
+    records = []
+    for source in sorted((ASSETS / 'cases').glob('*.json')):
+        case = json.load(open(source))
+        model = Model(case)
+        reference = GLModel(case)
+        field = rng.standard_normal(model.size) + 1j * rng.standard_normal(model.size)
+        energy, gradient = model.energy_gradient(field)
+        exact_energy, exact_gradient = reference.energy_gradient(model.full(field))
+        energy_error = abs(energy - exact_energy)
+        gradient_error = float(np.max(abs(gradient - exact_gradient[model.mask])))
+        assert energy_error < 1e-9 and gradient_error < 1e-11
+        direction = rng.standard_normal(model.size) + 1j * rng.standard_normal(model.size)
+        direction /= np.linalg.norm(direction)
+        difference = (model.energy_gradient(field + 1e-5 * direction)[0] - model.energy_gradient(field - 1e-5 * direction)[0]) / 2e-5
+        analytic = np.vdot(gradient, direction).real
+        derivative_error = abs(difference - analytic)
+        assert derivative_error < 1e-5
+        chi = rng.uniform(-100, 100, model.shape)
+        rotated = np.exp(1j * chi)
+        gauge_case = dict(case)
+        gauge_case['ax'] = (model.ax + chi[:, 1:] - chi[:, :-1]).tolist()
+        gauge_case['ay'] = (model.ay + chi[1:] - chi[:-1]).tolist()
+        gauge_initial = model.full(model.initial) * rotated
+        gauge_case['initial_real'] = gauge_initial.real.tolist()
+        gauge_case['initial_imag'] = gauge_initial.imag.tolist()
+        transformed = Model(gauge_case)
+        gauge_energy, gauge_gradient = transformed.energy_gradient(field * rotated[model.mask])
+        gauge_energy_error = abs(gauge_energy - energy)
+        gauge_gradient_error = float(np.max(abs(gauge_gradient - gradient * rotated[model.mask])))
+        assert gauge_energy_error < 1e-9 and gauge_gradient_error < 1e-10
+        original_run = conjugate_relax(model, model.initial, Budget(5), reserve=.1, maxiter=80, tolerance=0)
+        gauge_run = conjugate_relax(transformed, transformed.initial, Budget(5), reserve=.1, maxiter=80, tolerance=0)
+        trajectory_error = abs(original_run[0] - gauge_run[0])
+        assert trajectory_error < 1e-6
+        positions, charges = Topology(model).vortices(original_run[1])
+        other_positions, other_charges = Topology(transformed).vortices(original_run[1] * rotated[model.mask])
+        assert np.array_equal(positions, other_positions) and np.array_equal(charges, other_charges)
+        record = {'case': source.stem, 'energy_error': energy_error, 'gradient_error': gradient_error, 'directional_derivative_error': derivative_error, 'gauge_energy_error': gauge_energy_error, 'gauge_gradient_error': gauge_gradient_error, 'cg_gauge_trajectory_energy_error': trajectory_error}
+        records.append(record)
+        print(record, flush=True)
+    with open(ROOT / 'experiments' / 'model_checks.json', 'w') as stream:
+        json.dump(records, stream, indent=2)
+
+
+if __name__ == '__main__':
+    main()

