+def line_step(derivative, linear, quadratic, cubic):
+    upper = min(1.0, -derivative / linear) if linear > 0 else 1.0
+    for iteration in range(60):
+        value = derivative + upper * (linear + upper * (quadratic + upper * cubic))
+        if value >= 0:
+            break
+        upper *= 2
