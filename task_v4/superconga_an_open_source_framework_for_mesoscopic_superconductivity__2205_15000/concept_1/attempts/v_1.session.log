+    model = load_case(source)
+    fast = FastModel(model)
+    topo = Topology(model)
+    print('size', model.size, 'pins', topo.pins, 'holes', topo.holes, 'core', topo.core, flush=True)
+    rng = np.random.default_rng(4787)
+    baseline = fast.relax(fast.initial, tol=1e-12, maxiter=1300)
+    best_energy, best = baseline[:2]
+    print('baseline', baseline[0], baseline[2:], 'vortices', topo.vortices(best), flush=True)
+    current, current_energy = best.copy(), best_energy
+    kinds = ['random', 'relocate', 'insert', 'delete', 'hole', 'patch', 'noise']
+    rounds = int(sys.argv[2]) if len(sys.argv) > 2 else 140
+    started = time.monotonic()
+    for trial in range(rounds):
+        kind = kinds[trial % len(kinds)]
+        if kind == 'random':
+            candidate = .5 * (rng.standard_normal(model.size) + 1j * rng.standard_normal(model.size))
+        else:
+            candidate = topo.move(current, rng, kind)
+        energy, field, iterations, calls, elapsed = fast.relax(candidate, maxiter=1100)
+        accepted = energy < current_energy or rng.random() < np.exp(min(0, (current_energy - energy) / .6))
