+        if value < 0:
+            lower = step
+        else:
+            upper = step
+        slope = linear + step * (2 * quadratic + step * 3 * cubic)
+        candidate = step - value / slope if slope > 0 else -1
+        step = candidate if lower < candidate < upper else (lower + upper) / 2
+    return step
