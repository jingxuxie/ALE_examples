+        rows, cols = [round(side * scale) for side in old_shape]
+        case['shape'] = [rows, cols]
+        case['case_id'] = 'scaled_' + source.stem
+        for key in ['mask', 'alpha', 'beta', 'initial_real', 'initial_imag', 'ax', 'ay', 'kx', 'ky']:
+            shape = (rows, cols - 1) if key in ['ax', 'kx'] else (rows - 1, cols) if key in ['ay', 'ky'] else (rows, cols)
+            array = resample(np.asarray(case[key]), shape, order=0 if key == 'mask' else 1)
+            if key in ['ax', 'ay']:
+                array *= scale
+            if key == 'mask':
+                array = array.astype(int)
+            case[key] = array.tolist()
+        with open(Path(__file__).parent / (case['case_id'] + '.json'), 'w') as stream:
