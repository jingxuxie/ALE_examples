+        next_gradient = 2 * (linear + model.beta * density * field)
+        next_energy = dot(field, linear) + 0.5 * np.dot(model.beta, density ** 2)
+        decrease = energy - next_energy
+        gradient_square = dot(next_gradient, next_gradient)
