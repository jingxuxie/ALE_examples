+
+class Topology:
+    def __init__(self, model):
+        self.model = model
+        self.mask = model.mask
+        self.rows, self.cols = np.nonzero(model.mask)
+        self.points = self.cols + 1j * self.rows
+        self.flux = model.ax[:-1] + model.ay[:, 1:] - model.ax[1:] - model.ay[:, :-1]
+        self.faces = self.mask[:-1, :-1] & self.mask[:-1, 1:] & self.mask[1:, :-1] & self.mask[1:, 1:]
+        labels, count = ndimage.label(~model.mask)
+        outer = set(np.concatenate((labels[0], labels[-1], labels[:, 0], labels[:, -1])))
+        self.holes = []
+        for label in range(1, count + 1):
+            if label not in outer:
+                rows, cols = np.nonzero(labels == label)
+                self.holes.append(np.mean(cols) + 1j * np.mean(rows))
+        labels, count = ndimage.label((model.alpha > .2) & model.mask)
+        self.pins = []
+        for label in range(1, count + 1):
+            rows, cols = np.nonzero(labels == label)
+            weights = model.alpha[rows, cols]
+            self.pins.append(np.sum(weights * (cols + 1j * rows)) / np.sum(weights))
+        self.centers = np.array(self.holes + self.pins)
+        self.holes = np.array(self.holes)
+        self.pins = np.array(self.pins)
+        self.core = np.sqrt(np.median(model.kx[model.kx > 0]) / np.median(-model.alpha[model.mask & (model.alpha < 0)])) / model.h
+        self.bulk = np.sqrt(np.maximum(-model.alpha[model.mask], 0) / model.beta[model.mask])
+
+    def vortices(self, field):
+        full = np.zeros(self.model.shape, complex)
+        full[self.mask] = field
+        phase_x = np.angle(self.model.ux * full[:, 1:] * full[:, :-1].conj())
+        phase_y = np.angle(self.model.uy * full[1:, :] * full[:-1, :].conj())
+        winding = np.rint((phase_x[:-1] + phase_y[:, 1:] - phase_x[1:] - phase_y[:, :-1] + self.flux) / (2 * np.pi))
+        rows, cols = np.nonzero(self.faces & (abs(winding) > .5))
+        return cols + .5 + 1j * (rows + .5), winding[rows, cols]
+
+    def vortex(self, field, center, charge, remove=False):
+        displacement = self.points - center
+        rotation = np.exp(1j * charge * np.angle(displacement))
+        if remove:
+            magnitude = abs(field)
+            healing = np.exp(-abs(displacement) ** 2 / (2 * self.core) ** 2)
+            magnitude += np.maximum(0, self.bulk - magnitude) * healing
+            return magnitude * field / np.maximum(abs(field), 1e-30) * rotation
+        return field * rotation * np.tanh(abs(displacement) / self.core)
+
+    def move(self, field, rng, kind):
+        if kind == 'hole':
+            if len(self.holes):
+                center = rng.choice(self.holes)
+                return field * np.exp(rng.choice([-1, 1]) * 1j * np.angle(self.points - center))
+            kind = 'insert'
+        positions, charges = self.vortices(field)
+        if kind in ('delete', 'relocate') and len(positions):
+            chosen = rng.integers(len(positions))
+            center = positions[chosen]
+            charge = charges[chosen]
+            candidate = self.vortex(field, center, -charge, remove=True)
+            if kind == 'delete':
+                return candidate
+            if len(self.centers) and rng.random() < .6:
+                target = rng.choice(self.centers)
+            else:
+                target = center + rng.normal(0, 5) + 1j * rng.normal(0, 5)
+            return self.vortex(candidate, target, charge)
+        if kind in ('insert', 'delete', 'relocate'):
+            if len(self.centers) and rng.random() < .65:
+                target = rng.choice(self.centers)
+            else:
+                target = rng.choice(self.points) + .5 + .5j
+            charge = np.sign(np.median(self.flux[self.faces]))
+            return self.vortex(field, target, charge)
+        if kind == 'patch':
+            center = rng.choice(self.points)
+            weight = np.exp(-abs(self.points - center) ** 2 / rng.uniform(16, 100))
+            return field * np.exp(4j * weight * rng.standard_normal(len(field)))
+        if kind == 'noise':
+            return field * np.exp(1j * rng.uniform(1.3, 2.8) * rng.standard_normal(len(field)))
+        raise ValueError(kind)
+
+
+def main():
+    name = sys.argv[1] if len(sys.argv) > 1 else 'dev_high_vortex'
