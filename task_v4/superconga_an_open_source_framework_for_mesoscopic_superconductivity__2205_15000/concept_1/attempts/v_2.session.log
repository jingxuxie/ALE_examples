+        density = field.real ** 2 + field.imag ** 2
+        linear = self.matrix @ field
+        nonlinear = self.beta * density
+        energy = dot(field, linear) + 0.5 * np.dot(density, nonlinear)
+        return float(energy), 2 * (linear + nonlinear * field)
