+import json
+import sys
+import time
+
+from london import np, Model, London, Budget, anneal, conjugate_relax
+from search import search
+
+
+def fit(basis, states, values, ridge=2.0):
+    count = len(basis.linear)
+    offsets = -2 * np.floor(basis.center) - 1
+    distances = abs(basis.centers[:, None] - basis.centers[None, :])
+    neighbors = np.argsort(distances, axis=1)[:, 1:9]
+    connected = np.zeros((count, count), dtype=bool)
+    connected[np.arange(count)[:, None], neighbors] = True
+    first, second = np.nonzero(np.triu(connected | connected.T, 1))
+    states = np.asarray(states)
+    spins = 2 * states + offsets
+    features = np.column_stack((2 * states, spins[:, first] * spins[:, second] - offsets[first] * offsets[second]))
+    residuals = values - np.einsum('ij,ij->i', states, states @ basis.hessian) - 2 * states @ basis.linear
+    if len(values) < features.shape[1]:
+        coefficients = features.T @ np.linalg.solve(features @ features.T + ridge * np.eye(len(values)), residuals)
+    else:
+        coefficients = np.linalg.solve(features.T @ features + ridge * np.eye(features.shape[1]), features.T @ residuals)
+    linear = basis.linear + coefficients[:count]
+    hessian = basis.hessian.copy()
+    pair_coefficients = coefficients[count:]
+    np.add.at(linear, first, pair_coefficients * offsets[second])
+    np.add.at(linear, second, pair_coefficients * offsets[first])
+    hessian[first, second] += 2 * pair_coefficients
+    hessian[second, first] += 2 * pair_coefficients
+    error = np.sqrt(np.mean((residuals - features @ coefficients) ** 2))
+    return hessian, linear, error
+
+
+def run(path, output):
+    started = time.monotonic()
+    with open(path) as stream:
+        model = Model(json.load(stream))
+    budget = Budget(54)
+    basis = London(model, model.initial)
+    initial_phase = np.angle(basis.links * model.initial[basis.targets] * model.initial[basis.sources].conj())
+    projector = np.linalg.solve(basis.hessian, basis.projected.T * basis.weights)
+    baseline = model.energy_gradient(model.initial)[0]
+    best_energy = baseline
+    best = model.initial.copy()
+    zero = np.zeros(len(basis.centers))
+    seen = {tuple(zero)}
+    archive = {tuple(zero): 0}
+    trials = 0
+    for iteration in range(12):
+        if budget.remaining() < 4:
+            break
+        starts = [sector for sector, energy in sorted(archive.items(), key=lambda item: item[1])[:32]]
+        if iteration == 0:
+            energies, changes = anneal(basis.hessian, basis.linear, replicas=512, sweeps=300, seed=4)
+        else:
+            hessian, linear, error = fit(basis, list(archive.keys()), np.array(list(archive.values())))
+            print('fit', iteration, 'rms', error, flush=True)
+            energies, changes = search(hessian, linear, basis.centers, replicas=256, sweeps=200,
+                                      seed=iteration+4, starts=starts)
+        print('round', iteration, 'elapsed', time.monotonic()-started, 'prediction', energies[:12], flush=True)
+        batch = 0
+        for predicted, change in zip(energies, changes):
+            if budget.remaining() < 3:
+                break
+            key = tuple(change)
+            if key in seen:
+                continue
+            seen.add(key)
+            candidate = basis.candidate(change)
+            energy, field, rms = conjugate_relax(model, candidate, budget, maxiter=2500, tolerance=1e-11)
+            phase = np.angle(basis.links * field[basis.targets] * field[basis.sources].conj())
+            sector = np.rint(projector @ (phase - initial_phase))
+            seen.add(tuple(sector))
+            archive[tuple(sector)] = min(archive.get(tuple(sector), np.inf), energy - baseline)
+            trials += 1
+            batch += 1
+            if energy < best_energy and rms < .001:
+                best_energy, best = energy, field
+                print('best', trials, energy, rms, 'time', time.monotonic()-started, flush=True)
+            if batch >= 32:
+                break
+    energy, field, rms = conjugate_relax(model, best, budget, maxiter=2500, tolerance=1e-13, reserve=.5)
+    print('done', energy, rms, trials, time.monotonic()-started, flush=True)
+    np.savez_compressed(output, psi=model.full(field))
+
+
+if __name__ == '__main__':
+    run(sys.argv[1], sys.argv[2])
