+class London:
+    def __init__(self, model, field):
+        self.model = model
+        self.field = field
+        topology = Topology(model)
+        self.centers = topology.holes
+        indices = np.full(model.shape, -1, dtype=int)
+        indices[model.mask] = np.arange(model.size)
+        sources = np.concatenate((indices[:, :-1].ravel(), indices[:-1].ravel()))
+        targets = np.concatenate((indices[:, 1:].ravel(), indices[1:].ravel()))
+        valid = (sources >= 0) & (targets >= 0)
+        self.sources = sources[valid]
+        self.targets = targets[valid]
+        self.stiffness = np.concatenate((model.kx.ravel(), model.ky.ravel()))[valid]
+        self.links = np.concatenate((model.ux.ravel(), model.uy.ravel()))[valid]
+        self.incidence = coo_matrix((np.tile([-1., 1.], len(self.sources)),
+                                    (np.repeat(np.arange(len(self.sources)), 2),
+                                     np.column_stack((self.sources, self.targets)).ravel())),
+                                   shape=(len(self.sources), model.size)).tocsr()
+        self.angles = np.angle(topology.points[:, None] - self.centers[None, :])
+        self.raw = self.angles[self.targets] - self.angles[self.sources]
+        self.raw -= 2 * np.pi * np.rint(self.raw / (2 * np.pi))
+        self.build(field)
+
+    def build(self, field):
+        self.field = field
+        weights = self.stiffness * abs(field[self.sources]) * abs(field[self.targets])
+        self.weights = weights
+        phase = np.angle(self.links * field[self.targets] * field[self.sources].conj())
+        incidence = self.incidence[:, 1:]
+        weighted_incidence = incidence.multiply(weights[:, None])
+        laplacian = (incidence.T @ weighted_incidence).tocsc()
+        factor = splu(laplacian)
+        correction = factor.solve(incidence.T @ (weights[:, None] * np.column_stack((self.raw, phase))))
+        projected = self.raw - incidence @ correction[:, :-1]
+        self.phase = phase - incidence @ correction[:, -1]
+        self.rotation = self.angles.copy()
+        self.rotation[1:] -= correction[:, :-1]
+        self.offset = np.zeros(self.model.size)
+        self.offset[1:] = -correction[:, -1]
+        self.hessian = projected.T @ (weights[:, None] * projected)
+        self.linear = projected.T @ (weights * self.phase)
+        self.center = np.linalg.solve(self.hessian, -self.linear)
+        self.projected = projected
