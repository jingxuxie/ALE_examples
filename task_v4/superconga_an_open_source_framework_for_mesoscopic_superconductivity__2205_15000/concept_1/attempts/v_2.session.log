+def search(hessian, linear, centers, replicas=256, sweeps=200, seed=4, starts=None):
+    rng = np.random.default_rng(seed)
+    count = len(linear)
+    center = np.linalg.solve(hessian, -linear)
+    lower = np.floor(center)
