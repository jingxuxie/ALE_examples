/bin/bash -lc "OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 python3 - <<'PY'
import numpy as np
from optimize import Inverse,save_best,OUTPUT
inverse=Inverse(stride=3)
results=[]
for width,height in [(3,8),(8,3),(4,6),(6,4)]:
 for column in range(9-width):
  for row in range(9-height):
   pattern=np.zeros((8,8)); pattern[row:row+height,column:column+width]=1
   error=inverse.error(pattern.ravel())
   results.append((error,(width,height,column,row),pattern.ravel().copy()))
