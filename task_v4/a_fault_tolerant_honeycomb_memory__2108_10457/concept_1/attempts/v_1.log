bash-5.1$ import ctypes
from pathlib import Path
import time

import numpy as np
import pymatching
import stim


class Decoder:
    def __init__(self, model):
        self.model = model
        self.checks = model.num_detectors
        self.baseline = pymatching.Matching.from_detector_error_model(model, enable_correlations=True)
        errors = {}
        for instruction in model.flattened():
            if instruction.type != 'error':
                continue
            probability = instruction.args_copy()[0]
            detectors = set()
            logical = 0
            components = []
            current = []
            component_logical = 0
            for target in instruction.targets_copy():
                if target.is_relative_detector_id():
                    detectors.symmetric_difference_update([target.val])
                    current.append(target.val)
                elif target.is_logical_observable_id():
                    logical ^= 1
                    component_logical ^= 1
                else:
                    components.append((tuple(sorted(current)), component_logical))
                    current = []
                    component_logical = 0
            components.append((tuple(sorted(current)), component_logical))
            key = (tuple(sorted(detectors)), logical)
            if key in errors:
                previous = errors[key][0]
                errors[key] = (previous + probability - 2 * previous * probability, errors[key][1])
            else:
                errors[key] = (probability, components)
        self.detectors = [key[0] for key in errors]
        self.logical = np.array([key[1] for key in errors], dtype=np.uint8)
        self.probability = np.array([value[0] for value in errors.values()])
        self.prior = np.log((1 - self.probability) / self.probability)
        self.variables = len(errors)
        adjacent = [[] for _ in range(self.checks)]
        for variable, detectors in enumerate(self.detectors):
            for detector in detectors:
                adjacent[detector].append(variable)
        self.starts = np.array([0] + list(np.cumsum([len(row) for row in adjacent])), dtype=np.int32)
        self.neighbors = np.array([value for row in adjacent for value in row], dtype=np.int32)
        edges = {}
        self.edge_variables = []
        self.edge_ids = []
        for variable, (_, components) in enumerate(errors.values()):
            for detectors, logical in components:
                if not detectors:
                    continue
                key = (detectors, logical)
                if key not in edges:
                    edges[key] = len(edges)
                self.edge_variables.append(variable)
                self.edge_ids.append(edges[key])
        self.edges = list(edges)
        self.edge_variables = np.array(self.edge_variables)
        self.edge_ids = np.array(self.edge_ids)
        self.lib = ctypes.CDLL(str(Path(__file__).with_name('bp.so')))
        self.lib.bp.argtypes = [ctypes.c_int] * 4 + [ctypes.c_void_p] * 4 + [ctypes.c_int, ctypes.c_double, ctypes.c_double] + [ctypes.c_void_p] * 3
        self.lib.bp_fast.argtypes = self.lib.bp.argtypes + [ctypes.c_int]
        self.lib.osd.argtypes = [ctypes.c_int] * 3 + [ctypes.c_void_p] * 6 + [ctypes.c_int] + [ctypes.c_void_p] * 2 + [ctypes.c_int] * 2
        self.lib.matrix_rank.argtypes = [ctypes.c_int] * 2 + [ctypes.c_void_p] * 2
        self.lib.matrix_rank.restype = ctypes.c_int
        self.rank = self.lib.matrix_rank(self.checks, self.variables, self.starts.ctypes.data, self.neighbors.ctypes.data)

    def osd(self, syndromes, posterior, order_count=60, max_free=0):
        syndromes = np.ascontiguousarray(syndromes, dtype=np.uint8)
        posterior = np.ascontiguousarray(posterior, dtype=np.float64)
        minima = np.empty((len(syndromes), 2))
        evidence = np.empty_like(minima)
        self.lib.osd(len(syndromes), self.checks, self.variables,
                     self.starts.ctypes.data, self.neighbors.ctypes.data,
                     self.prior.ctypes.data, self.logical.ctypes.data,
                     syndromes.ctypes.data, posterior.ctypes.data, order_count,
                     minima.ctypes.data, evidence.ctypes.data, self.rank, max_free)
        return minima, evidence

    def beliefs(self, syndromes, iterations=30, damping=0.0, scale=1.0, mode=0):
        syndromes = np.ascontiguousarray(syndromes, dtype=np.uint8)
        posterior = np.empty((len(syndromes), self.variables), dtype=np.float64)
        converged = np.empty(len(syndromes), dtype=np.uint8)
        used = np.empty(len(syndromes), dtype=np.int32)
        self.lib.bp_fast(len(syndromes), self.checks, self.variables, len(self.neighbors),
                    self.starts.ctypes.data, self.neighbors.ctypes.data, self.prior.ctypes.data,
                    syndromes.ctypes.data, iterations, damping, scale,
                    posterior.ctypes.data, converged.ctypes.data, used.ctypes.data, mode)
        return posterior, converged, used

    def matching(self, syndrome, posterior, mix=0.0):
        probability = 1 / (1 + np.exp(np.clip(posterior, -40, 40)))
        products = np.ones(len(self.edges))
        np.multiply.at(products, self.edge_ids, 1 - 2 * probability[self.edge_variables])
        probability = np.clip((1 - products) / 2, 1e-12, 1 - 1e-12)
        weights = np.log((1 - probability) / probability)
        graph = pymatching._cpp_pymatching.MatchingGraph(self.checks, 1)
        for (detectors, logical), weight in zip(self.edges, weights):
            faults = {0} if logical else set()
            if len(detectors) == 1:
                graph.add_boundary_edge(detectors[0], faults, weight, -1, 'independent')
            else:
                graph.add_edge(detectors[0], detectors[1], faults, weight, -1, 'independent')
        return graph.decode(np.flatnonzero(syndrome).astype(np.uint64))[0][0]

    def decode(self, syndromes, iterations=30, damping=0.0, scale=1.0):
        posterior, converged, used = self.beliefs(syndromes, iterations, damping, scale)
        predictions = ((posterior < 0) @ self.logical) % 2
        for shot in np.flatnonzero(converged == 0):
            predictions[shot] = self.matching(syndromes[shot], posterior[shot])
        return predictions, converged, used
