#!/usr/bin/python3
import ctypes
import errno
import os
from pathlib import Path
import resource
import sys


class Ruleset(ctypes.Structure):
    _fields_ = [("handled_access_fs", ctypes.c_uint64)]


class PathRule(ctypes.Structure):
    _pack_ = 1
    _fields_ = [("allowed_access", ctypes.c_uint64), ("parent_fd", ctypes.c_int32)]


def restrict(readable, writable):
    library = ctypes.CDLL(None, use_errno=True)
    library.syscall.restype = ctypes.c_long
    abi = library.syscall(444, 0, 0, 1)
    if abi < 1:
        raise RuntimeError("Landlock required; no unsandboxed fallback")
    handled = (1 << (15 if abi >= 3 else 14 if abi >= 2 else 13)) - 1
    attribute = Ruleset(handled)
    descriptor = library.syscall(444, ctypes.byref(attribute), ctypes.sizeof(attribute), 0)
    if descriptor < 0:
        raise OSError(ctypes.get_errno(), "create_ruleset")
    try:
        for path, write in [(path, False) for path in readable] + [(path, True) for path in writable]:
            path = Path(path).resolve(strict=True)
            access = handled if write else (1 << 0) | (1 << 2) | (1 << 3)
            if not path.is_dir():
                access &= (1 << 0) | (1 << 1) | (1 << 2) | (1 << 14)
            parent = os.open(path, os.O_PATH | os.O_CLOEXEC)
            try:
                rule = PathRule(access, parent)
                if library.syscall(445, descriptor, 1, ctypes.byref(rule), 0) != 0:
                    raise OSError(ctypes.get_errno(), "add_rule")
            finally:
                os.close(parent)
        if library.prctl(38, 1, 0, 0, 0) != 0 or library.syscall(446, descriptor, 0) != 0:
            raise OSError(ctypes.get_errno(), "restrict_self")
    finally:
        os.close(descriptor)


def deny_unsafe_syscalls():
    library = ctypes.CDLL("libseccomp.so.2", use_errno=True)
    library.seccomp_init.argtypes = [ctypes.c_uint32]
    library.seccomp_init.restype = ctypes.c_void_p
    library.seccomp_syscall_resolve_name.argtypes = [ctypes.c_char_p]
    library.seccomp_syscall_resolve_name.restype = ctypes.c_int
    library.seccomp_rule_add.argtypes = [ctypes.c_void_p, ctypes.c_uint32, ctypes.c_int, ctypes.c_uint]
    library.seccomp_load.argtypes = [ctypes.c_void_p]
    library.seccomp_release.argtypes = [ctypes.c_void_p]
    context = library.seccomp_init(0x7FFF0000)
    if not context:
        raise RuntimeError("seccomp initialization")
    denied = ("socket", "connect", "ptrace", "process_vm_readv", "process_vm_writev",
              "pidfd_getfd", "pidfd_open", "mount", "umount2", "pivot_root", "unshare", "setns",
              "bpf", "perf_event_open", "open_by_handle_at", "name_to_handle_at", "io_uring_setup",
              "userfaultfd", "kill", "tkill", "tgkill", "pidfd_send_signal", "truncate", "ftruncate",
              "chmod", "fchmod", "fchmodat", "chown", "fchown", "lchown", "fchownat",
              "utime", "utimes", "utimensat", "futimesat", "sched_setaffinity")
    try:
        for name in denied:
            number = library.seccomp_syscall_resolve_name(name.encode())
            if number >= 0 and library.seccomp_rule_add(context, 0x00050000 | errno.EPERM, number, 0):
                raise RuntimeError("seccomp rule: " + name)
        if library.seccomp_load(context):
            raise RuntimeError("seccomp load")
    finally:
        library.seccomp_release(context)


def main():
    arguments = sys.argv[1:]
    if arguments == ["--help"]:
        print("Fail-closed same-path allowlist transport: --as-pid-1 --perms")
        return
    readable, writable = [], []
    index = 0
    while index < len(arguments):
        option = arguments[index]
        if option == "--":
            index += 1
            break
        if not option.startswith("--"):
            break
        if option in ("--ro-bind", "--bind", "--ro-bind-try", "--bind-try"):
            source, destination = arguments[index + 1:index + 3]
            if source != destination or source == "/":
                raise RuntimeError("adapter only supports explicit same-path allowlist mounts")
            if Path(source).exists():
                (writable if option in ("--bind", "--bind-try") else readable).append(source)
            elif not option.endswith("-try"):
                raise RuntimeError("missing mount source")
            index += 3
        elif option in ("--tmpfs", "--remount-ro", "--perms", "--cap-drop", "--proc", "--dev", "--dir"):
            value = arguments[index + 1]
            if option == "--tmpfs" and value != "/" and Path(value).exists():
                if any(Path(value).iterdir()) if Path(value).is_dir() else Path(value).stat().st_size:
                    raise RuntimeError("cannot safely shadow a populated directory")
            if option == "--dev":
                readable.extend(["/dev/urandom", "/dev/random"])
                writable.append("/dev/null")
            index += 2
        elif option in ("--as-pid-1", "--new-session", "--die-with-parent", "--unshare-user", "--unshare-pid", "--unshare-ipc", "--unshare-net"):
            index += 1
        else:
            raise RuntimeError("unsupported sandbox option " + option)
    command = arguments[index:]
    if not command or not readable:
        raise RuntimeError("missing explicit allowlist or command")
    for name in ("OPENAI_API_KEY", "ANTHROPIC_API_KEY", "AZURE_OPENAI_API_KEY", "AWS_SECRET_ACCESS_KEY"):
        os.environ.pop(name, None)
    os.environ["CUDA_VISIBLE_DEVICES"] = ""
    available = sorted(os.sched_getaffinity(0))
    os.sched_setaffinity(0, set(available[:4]))
    soft, hard = resource.getrlimit(resource.RLIMIT_AS)
    memory = 8 * 1024**3 if hard == resource.RLIM_INFINITY else min(hard, 8 * 1024**3)
    resource.setrlimit(resource.RLIMIT_AS, (memory, memory))
    deny_unsafe_syscalls()
    restrict(readable, writable)
    os.execvp(command[0], command)


if __name__ == "__main__":
    main()
