+    assert np.all(np.isfinite(mixing)) and np.all(mixing > 0)
+    assert abs(mixing.sum() - 1) < 1e-10
+    weights = np.asarray(model[\"weights\"])
+    biases = np.asarray(model[\"biases\"])
