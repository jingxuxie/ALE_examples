+        if self.best is None or (objective < self.best[0] and ess > 0.5):
+            self.best = (objective, vector.copy(), reverse, forward, ess)
+        self.calls += 1
+        return objective, np.concatenate(gradient)
+
+    def fit(self, iterations=50):
+        result = minimize(self.evaluate, np.zeros(self.size), method=\"L-BFGS-B\", jac=True,
+                          options={\"maxiter\": iterations, \"ftol\": 1e-11, \"gtol\": 1e-7, \"maxls\": 15, \"maxcor\": 12})
+        return self.unpack(self.best[1]), self.best[2:], self.calls
