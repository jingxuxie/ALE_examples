+def fit_logistic(features, positive, negative, initial=None, tolerance=1e-9):
+    mass = positive + negative
+    keep = mass > 1e-12 * mass.sum()
+    features = np.ascontiguousarray(features[keep])
+    positive = positive[keep]
+    mass = mass[keep]
+    scale = mass.sum()
+    mass = mass / scale
