+    output = {key: [] for key in model}
+    for component in range(len(model[\"mixing\"])):
+        order = model[\"orders\"][component]
+        free = order[3:]
+        local_spins = configurations(len(free))
+        fixed_indices = sum((((component >> position) & 1) << site) for position, site in enumerate(pivots))
+        indices = np.full(len(local_spins), fixed_indices, dtype=np.uint32)
+        for position, site in enumerate(free):
+            indices += (local_spins[:, position] > 0).astype(np.uint32) << site
+        local_target = log_target[indices]
+        local_target -= logsumexp(local_target)
+        weights = np.array(model[\"weights\"][component])
+        biases = np.array(model[\"biases\"][component])
+        initial = [np.concatenate(([biases[site]], weights[site, free[:position]])) for position, site in enumerate(free)]
+        objective = ComponentObjective(local_target, initial, alpha)
+        parameters, metrics, calls = objective.fit(iterations)
+        for position, site in enumerate(free):
+            biases[site] = parameters[position][0]
