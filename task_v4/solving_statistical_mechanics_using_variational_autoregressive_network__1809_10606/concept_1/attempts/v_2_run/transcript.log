+from prototype import configurations, exact_target
+
+
+class ComponentObjective:
+    def __init__(self, log_target, initial, alpha=0.05):
+        self.log_target = log_target
+        self.probability = np.exp(log_target)
+        self.count = len(initial)
+        self.alpha = alpha
+        spins = configurations(self.count)
+        self.design = [np.ascontiguousarray(np.column_stack((np.ones(1 << position), spins[:1 << position, :position]))) for position in range(self.count)]
+        self.marginals = [self.probability]
+        for position in range(self.count - 1, -1, -1):
+            self.marginals.append(self.marginals[-1].reshape(2, -1).sum(axis=0))
+        self.marginals = self.marginals[::-1]
+        self.initial = initial
+        self.transforms = []
+        for position in range(self.count - 1):
+            design = self.design[position]
+            probability = expit(design @ initial[position])
+            curvature = self.marginals[position] * probability * (1 - probability)
+            hessian = design.T @ (curvature[:, None] * design)
+            hessian.flat[::position + 2] += 1e-6
+            factor = cholesky(hessian, lower=True, check_finite=False)
+            self.transforms.append(solve_triangular(factor.T, np.eye(position + 1), lower=False, check_finite=False))
+        self.size = self.count * (self.count - 1) // 2
+        self.best = None
+        self.calls = 0
+
+    def unpack(self, vector):
+        parameters = []
+        start = 0
+        for position, transform in enumerate(self.transforms):
+            parameters.append(self.initial[position] + transform @ vector[start:start + position + 1])
+            start += position + 1
+        parameters.append(self.initial[-1])
+        return parameters
+
+    def evaluate(self, vector):
+        parameters = self.unpack(vector)
+        joint = np.zeros(1)
+        probabilities = []
+        for position in range(self.count):
+            logits = self.design[position] @ parameters[position]
+            probabilities.append(expit(logits))
+            joint = np.concatenate((joint - np.logaddexp(0, logits), joint - np.logaddexp(0, -logits)))
+        difference = joint - self.log_target
+        probability = np.exp(joint)
+        reverse = probability @ difference
+        forward = -self.probability @ difference
+        ess = np.exp(-logsumexp(2 * self.log_target - joint))
+        residual = probability * (difference - reverse)
+        gradient = [None] * (self.count - 1)
+        for position in range(self.count - 1, -1, -1):
+            children = residual.reshape(2, -1)
+            parent = children.sum(axis=0)
+            if position < self.count - 1:
+                logit_gradient = children[1] - parent * probabilities[position]
+                if self.alpha:
+                    logit_gradient += self.alpha * (self.marginals[position] * probabilities[position] - self.marginals[position + 1].reshape(2, -1)[1])
+                raw_gradient = self.design[position].T @ logit_gradient
+                gradient[position] = self.transforms[position].T @ raw_gradient
+            residual = parent
