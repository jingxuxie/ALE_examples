import json, os, time
import numpy as np, scipy
from pathlib import Path
print('numpy', np.__version__, 'scipy', scipy.__version__, 'cpus', len(os.sched_getaffinity(0)))
for path in sorted(Path('input').glob('*.json')):
    instance=json.loads(path.read_text()); couplings=np.array(instance['couplings']); fields=np.array(instance['fields'])
