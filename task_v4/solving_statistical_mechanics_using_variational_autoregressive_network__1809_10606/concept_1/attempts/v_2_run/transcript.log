+import os
+
+for variable in (\"OPENBLAS_NUM_THREADS\", \"OMP_NUM_THREADS\", \"MKL_NUM_THREADS\"):
+    os.environ[variable] = \"1\"
+
+import itertools
+import json
+import time
+from pathlib import Path
+
+import numpy as np
+from scipy.special import logsumexp
+
+import prototype
+
+
+def graph_order(couplings, pivots):
+    count = len(couplings)
+    adjacency = [sum(1 << other for other in range(count) if abs(couplings[site, other]) > 1e-10) for site in range(count)]
+    remaining = ((1 << count) - 1) "'^ sum(1 << site for site in pivots)
+    order = []
+    cost = 0
+    while remaining:
+        candidates = [site for site in range(count) if remaining & (1 << site)]
+        site = min(candidates, key=lambda site: ((adjacency[site] & remaining).bit_count(), np.sum(np.abs(couplings[site]))))
+        neighbors = adjacency[site] & remaining
+        degree = neighbors.bit_count()
+        cost += max(0, 3 ** (degree - 2) - 1)
+        remaining ''^= 1 << site
+        for other in candidates:
+            if neighbors & (1 << other):
+                adjacency[other] |= neighbors & ~(1 << other)
+        order.append(site)
+    return cost, order[::-1]
+
+
+def graph_cutsets(couplings, limit=5):
+    count = len(couplings)
+    candidates = []
+    for pivots in itertools.combinations(range(count), 3):
+        cost, order = graph_order(couplings, pivots)
+        candidates.append((cost, pivots, order))
+    candidates.sort()
+    chosen = []
+    for cost, pivots, order in candidates:
+        if all(len(set(pivots) & set(previous[1])) <= 1 for previous in chosen):
+            chosen.append((cost, pivots, order))
+        if len(chosen) == limit:
+            break
+    return chosen
+
+
+def component_arrays(probability, order, fixed):
+    free = [site for site in order if site not in fixed]
+    spins = prototype.configurations(len(free))
+    indices = np.full(len(spins), sum((int(value > 0) << site) for site, value in fixed.items()), dtype=np.uint32)
+    for position, site in enumerate(free):
+        indices += (spins[:, position] > 0).astype(np.uint32) << site
+    local = probability[indices]
+    mass = local.sum()
+    return spins, local / mass, free
+
+
+def component_metrics(probability, order, fixed, weights, biases):
+    spins, target, free = component_arrays(probability, order, fixed)
+    log_target = np.log(np.maximum(target, 1e-300))
+    log_joint = np.zeros(1)
+    for position, site in enumerate(free):
+        logits = spins[:1 << position, :position] @ weights[site, free[:position]] + biases[site]
+        log_joint = np.concatenate((log_joint - np.logaddexp(0, logits), log_joint - np.logaddexp(0, -logits)))
+    reverse = np.exp(log_joint) @ (log_joint - log_target)
+    forward = target @ (log_target - log_joint)
+    ess = np.exp(-logsumexp(2 * log_target - log_joint))
+    return reverse, forward, ess
+
+
+def covariance_order(spins, probability, free):
+    mean = probability @ spins
+    covariance = spins.T @ (probability[:, None] * spins) - mean[:, None] * mean
+    order = []
+    remaining = list(range(len(free)))
+    while remaining:
+        variance = np.maximum(np.diag(covariance), 1e-8)
+        score = np.sum(covariance ** 2, axis=0) / variance
+        site = max(remaining, key=lambda site: score[site])
+        order.append(free[site])
+        remaining.remove(site)
+        covariance -= np.outer(covariance[:, site], covariance[site]) / variance[site]
+    return order
+
+
