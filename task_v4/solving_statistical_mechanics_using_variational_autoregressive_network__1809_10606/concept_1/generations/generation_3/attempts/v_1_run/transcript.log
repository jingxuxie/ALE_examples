+    mixing = np.exp(mixing - logsumexp(mixing))
+    if verbose:
+        print('product refinement', calls, best_metrics, 'elapsed', time.monotonic() - started, flush=True)
+    return {'mixing': mixing.tolist(), 'weights': weights.tolist(), 'biases': biases.tolist(), 'orders': model['orders']}
