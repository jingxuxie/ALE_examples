+        local = np.exp(-np.logaddexp(0, -local_spins[None, :, :] *
+                                   (local_spins @ weights.transpose(0, 2, 1) + biases[:, None, :])).sum(axis=2))
+        variances.append(.5 * np.sum((local[0] - local[1]) ** 2 / np.maximum(local[0] + local[1], 1e-300)))
+        indices = (spins[:, block] > 0) @ (1 << np.arange(len(block)))
+        tables.append(local[:, indices])
+    if len(blocks) == 5:
+        ranked = np.argsort(variances)
