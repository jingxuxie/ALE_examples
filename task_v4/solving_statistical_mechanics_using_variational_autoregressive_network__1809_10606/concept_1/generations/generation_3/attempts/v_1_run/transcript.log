+import time
+from concurrent.futures import ThreadPoolExecutor
+import numpy as np
+from scipy.linalg import cholesky, solve_triangular
+from scipy.optimize import minimize
+from scipy.special import expit, logsumexp
+from regional import configurations, regions
+
+
+class ProductDeadline(Exception):
+    pass
+
+
+def refine_product(instance, model, seconds, verbose=False):
+    started = time.monotonic()
+    deadline = started + seconds
+    count = instance['n']
+    couplings = np.asarray(instance['couplings'])
+    fields = np.asarray(instance['fields'])
+    blocks = regions(couplings)
+    spins = configurations(count)
+    log_target = .5 * np.sum(spins * (spins @ couplings), axis=1) + spins @ fields
+    log_target -= logsumexp(log_target)
+    target = np.exp(log_target)
+    indices = [np.asarray((spins[:, block] > 0) @ (1 << np.arange(len(block))), dtype=np.int32) for block in blocks]
+    matrices = np.asarray(model['weights'])
+    biases = np.asarray(model['biases'])
+    initial_mixing = np.log(model['mixing'])
+    entries = []
+    size = 0
+    for component in range(8):
+        local_entries = []
+        for block in blocks:
+            order = [site for site in model['orders'][component] if site in block]
+            local_order = [block.index(site) for site in order]
+            local_spins = configurations(len(block))[:, local_order]
+            design = np.column_stack((np.ones(len(local_spins)), local_spins))
+            parameters = []
+            slices = []
+            transforms = []
+            local_logs = np.zeros(len(local_spins))
+            for position, site in enumerate(order):
+                values = np.concatenate(([biases[component, site]], matrices[component, site, order[:position]]))
+                parameters.append(values)
+                local_logs -= np.logaddexp(0, -local_spins[:, position] * (design[:, :position + 1] @ values))
+            local_probability = np.exp(local_logs)
+            for position, values in enumerate(parameters):
+                inputs = design[:, :position + 1]
+                prediction = expit(inputs @ values)
+                curvature = local_probability * prediction * (1 - prediction)
+                hessian = inputs.T @ (curvature[:, None] * inputs) + 1e-5 * np.eye(position + 1)
+                factor = cholesky(hessian, lower=True, check_finite=False)
+                transforms.append(solve_triangular(factor.T, np.eye(position + 1), lower=False, check_finite=False))
+                slices.append(slice(size, size + position + 1))
+                size += position + 1
+            local_entries.append((order, design, local_spins, parameters, transforms, slices))
+        entries.append(local_entries)
+    size += 8
+    best_vector = np.zeros(size)
+    best_value = np.inf
+    best_metrics = None
+    calls = 0
+    executor = ThreadPoolExecutor(max_workers=4)
+
+    def evaluate(vector):
+        nonlocal best_vector, best_value, calls, best_metrics
+        if time.monotonic() >= deadline:
+            raise ProductDeadline()
+        log_mixing = initial_mixing + vector[-8:]
+        log_mixing -= logsumexp(log_mixing)
+
+        def forward(component):
+            joint = np.zeros(len(target))
+            local_predictions = []
+            originals = []
+            for block_index, (order, design, local_spins, parameters, transforms, slices) in enumerate(entries[component]):
+                matrix = np.zeros((len(order), len(order) + 1))
+                local_originals = []
+                for position, (initial, transform, selection) in enumerate(zip(parameters, transforms, slices)):
+                    values = initial + transform @ vector[selection]
+                    local_originals.append(values)
+                    matrix[position, :position + 1] = values * min(1, 59 / max(1, abs(values).sum()))
+                logits = design @ matrix.T
+                logs = -np.logaddexp(0, -local_spins * logits).sum(axis=1)
+                joint += logs[indices[block_index]]
+                local_predictions.append(expit(logits))
+                originals.append(local_originals)
+            return joint, local_predictions, originals
+
+        evaluated = list(executor.map(forward, range(8)))
+        logs = np.asarray([entry[0] for entry in evaluated]) + log_mixing[:, None]
+        log_model = logsumexp(logs, axis=0)
+        probability = np.exp(log_model)
+        difference = log_model - log_target
+        reverse = probability @ difference
+        forward_kl = -target @ difference
+        tilt = np.exp(np.minimum(50, 2 * log_target - log_model))
+        chi = tilt.sum()
+        objective = reverse + .05 * forward_kl + .002 * (chi - 1)
+        residual = probability * (difference + 1) - .05 * target - .002 * tilt
+        gradient = np.zeros(size)
+
+        def backward(component):
+            local_residual = np.exp(logs[component] - log_model) * residual
+            for block_index, (order, design, local_spins, parameters, transforms, slices) in enumerate(entries[component]):
+                marginal = np.bincount(indices[block_index], weights=local_residual, minlength=len(design))
