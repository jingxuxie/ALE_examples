+def linear_moments(values):
+    count = len(values).bit_length() - 1
+    result = np.empty(count + 1)
+    for position in range(count):
+        negative = values[::2]
+        positive = values[1::2]
+        result[position + 1] = positive.sum() - negative.sum()
+        values = negative + positive
+    result[0] = values[0]
