+    assert probabilities.shape == (48, 64)
+    assert probabilities.dtype.str == \"<f8\"
+    assert probabilities.flags.c_contiguous
+    assert np.isfinite(probabilities).all()
+    assert np.all((probabilities > 0) & (probabilities <= 1))
