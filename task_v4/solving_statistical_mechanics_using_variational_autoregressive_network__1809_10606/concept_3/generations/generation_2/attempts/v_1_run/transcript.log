from infer import SOURCE
from decision import DecisionProblem
from decision_lbfgs import objective
import numpy as np
from scipy.special import expit
queries=json.loads((SOURCE/'input/queries.json').read_text())
assert all((index%12>=6)==(query['family']=='readout_field') for index,query in enumerate(queries))
samples=np.load('training_draws.npz')['predictions'][:,::100].copy()
problem=DecisionProblem(samples)
value_grad, initialize, expand=objective(problem)
logits=initialize(problem.mean)
value, gradient=value_grad(logits,.08)
ratio,kl,_=problem.scores(expand(logits))
expected=-expit((1-ratio)/.08).mean()+.01*kl.mean()
objective_error=abs(float(value)-expected)
assert objective_error < 9e-5
rng=np.random.default_rng(9776)
direction=rng.normal(size=len(logits)); direction/=np.linalg.norm(direction)
epsilon=1e-5
finite=(float(value_grad(logits+epsilon*direction,.08)[0])-float(value_grad(logits-epsilon*direction,.08)[0]))/(2*epsilon)
analytic=np.asarray(gradient)@direction
np.testing.assert_allclose(finite,analytic,rtol=1e-4,atol=1e-7)
report=json.loads(Path('numerical_checks.json').read_text())
report.update(decision_objective_error=objective_error,decision_gradient_error=abs(finite-analytic),query_family_order_verified=True)
Path('numerical_checks.json').write_text(json.dumps(report,indent=2))
print(report)
