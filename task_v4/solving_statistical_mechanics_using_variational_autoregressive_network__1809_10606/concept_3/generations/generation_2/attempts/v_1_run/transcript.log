+    print(label, \"mean KL\", kl.mean(), \"family KL\", {family: float(kl[groups == family].mean()) for family in set(groups)},
+          \"max TV\", tv.max(), \"query\", int(tv.argmax()), flush=True)
+    return {\"mean_kl\": float(kl.mean()), \"max_tv\": float(tv.max())}
+
+
