+                        (NAMES[2+coord_y%2], coord_x+width*((coord_y+1)%height), hopping_y,dimer_y,coord_y)]:
+                        amplitude = hopping*(1+dimer*(-1)**coord)*rng.uniform(1-family['disorder'],1+family['disorder'])
