 payload=json.loads(path.read_text())
 assert set(payload)=={'choices'}
 assert all(type(label) is int for label in payload['choices'])
 score=atlas.score(payload['choices'])
 assert score['feasible']
 assert score['objective'] <= atlas.metadata['baseline_objective']
 row={'case':name,'gain':1-score['objective']/atlas.metadata['baseline_objective'],**score}
 report.append(row)
 print(json.dumps(row))
Path('validation/final_report.json').write_text(json.dumps(report,indent=2)+'\\n')
atlas=load_atlas('validation/zero_chern')
score=atlas.score(json.loads(Path('validation/fallback.json').read_text())['choices'])
assert score['feasible']
assert score['objective'] <= atlas.metadata['baseline_objective']
print('Fallback:',score)
print('Public mean gain:',sum(row['gain'] for row in report)/len(report))
