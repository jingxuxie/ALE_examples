import sys,json,time,numpy as np
from pathlib import Path
root=Path('../../participant').resolve();sys.path.insert(0,str(root/'workspace'))
from atlas import Atlas
for directory in sorted((root/'input').glob('*/')):
    atlas=Atlas.load(directory);baseline=np.load(directory/'arrays.npz')['baseline_choices'];order=np.argsort(atlas.costs,axis=1)
    print(directory.name,flush=True)
    candidates=[]; descriptions=[]; nx=atlas.metadata['nx'];ny=atlas.metadata['ny']
    for rank in range(4):
        choice=order[:,rank].copy()
        for vertex,label in atlas.anchors.items():choice[vertex]=label
        print('all rank',rank,atlas.score(choice),flush=True)
    for width in range(1,nx+1):
        for height in range(1,ny+1):
            for start in range(atlas.vertices):
                choice=baseline.copy()
                patch=[((start//nx+dy)%ny)*nx+(start%nx+dx)%nx for dy in range(height) for dx in range(width)]
                choice[patch]=order[patch,0]
                for vertex,label in atlas.anchors.items():choice[vertex]=label
                candidates.append(choice);descriptions.append((start,width,height))
    candidates=np.array(candidates);scores=[];feasible=[]
    for batch in np.array_split(candidates,32):
        result=atlas.evaluate_many(batch);scores.extend(result['objective']);feasible.extend(result['feasible'])
    scores=np.where(feasible,scores,np.inf); indices=np.argsort(scores)[:10]
