{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mass", "spin_orbit", "orbital_mass", "scalar"],
  "properties": {
    "schema_version": {"const": 1},
    "mass": {"type": "number", "minimum": -1.9, "maximum": -0.3},
    "spin_orbit": {"type": "array", "minItems": 11, "maxItems": 11, "items": {"type": "number", "minimum": -0.75, "maximum": 0.75}},
    "orbital_mass": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"type": "number", "minimum": -1.5, "maximum": 1.5}},
    "scalar": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"type": "number", "minimum": -0.75, "maximum": 0.75}}
  }
}
