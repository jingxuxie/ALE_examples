+    solution = least_squares(residual, parameters, bounds=(LOWER, UPPER),
+                             max_nfev=180, ftol=1e-8, xtol=1e-8, gtol=1e-8,
+                             diff_step=2e-4)
+    final = diagnose(solution.x, 49)
+    payload = {'parameters': solution.x.tolist(), 'diagnostic': final,
