+            unsigned = values.astype(np.uint64)
+            return (unsigned[:, 0] * np.uint64(moduli[1]) + unsigned[:, 1]) * np.uint64(moduli[2]) + unsigned[:, 2]
+    else:
+        def encode(values):
+            return np.ascontiguousarray(values).view(
