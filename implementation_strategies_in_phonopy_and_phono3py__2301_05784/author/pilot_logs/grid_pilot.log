+def spectral_integrals(lattice, grid_matrix, grid_adjugate, determinant,
+                       addresses, frequencies, samples):
+    branches = frequencies.shape[1]
+    cumulative = np.empty((len(samples), branches))
+    density = np.empty_like(cumulative)
