+        lower[start:stop] = lower[2 * start:2 * stop:2]
+        upper[start:stop] = upper[2 * start + 1:2 * stop:2]
+        start //= 2
+    centers = lower + (upper - lower) * 0.5
+    radii = (upper - lower) * 0.5
+    centers[0] = 0
+    radii[0] = 0
