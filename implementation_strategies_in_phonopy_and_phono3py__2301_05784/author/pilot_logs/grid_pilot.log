+        children = np.arange(2 * start, 4 * start)
+        parent_radii = np.repeat(radii[parents], 2)
+        displacement = np.divide(
+            centers[children] - np.repeat(centers[parents], 2), parent_radii,
+            out=np.zeros(len(children)), where=parent_radii != 0,
