+    [
+        [[0, 1, 7, 3], [0, 1, 7, 5], [0, 2, 7, 3],
+         [0, 2, 7, 6], [0, 4, 7, 5], [0, 4, 7, 6]],
+        [[1, 6, 0, 2], [1, 6, 0, 4], [1, 6, 2, 3],
+         [1, 6, 3, 7], [1, 6, 4, 5], [1, 6, 5, 7]],
+        [[2, 5, 0, 1], [2, 5, 0, 4], [2, 5, 1, 3],
+         [2, 5, 3, 7], [2, 5, 4, 6], [2, 5, 6, 7]],
+        [[3, 4, 0, 1], [3, 4, 0, 2], [3, 4, 1, 5],
+         [3, 4, 2, 6], [3, 4, 5, 7], [3, 4, 6, 7]],
+    ], dtype=np.int64,
+)
