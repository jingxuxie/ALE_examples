+                zbits ^= (first_x << second) | (second_x << first)
+            elif opcode == 5:
+                changed_x = first_x ^ second_x
+                changed_z = first_z ^ second_z
+                xbits ^= (changed_x << first) | (changed_x << second)
+                zbits ^= (changed_z << first) | (changed_z << second)
+    return xbits, zbits, signs
