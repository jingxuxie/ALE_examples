+        residual = np.empty_like(probes)
+        transpose = scaled.T.tocsr()
+        for probe in range(probes.shape[1]):
+            fitted = splinalg.lsmr(transpose, probes[:, probe], atol=2e-11, btol=2e-11, conlim=1e12, maxiter=min(12000, max(1500, parameter_count * 3)))
