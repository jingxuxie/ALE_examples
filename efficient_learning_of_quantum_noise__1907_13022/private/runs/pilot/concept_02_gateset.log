+def pauli_bits(paulis):
+    qubit_count = paulis.shape[-1]
+    powers = np.left_shift(np.int64(1), np.arange(qubit_count))
+    xbits = ((paulis == 1) | (paulis == 2)).astype(np.int64) @ powers
+    zbits = ((paulis == 2) | (paulis == 3)).astype(np.int64) @ powers
+    return xbits, zbits
