+                for iteration in range(3):
+                    residual = ridge * factorization.solve(residual)
+                normal_error = np.linalg.norm(scaled @ residual, axis=0)
+                report('calibration direct', gram.nnz, normal_error.tolist())
+                if np.max(normal_error) > 2e-6:
