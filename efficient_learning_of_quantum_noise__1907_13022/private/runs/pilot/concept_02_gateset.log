+    probes = generator.normal(size=(parameter_count, 2))
+    row_lengths = np.diff(scaled.indptr).astype(float)
+    work_estimate = np.dot(row_lengths, row_lengths)
+    use_direct = parameter_count <= 1800 or (parameter_count <= 6500 and work_estimate < 1.2e8)
+    residual = None
+    if use_direct:
