+                phase += next_phase + 2 * (output_z & next_x).bit_count()
+                output_x ^= next_x
+                output_z ^= next_z
+        sign = ((phase - (output_x & output_z).bit_count()) & 3) >> 1
+        return output_x, output_z, sign
