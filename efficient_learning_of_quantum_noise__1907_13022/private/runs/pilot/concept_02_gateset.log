+    for opcode, first, second in operations[::-1]:
+        first = int(first)
+        second = int(second)
+        first_x = (xbits >> first) & 1
+        first_z = (zbits >> first) & 1
+        if opcode == 1:
+            signs ^= first_x & first_z
+            changed = (first_x ^ first_z) << first
+            xbits ^= changed
+            zbits ^= changed
+        elif opcode == 2:
