+        best = values.copy()
+        return value, transpose @ gradient_rows
+
+    try:
+        result = optimize.minimize(likelihood, initial, method='L-BFGS-B', jac=True, bounds=bounds, options={'maxiter': 1600, 'ftol': 2e-11, 'gtol': 2e-6, 'maxcor': 25, 'maxls': 30})
