+def calibration_identifiability(matrix, queries, structural):
+    if not np.any(structural):
+        return structural.copy()
+    parameter_count = matrix.shape[1]
+    if not parameter_count:
+        return np.ones(queries.shape[0], dtype=bool)
+    scaled, column_scale = equilibrate(matrix)
+    scaled_queries = queries.multiply(1 / column_scale).tocsr()
+    query_norms = np.sqrt(np.asarray(scaled_queries.multiply(scaled_queries).sum(axis=1)).ravel())
+    generator = np.random.default_rng(829441)
+    probes = generator.normal(size=(parameter_count, 2))
+    row_lengths = np.diff(scaled.indptr).astype(float)
+    work_estimate = np.dot(row_lengths, row_lengths)
+    use_direct = parameter_count <= 1800 or (parameter_count <= 6500 and work_estimate < 1.2e8)
+    residual = None
+    if use_direct:
+        gram = (scaled.T @ scaled).tocsc()
+        if parameter_count <= 2200 or gram.nnz < 2200000:
+            ridge = 1e-7
+            try:
+                factorization = splinalg.splu(gram + ridge * sparse.eye(parameter_count, format='csc'), permc_spec='MMD_AT_PLUS_A', diag_pivot_thresh=0.0, options={'Equil': False, 'SymmetricMode': True})
+                residual = probes
+                for iteration in range(3):
+                    residual = ridge * factorization.solve(residual)
+                normal_error = np.linalg.norm(scaled @ residual, axis=0)
+                report('calibration direct', gram.nnz, normal_error.tolist())
+                if np.max(normal_error) > 2e-6:
+                    residual = None
+            except (RuntimeError, MemoryError):
+                residual = None
+            del gram
+    if residual is None:
+        residual = np.empty_like(probes)
+        transpose = scaled.T.tocsr()
+        for probe in range(probes.shape[1]):
+            fitted = splinalg.lsmr(transpose, probes[:, probe], atol=2e-11, btol=2e-11, conlim=1e12, maxiter=min(12000, max(1500, parameter_count * 3)))
+            residual[:, probe] = probes[:, probe] - transpose @ fitted[0]
+            report('calibration iterative', probe, fitted[1:5])
+    distances = np.linalg.norm(scaled_queries @ residual, axis=1) / np.maximum(query_norms, 1e-30)
+    tolerance = 3e-6
+    result = structural & (distances < tolerance)
+    report('calibration ranks', int(np.sum(structural)), int(np.sum(result)), 'queries', len(result))
+    return result
+
