+            group = active[offset:offset + 4]
+            mask = sum(1 << qubit for qubit in group)
+            codes = np.arange(4 ** len(group), dtype=np.int64)
+            input_x = np.zeros(len(codes), dtype=np.int64)
+            input_z = np.zeros(len(codes), dtype=np.int64)
