+            second_z = (zbits >> second) & 1
+            if opcode == 3:
+                signs ^= first_x & second_z & (second_x ^ first_z ^ 1)
+                xbits ^= first_x << second
+                zbits ^= second_z << first
+            elif opcode == 4:
+                signs ^= first_x & second_x & (first_z ^ second_z)
+                zbits ^= (first_x << second) | (second_x << first)
+            elif opcode == 5:
