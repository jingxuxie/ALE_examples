+        table = data["local_probs"][start:stop].reshape((2,) * size, order="F")
+        coefficients = (
+            np.log(np.take(table, 1, axis=center_axis))
+            - np.log(np.take(table, 0, axis=center_axis))
+        ).ravel(order="F")
