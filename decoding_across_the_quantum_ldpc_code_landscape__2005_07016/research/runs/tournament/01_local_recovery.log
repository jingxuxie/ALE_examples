+
+def regular(checks, variables, degree, rng):
+    check_degree = variables * degree // checks
+    for trial in range(100000):
+        rows = rng.permutation(np.repeat(np.arange(checks), check_degree)).reshape(variables, degree)
+        if np.all(np.diff(np.sort(rows, axis=1), axis=1) "'!= 0):
+            return sp.coo_matrix((np.ones(rows.size, dtype=np.uint8), (rows.ravel(), np.repeat(np.arange(variables), degree))), shape=(checks, variables)).tocsr()
+    raise RuntimeError('"'regular generation failed')
+
+
+def regular_hgp(length, rng):
+    first = regular(length // 2, length, 3, rng)
+    second = regular(length // 2, length, 3, rng)
+    parity = sp.hstack([sp.kron(first, sp.eye(length)), sp.kron(sp.eye(length // 2), second.T)], format='csr', dtype=np.uint8)
+    stabilizers = sp.hstack([sp.kron(sp.eye(length), second), sp.kron(first.T, sp.eye(length // 2))], format='csr', dtype=np.uint8)
+    return parity, stabilizers
+
+
