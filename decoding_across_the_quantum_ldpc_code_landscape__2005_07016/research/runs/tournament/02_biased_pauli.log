+    canonical_z = physical_x * frame[:, 1, 0] ^ physical_z * frame[:, 0, 0]
+    success_x = in_span(canonical_x ^ error_x, bases[0])
+    success_z = in_span(canonical_z ^ error_z, bases[1])
