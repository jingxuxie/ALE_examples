+                print('n=%d p=%.3f bias=%d axis=%s mode=%s success=%d/%d cpu=%.3f' %
+                      (size, rate, bias, pattern, mode, success.sum(), args.shots, elapsed), flush=True)
+
+
+if __name__ == '__main__':
+    main()

