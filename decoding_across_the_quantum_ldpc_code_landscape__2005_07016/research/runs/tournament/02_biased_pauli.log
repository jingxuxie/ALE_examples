+        physical_z = (state & 1) * frame[:, 1, 0] ^ (state >> 1) * frame[:, 1, 1]
+        physical_probs[permutation, pauli_index[physical_x + 2 * physical_z]] = canonical_probs[:, state]
+    case = dict(schema_version=np.array(1), base_hx=hx, base_hz=hz, gx=gx, gz=gz,
