+        if (mode == 5) return bp(syndrome, 100, 1.0, 0.0, true, 0.8);
+        if (mode == 6) return bp(syndrome, 100, 0.7, 0.3, false);
+        if (mode == 7) return bp(syndrome, 100, 1.0, 0.5, false);
