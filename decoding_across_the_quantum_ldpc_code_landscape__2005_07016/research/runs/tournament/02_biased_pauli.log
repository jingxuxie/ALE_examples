+        if (mode == 11) return layered(syndrome, 80, 1.0, true, 0.8);
+        if (mode == 12) return bp(syndrome, 200, 0.8, 0.3, false);
+        if (mode == 13) return bp(syndrome, 0, 1.0, 0.0, false);
+        bool sum_product = mode == 1 || mode == 3;
