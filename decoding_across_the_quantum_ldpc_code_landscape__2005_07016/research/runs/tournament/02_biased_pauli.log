+                        if (sign ^ (outgoing[edge - begin] < 0)) message = -message;
+                    }
+                    int variable = edges[edge].variable, sector = edges[edge].sector;
+                    sums[variable][sector] += message - incoming[edge];
+                    incoming[edge] = message;
+                }
+            }
