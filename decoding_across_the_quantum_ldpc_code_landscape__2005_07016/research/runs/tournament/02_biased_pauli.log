+        bool sum_product = mode == 1 || mode == 3;
+        double scale = sum_product ? 1.0 : 0.8;
+        double damping = mode == 2 || mode == 3 ? 0.3 : 0.0;
+        return bp(syndrome, 80, scale, damping, sum_product);
+    }
